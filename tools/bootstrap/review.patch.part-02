--- a/src/hooks_wheel_vehicle_dynamics.hpp
+++ b/src/hooks_wheel_vehicle_dynamics.hpp
@@ -187,6 +187,11 @@ public:
         const float rightZ = -forwardX;
         vLong_ = dx * forwardX + dz * forwardZ;
         vLat_ = dx * rightX + dz * rightZ;
+        if (vLong_ <= 0.0f)
+        {
+            clear_dynamic_state();
+            return;
+        }
         const float rawBodySlip = std::clamp(
             std::atan2(vLat_, std::max(std::abs(vLong_), 0.00001f)),
             -0.70f, 0.70f);
@@ -248,6 +253,7 @@ public:
     bool calibrated() const { return calibrated_; }
