def _cgroup_memory_runtime_fields() -> dict:
    fields = {}
    for key, name in (("current", "memory.current"), ("peak", "memory.peak"), ("max", "memory.max"), ("swap_current", "memory.swap.current")):
        try:
            raw = Path("/sys/fs/cgroup") .joinpath(name).read_text(encoding="utf-8").strip()
            if raw != "max":
                fields[f"container_memory_{key}_mib"] = round(int(raw) / 1048576, 1)
        except Exception:
            pass
    current = fields.get("container_memory_current_mib")
    maximum = fields.get("container_memory_max_mib")
    if current is not None and maximum:
        fields["container_memory_percent"] = round((current / maximum) * 100.0, 1)
    return fields


def write_runtime(**updates):
    now = datetime.now(TZ)
    runtime.update(_cgroup_memory_runtime_fields())
    if updates.get("last_action") is not None:
        runtime["last_scheduler_decision_at"] = now.isoformat()
        runtime["last_scheduler_decision"] = updates.get("last_action")
    status = str(updates.get("status", ""))
    if "blocked" in status or status in {"queue_error", "watchdog_error", "login_required", "limit_detected"}:
        runtime["blocked_reason"] = updates.get("last_action") or updates.get("last_error") or status
    elif status in {"idle", "sent", "queue_wait_chat", "queue_wait_actions", "parallel_wave_running",
                    "parallel_wait_actions", "parallel_wave_complete", "queue_pass",
                    "parallel_c_barrier", "startup_reconcile"}:
        runtime["blocked_reason"] = None
    runtime.update(updates)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    RUNTIME_FILE.write_text(json.dumps(runtime, ensure_ascii=False, indent=2), encoding="utf-8")


def touch_queue_heartbeat() -> None:
    """Refresh in-memory liveness while a bounded queue sub-operation is making progress."""
    runtime["queue_loop_heartbeat_at"] = datetime.now(TZ).isoformat()


def logical_date(now: datetime) -> str:
    shifted = now - timedelta(days=1) if now.hour < ROLLOVER_HOUR else now
    return shifted.date().isoformat()


def new_registry(now: datetime) -> Registry:
    return Registry(
        logical_date=logical_date(now),
        next_slot=0,
        slots=[Slot(name=chr(ord('A') + i)) for i in range(CHAT_SLOTS)],
        rate_limit_attempts=0,
        rate_limit_until=None,
        last_global_send_at=None,
        last_global_send_slot=None,
    )


def load_registry(now: datetime) -> Registry:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if not REGISTRY_FILE.exists():
        if REGISTRY_BACKUP_FILE.exists():
            REGISTRY_FILE.write_text(REGISTRY_BACKUP_FILE.read_text(encoding="utf-8"), encoding="utf-8")
            log.warning("registry primary missing; restored from backup before load")
        else:
            reg = new_registry(now)
            save_registry(reg)
            return reg
    try:
        raw = json.loads(REGISTRY_FILE.read_text(encoding="utf-8"))
        reg = Registry(
            logical_date=raw["logical_date"],
            next_slot=int(raw.get("next_slot", 0)),
            slots=[Slot(**s) for s in raw["slots"]],
            rate_limit_attempts=int(raw.get("rate_limit_attempts", 0)),
            rate_limit_until=raw.get("rate_limit_until"),
            last_global_send_at=raw.get("last_global_send_at"),
            last_global_send_slot=raw.get("last_global_send_slot"),
        )
    except Exception as primary_error:
        log.exception("registry read failed; attempting backup recovery")
        try:
            raw = json.loads(REGISTRY_BACKUP_FILE.read_text(encoding="utf-8"))
            reg = Registry(
                logical_date=raw["logical_date"],
                next_slot=int(raw.get("next_slot", 0)),
                slots=[Slot(**s) for s in raw["slots"]],
                rate_limit_attempts=int(raw.get("rate_limit_attempts", 0)),
                rate_limit_until=raw.get("rate_limit_until"),
                last_global_send_at=raw.get("last_global_send_at"),
                last_global_send_slot=raw.get("last_global_send_slot"),
            )
            tmp = REGISTRY_FILE.with_suffix(".recover.tmp")
            tmp.write_text(json.dumps(raw, ensure_ascii=False, indent=2), encoding="utf-8")
            tmp.replace(REGISTRY_FILE)
            log.warning("registry recovered from backup after primary read failure")
        except Exception as backup_error:
            raise RuntimeError(f"registry state unreadable; refusing destructive reset: primary={primary_error!r} backup={backup_error!r}")
    if reg.logical_date != logical_date(now):
        archive = STATE_DIR / f"chat_registry_{reg.logical_date}.json"
        try:
            if REGISTRY_FILE.exists():
                archive.write_text(REGISTRY_FILE.read_text(encoding="utf-8"), encoding="utf-8")
        except Exception:
            log.exception("registry archive failed")
        # Fresh-chat-per-task makes destructive daily registry reset unnecessary.
        # Preserve active URLs, send-gap/rate-limit state, and only roll the logical date.
        reg.logical_date = logical_date(now)
        for slot in reg.slots:
            slot.watchdog_resumes_since_schedule = 0
            slot.last_watchdog_at = None
        save_registry(reg)
        log.info("daily registry date advanced without dropping active slot state: %s", reg.logical_date)
    elif len(reg.slots) != CHAT_SLOTS:
        # Resize without discarding progress: preserve A..N existing slot state.
        old_len = len(reg.slots)
        if CHAT_SLOTS < old_len:
            reg.slots = reg.slots[:CHAT_SLOTS]
        else:
            for i in range(old_len, CHAT_SLOTS):
                reg.slots.append(Slot(name=chr(ord('A') + i)))
        reg.next_slot = reg.next_slot % CHAT_SLOTS
        save_registry(reg)
        log.info("resized chat slots from %s to %s while preserving state", old_len, CHAT_SLOTS)
    return reg


def save_registry(reg: Registry):
    if REGISTRY_FILE.exists():
        try:
            previous = REGISTRY_FILE.read_text(encoding="utf-8")
            json.loads(previous)
            backup_tmp = REGISTRY_BACKUP_FILE.with_suffix(".tmp")
            backup_tmp.write_text(previous, encoding="utf-8")
            backup_tmp.replace(REGISTRY_BACKUP_FILE)
        except Exception:
            log.warning("registry backup refresh skipped because current primary is unreadable", exc_info=True)
    payload = {
        "logical_date": reg.logical_date,
        "next_slot": reg.next_slot,
        "slots": [asdict(s) for s in reg.slots],
        "rate_limit_attempts": reg.rate_limit_attempts,
        "rate_limit_until": reg.rate_limit_until,
        "last_global_send_at": reg.last_global_send_at,
        "last_global_send_slot": reg.last_global_send_slot,
    }
    encoded = json.dumps(payload, ensure_ascii=False, indent=2)
    tmp = REGISTRY_FILE.with_suffix(".tmp")
    tmp.write_text(encoded, encoding="utf-8")
    tmp.replace(REGISTRY_FILE)
    backup_tmp = REGISTRY_BACKUP_FILE.with_suffix(".tmp")
    backup_tmp.write_text(encoded, encoding="utf-8")
    backup_tmp.replace(REGISTRY_BACKUP_FILE)


def track_thinking_verification(reg: Registry, slot: Slot, verified: bool, where: str) -> bool:
    if verified:
        if slot.thinking_verify_failures or slot.last_thinking_failure_at:
            slot.thinking_verify_failures = 0
            slot.last_thinking_failure_at = None
            save_registry(reg)
        return True
    if not STRICT_THINKING_LEVEL:
        return False
    slot.thinking_verify_failures = int(slot.thinking_verify_failures or 0) + 1
    slot.last_thinking_failure_at = datetime.now(TZ).isoformat()
    slot.last_result = "thinking_level_unverified"
    save_registry(reg)
    write_runtime(
        status="thinking_level_blocked",
        last_action=(
            f"Slot {slot.name} High verification failed at {where} "
            f"({slot.thinking_verify_failures}/{THINKING_VERIFY_FAILURE_RESTART_THRESHOLD})"
        ),
        thinking_failure_slot=slot.name,
        thinking_failure_count=slot.thinking_verify_failures,
    )
    if slot.thinking_verify_failures >= THINKING_VERIFY_FAILURE_RESTART_THRESHOLD:
        raise ControllerRestartRequested(
            f"Slot {slot.name} repeated High verification failure reached "
            f"{THINKING_VERIFY_FAILURE_RESTART_THRESHOLD}; restart browser/controller stack"
        )
    return False


def read_prompt(filename: str) -> str:
    path = PROMPTS_DIR / filename
    return path.read_text(encoding="utf-8").strip()


def load_queue_state() -> dict:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if not QUEUE_FILE.exists():
        if QUEUE_BACKUP_FILE.exists():
            QUEUE_FILE.write_text(QUEUE_BACKUP_FILE.read_text(encoding="utf-8"), encoding="utf-8")
            log.warning("queue primary missing; restored from backup before load")
        else:
            state = {
                "counter": 0,
                "active": None,
                "active_by_lane": {},
                "wave_counter": 0,
                "wave_id": None,
                "wave_started_at": None,
                "producer_counter": 0,
                "qa_batch_counter": 0,
                "qa_pending": [],
                "qa_completed": [],
                "qa_blocked": [],
                "completed": [],
                "blocked": [],
                "last_github_poll_at": None,
                "conversion_blocked_reconcile_version": 0,
            }
            save_queue_state(state)
            return state
    try:
        raw = json.loads(QUEUE_FILE.read_text(encoding="utf-8"))
        raw.setdefault("counter", 0)
        raw.setdefault("active", None)
        raw.setdefault("active_by_lane", {})
        raw.setdefault("wave_counter", 0)
        raw.setdefault("wave_id", None)
        raw.setdefault("wave_started_at", None)
        raw.setdefault("producer_counter", 0)
        raw.setdefault("qa_batch_counter", 0)
        raw.setdefault("qa_pending", [])
        raw.setdefault("qa_completed", [])
        raw.setdefault("qa_blocked", [])
        raw.setdefault("completed", [])
        raw.setdefault("blocked", [])
        raw.setdefault("last_github_poll_at", None)
        raw.setdefault("conversion_blocked_reconcile_version", 0)
        return raw
    except Exception as primary_error:
        log.exception("queue state read failed; attempting backup recovery")
        try:
            raw = json.loads(QUEUE_BACKUP_FILE.read_text(encoding="utf-8"))
            raw.setdefault("counter", 0)
            raw.setdefault("active", None)
            raw.setdefault("active_by_lane", {})
            raw.setdefault("wave_counter", 0)
            raw.setdefault("wave_id", None)
            raw.setdefault("wave_started_at", None)
            raw.setdefault("producer_counter", 0)
            raw.setdefault("qa_batch_counter", 0)
            raw.setdefault("qa_pending", [])
            raw.setdefault("qa_completed", [])
            raw.setdefault("qa_blocked", [])
            raw.setdefault("completed", [])
            raw.setdefault("blocked", [])
            raw.setdefault("last_github_poll_at", None)
            raw.setdefault("conversion_blocked_reconcile_version", 0)
            tmp = QUEUE_FILE.with_suffix(".recover.tmp")
            tmp.write_text(json.dumps(raw, ensure_ascii=False, indent=2), encoding="utf-8")
            tmp.replace(QUEUE_FILE)
            log.warning("queue state recovered from backup after primary read failure")
            return raw
        except Exception as backup_error:
            raise RuntimeError(f"queue state unreadable; refusing destructive reset: primary={primary_error!r} backup={backup_error!r}")


def save_queue_state(state: dict):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if QUEUE_FILE.exists():
        try:
            previous = QUEUE_FILE.read_text(encoding="utf-8")
            json.loads(previous)
            backup_tmp = QUEUE_BACKUP_FILE.with_suffix(".tmp")
            backup_tmp.write_text(previous, encoding="utf-8")
            backup_tmp.replace(QUEUE_BACKUP_FILE)
        except Exception:
            log.warning("queue backup refresh skipped because current primary is unreadable", exc_info=True)
    encoded = json.dumps(state, ensure_ascii=False, indent=2)
    tmp = QUEUE_FILE.with_suffix(".tmp")
    tmp.write_text(encoded, encoding="utf-8")
    tmp.replace(QUEUE_FILE)
    backup_tmp = QUEUE_BACKUP_FILE.with_suffix(".tmp")
    backup_tmp.write_text(encoded, encoding="utf-8")
    backup_tmp.replace(QUEUE_BACKUP_FILE)


_github_rest_block_until_epoch = 0.0
_github_transient_error_count = 0
_github_commit_list_cache: dict[str, tuple[float, list]] = {}
_github_task_commit_cache: dict[tuple[str, str], tuple[float, list]] = {}
_github_actions_cache: dict[str, tuple[float, dict]] = {}
_localization_contract_cache: Optional[tuple[float, str, str]] = None


def _github_blocked_seconds() -> int:
    return max(0, int(_github_rest_block_until_epoch - time.time()))


def github_transient_retry_pending() -> bool:
    return time.time() < _github_rest_block_until_epoch and bool(runtime.get("github_retrying"))


def _github_retry_sleep(seconds: int) -> None:
    deadline = time.monotonic() + max(0, seconds)
    while True:
        remain = deadline - time.monotonic()
        if remain <= 0:
            return
        touch_queue_heartbeat()
        time.sleep(min(5.0, remain))


def _github_schedule_transient_retry(message: str, seconds: Optional[int] = None) -> None:
    global _github_rest_block_until_epoch, _github_transient_error_count
    _github_transient_error_count += 1
    delay = max(1, int(seconds or GITHUB_TRANSIENT_COOLDOWN_SECONDS))
    until = max(_github_rest_block_until_epoch, time.time() + delay)
    _github_rest_block_until_epoch = until
    write_runtime(
        github_retrying=True,
        github_transient_error_count=_github_transient_error_count,
        github_retry_in_seconds=max(1, int(until - time.time())),
        github_api_blocked_until=datetime.fromtimestamp(until, TZ).isoformat(),
        last_github_error=message,
    )


def github_api_json(path: str) -> dict:
    global _github_rest_block_until_epoch, _github_transient_error_count
    touch_queue_heartbeat()
    now_epoch = time.time()
    if now_epoch < _github_rest_block_until_epoch:
        raise GitHubTransientError(
            f"GitHub retry cooldown active for {_github_blocked_seconds()}s"
        )

    url = "https://api.github.com" + path
    headers = {
        "Accept": "application/vnd.github+json",
        "User-Agent": "outrun-chat-controller/0.5",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    if GITHUB_TOKEN:
        headers["Authorization"] = f"Bearer {GITHUB_TOKEN}"

    attempts = len(GITHUB_TRANSIENT_RETRY_DELAYS) + 1
    for attempt in range(attempts):
        req = urllib.request.Request(url, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=20) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                reset = resp.headers.get("X-RateLimit-Reset")
                _github_rest_block_until_epoch = 0.0
                _github_transient_error_count = 0
                write_runtime(
                    github_rate_limit_remaining=resp.headers.get("X-RateLimit-Remaining"),
                    github_rate_limit_limit=resp.headers.get("X-RateLimit-Limit"),
                    github_rate_limit_reset=reset,
                    github_api_blocked_until=None,
                    github_retrying=False,
                    github_transient_error_count=0,
                    github_retry_in_seconds=0,
                    last_github_error=None,
                )
                return data
        except urllib.error.HTTPError as e:
            if e.code in {403, 429}:
                retry_after = e.headers.get("Retry-After")
                reset = e.headers.get("X-RateLimit-Reset")
                until = time.time() + GITHUB_TRANSIENT_COOLDOWN_SECONDS
                if retry_after:
                    try:
                        until = max(until, time.time() + int(retry_after) + 5)
                    except ValueError:
                        pass
                if reset:
                    try:
                        until = max(until, float(reset) + 5)
                    except ValueError:
                        pass
                _github_schedule_transient_retry(
                    f"HTTP {e.code} rate limit; automatic retry scheduled",
                    max(1, int(until - time.time())),
                )
                raise GitHubTransientError(f"GitHub HTTP {e.code}; retry scheduled") from e
            if 500 <= e.code <= 599:
                if attempt < len(GITHUB_TRANSIENT_RETRY_DELAYS):
                    delay = GITHUB_TRANSIENT_RETRY_DELAYS[attempt]
                    write_runtime(
                        github_retrying=True,
                        github_retry_attempt=attempt + 1,
                        github_retry_in_seconds=delay,
                        last_github_error=f"HTTP {e.code}; retrying GitHub automatically",
                    )
                    _github_retry_sleep(delay)
                    continue
                _github_schedule_transient_retry(
                    f"HTTP {e.code}; automatic retry cooldown scheduled"
                )
                raise GitHubTransientError(f"GitHub HTTP {e.code}; retry scheduled") from e
            raise
        except (urllib.error.URLError, TimeoutError, ConnectionResetError, OSError) as e:
            if attempt < len(GITHUB_TRANSIENT_RETRY_DELAYS):
                delay = GITHUB_TRANSIENT_RETRY_DELAYS[attempt]
                write_runtime(
                    github_retrying=True,
                    github_retry_attempt=attempt + 1,
                    github_retry_in_seconds=delay,
                    last_github_error=f"{type(e).__name__}: {e}; retrying GitHub automatically",
                )
                _github_retry_sleep(delay)
                continue
            _github_schedule_transient_retry(
                f"{type(e).__name__}: {e}; automatic retry cooldown scheduled"
            )
            raise GitHubTransientError("GitHub transport unavailable; retry scheduled") from e

    raise GitHubTransientError("GitHub transient retry loop exhausted; retry scheduled")


def github_branch_head(branch: str) -> Optional[str]:
    try:
        q = urllib.parse.quote(branch, safe="")
        data = github_api_json(f"/repos/{GITHUB_REPO}/git/ref/heads/{q}")
        return data.get("object", {}).get("sha")
    except GitHubTransientError as e:
        log.info("github branch lookup deferred branch=%s error=%r", branch, e)
        return None
    except Exception as e:
        log.warning("github branch lookup failed branch=%s error=%r", branch, e)
        write_runtime(last_github_error=f"branch:{branch}:{e!r}")
        return None


def github_commit_message(sha: str) -> Optional[str]:
    try:
        data = github_api_json(f"/repos/{GITHUB_REPO}/commits/{sha}")
        return data.get("commit", {}).get("message", "")
    except GitHubTransientError as e:
        log.info("github commit lookup deferred sha=%s error=%r", sha, e)
        return None
    except Exception as e:
        log.warning("github commit lookup failed sha=%s error=%r", sha, e)
        return None


GITHUB_ACTIONS_SKIP_PATTERNS = [
    r"\[(?:skip ci|ci skip|no ci|skip actions|actions skip)\]",
    r"(?im)^skip-checks:\s*true\s*$",
]


def github_actions_skip_directive(message: str) -> Optional[str]:
    """Return the CI-skip directive that would prevent a required push workflow."""
    for pattern in GITHUB_ACTIONS_SKIP_PATTERNS:
        match = re.search(pattern, message or "", flags=re.I)
        if match:
            return match.group(0).strip()
    return None


def _select_task_commit(items: list, task_id: str, allow_ci_skip_fallback: bool = False) -> Optional[dict]:
    expected = f"[AUTO:{task_id}]"
    skipped = None
    for item in items if isinstance(items, list) else []:
        message = item.get("commit", {}).get("message", "")
        if expected not in message:
            continue
        result = {
            "sha": item.get("sha"),
            "message": message,
            "html_url": item.get("html_url"),
        }
        directive = github_actions_skip_directive(message)
        if not directive:
            return result
        if skipped is None:
            result["ci_skip_directive"] = directive
            skipped = result
    return skipped if allow_ci_skip_fallback else None


def invalidate_task_commit_cache(branch: str, task_id: Optional[str] = None):
    _github_commit_list_cache.pop(branch, None)
    if task_id:
        _github_task_commit_cache.pop((branch, task_id), None)
    else:
        for key in [key for key in _github_task_commit_cache if key[0] == branch]:
            _github_task_commit_cache.pop(key, None)


def github_find_task_commit(branch: str, task_id: str, per_page: int = 100, allow_ci_skip_fallback: bool = False) -> Optional[dict]:
    """Find the exact task commit; fall back to commits touching its durable task-record path."""
    try:
        now_mono = time.monotonic()
        cached = _github_commit_list_cache.get(branch)
        if cached and now_mono - cached[0] < GITHUB_TASK_COMMIT_CACHE_SECONDS:
            data = cached[1]
        else:
            data = []
            page_size = max(1, min(per_page, 100))
            for page_no in range(1, GITHUB_TASK_COMMIT_SCAN_PAGES + 1):
                q = urllib.parse.urlencode({"sha": branch, "per_page": page_size, "page": page_no})
                page_data = github_api_json(f"/repos/{GITHUB_REPO}/commits?{q}")
                if not isinstance(page_data, list):
                    break
                data.extend(page_data)
                if len(page_data) < page_size:
                    break
                if _select_task_commit(page_data, task_id, allow_ci_skip_fallback=True):
                    break
            if isinstance(data, list):
                _github_commit_list_cache[branch] = (now_mono, data)
        result = _select_task_commit(data if isinstance(data, list) else [], task_id, allow_ci_skip_fallback=False)
        if result:
            return result

        key = (branch, task_id)
        targeted = _github_task_commit_cache.get(key)
        if targeted and now_mono - targeted[0] < GITHUB_TASK_COMMIT_CACHE_SECONDS:
            task_data = targeted[1]
        else:
            task_path = f"docs/automation/runs/{task_id}.json"
            q = urllib.parse.urlencode({"sha": branch, "path": task_path, "per_page": 100})
            task_data = github_api_json(f"/repos/{GITHUB_REPO}/commits?{q}")
            if isinstance(task_data, list) and task_data:
                # Cache only positive path history. A negative lookup must be retried
                # next queue cycle so a just-created durable TASK_ID commit is seen fast.
                _github_task_commit_cache[key] = (now_mono, task_data)
        return _select_task_commit(task_data if isinstance(task_data, list) else [], task_id, allow_ci_skip_fallback=allow_ci_skip_fallback)
    except GitHubTransientError as e:
        log.info("github task commit lookup deferred branch=%s task=%s error=%r", branch, task_id, e)
        return None
    except Exception as e:
        log.warning("github task commit lookup failed branch=%s task=%s error=%r", branch, task_id, e)
        write_runtime(last_github_error=f"task-commit:{branch}:{task_id}:{e!r}")
        return None



def _normalize_github_run(r: dict) -> dict:
    return {
        "id": r.get("id"),
        "name": r.get("name"),
        "status": r.get("status"),
        "conclusion": r.get("conclusion"),
        "html_url": r.get("html_url"),
        "event": r.get("event"),
        "head_sha": r.get("head_sha"),
        "created_at": r.get("created_at"),
        "updated_at": r.get("updated_at"),
    }


def github_action_run_by_id(run_id: int, sha: str, workflow_name: str) -> Optional[dict]:
    try:
        r = github_api_json(f"/repos/{GITHUB_REPO}/actions/runs/{int(run_id)}")
        if not isinstance(r, dict):
            return None
        if r.get("head_sha") != sha or r.get("name") != workflow_name:
            log.warning("bound actions run mismatch id=%s expected_sha=%s actual_sha=%s", run_id, sha, r.get("head_sha"))
            return None
        return _normalize_github_run(r)
    except GitHubTransientError as e:
        log.info("github exact actions lookup deferred run=%s sha=%s error=%r", run_id, sha, e)
        return None
    except Exception as e:
        log.warning("github exact actions lookup failed run=%s sha=%s error=%r", run_id, sha, e)
        write_runtime(last_github_error=f"actions-run:{run_id}:{sha}:{e!r}")
        return None


def github_action_jobs_summary(run_id: int) -> list[dict]:
    try:
        payload = github_api_json(f"/repos/{GITHUB_REPO}/actions/runs/{int(run_id)}/jobs?per_page=100")
        jobs = payload.get("jobs", []) if isinstance(payload, dict) else []
        return [{
            "id": j.get("id"),
            "name": j.get("name"),
            "status": j.get("status"),
            "conclusion": j.get("conclusion"),
            "started_at": j.get("started_at"),
            "completed_at": j.get("completed_at"),
        } for j in jobs]
    except GitHubTransientError as e:
        log.info("github actions jobs lookup deferred run=%s error=%r", run_id, e)
        return []
    except Exception as e:
        log.warning("github actions jobs lookup failed run=%s error=%r", run_id, e)
        write_runtime(last_github_error=f"actions-jobs:{run_id}:{e!r}")
        return []


def github_gate_run(branch: str, sha: str, workflow_name: str, run_id: Optional[int] = None, force_discovery: bool = False) -> Optional[dict]:
    if run_id:
        return github_action_run_by_id(int(run_id), sha, workflow_name)
    try:
        now_mono = time.monotonic()
        cached = _github_actions_cache.get(branch)
        if cached and not force_discovery and now_mono - cached[0] < GITHUB_ACTIONS_CACHE_SECONDS:
            payload = cached[1]
        else:
            q = urllib.parse.urlencode({"branch": branch, "per_page": GITHUB_ACTIONS_DISCOVERY_PER_PAGE})
            payload = github_api_json(f"/repos/{GITHUB_REPO}/actions/runs?{q}")
            if isinstance(payload, dict):
                _github_actions_cache[branch] = (now_mono, payload)
        matches = [
            r for r in payload.get("workflow_runs", [])
            if r.get("head_sha") == sha and r.get("name") == workflow_name
        ]
        if not matches:
            return None
        matches.sort(key=lambda r: r.get("created_at", ""), reverse=True)
        return _normalize_github_run(matches[0])
    except GitHubTransientError as e:
        log.info("github actions discovery deferred branch=%s sha=%s error=%r", branch, sha, e)
        return None
    except Exception as e:
        log.warning("github actions discovery failed branch=%s sha=%s error=%r", branch, sha, e)
        write_runtime(last_github_error=f"actions-discovery:{branch}:{sha}:{e!r}")
        return None

def queue_target_for_slot(slot_name: str) -> dict:
    if CONTROLLER_MODE == "conversion":
        if slot_name == "B":
            return {
                "lane": "DXVK",
                "branch": "vr-dxvk-r71-disasm",
                "workflow": "Backend Conversion Gate",
            }
        return {
            "lane": "DX11",
            "branch": "vr-dx11-native-r71",
            "workflow": "Backend Conversion Gate",
        }
    role = {"A": "A", "B": "B", "C": "C", "D": "E"}.get(slot_name, "A")
    return {
        "lane": f"LOCALIZATION_{role}",
        "branch": "korean-localization-clean",
        "workflow": "Localization Automation Gate",
    }


def localization_controller_contract_fingerprint() -> tuple[str, str]:
    """Return the live localization schema/blob, with a short cache to avoid needless API pressure."""
    global _localization_contract_cache
    now_mono = time.monotonic()
    if _localization_contract_cache and now_mono - _localization_contract_cache[0] < 60:
        return _localization_contract_cache[1], _localization_contract_cache[2]
    path = "/repos/" + GITHUB_REPO + "/contents/localization/controller_roles.json?ref=korean-localization-clean"
    payload = github_api_json(path)
    blob_sha = str(payload.get("sha") or "").strip()
    encoded = str(payload.get("content") or "").replace("\\n", "")
    if not blob_sha or not encoded:
        raise RuntimeError("localization controller_roles.json freshness metadata unavailable")
    config = json.loads(base64.b64decode(encoded).decode("utf-8"))
    schema = str(config.get("schema_version") or "").strip()
    if not schema:
        raise RuntimeError("localization controller schema_version unavailable")
    _localization_contract_cache = (now_mono, schema, blob_sha)
    return schema, blob_sha


def queue_dynamic_prefix() -> str:
    task_id = str(runtime.get("queue_task_id") or "").strip()
    if not task_id:
        return ""
    lane = str(runtime.get("queue_lane") or "")
    branch = str(runtime.get("queue_branch") or "")
    preflight_head = str(runtime.get("queue_base_sha") or "").strip()
    attempt = int(runtime.get("queue_attempt") or 1)
    failure = str(runtime.get("queue_failure_context") or "").strip()
    wave_id = str(runtime.get("queue_wave_id") or "").strip()
    qa_batch = runtime.get("queue_qa_batch") or []
    schema_version = ""
    config_blob_sha = ""
    if CONTROLLER_MODE == "localization":
        schema_version, config_blob_sha = localization_controller_contract_fingerprint()
    lines = [
        f"[자동 큐 작업] TASK_ID={task_id}",
        *([f"CONTROLLER_SCHEMA_VERSION={schema_version}", f"CONTROLLER_CONFIG_BLOB_SHA={config_blob_sha}"] if CONTROLLER_MODE == "localization" else []),
        f"LANE={lane}",
        f"TARGET_BRANCH={branch}",
        f"CONTROLLER_GITHUB_PREFLIGHT={'OK' if preflight_head else 'UNKNOWN'}",
        *([f"CONTROLLER_GITHUB_HEAD_SHA={preflight_head}"] if preflight_head else []),
        "GITHUB_ACCESS_MODE=CONNECTED_GITHUB_PLUGIN",
        "GITHUB_PLUGIN_AVAILABLE=TRUE",
        "PUBLIC_GITHUB_ACCESS=DO_NOT_USE",
        "FIRST_ACTION=CALL_GITHUB_PLUGIN",
        f"ATTEMPT={attempt}/{MAX_TASK_ATTEMPTS}",
        *([f"WAVE_ID={wave_id}"] if wave_id else []),
        "GitHub 최신 HEAD를 상태·진행·QA SSOT로 사용하고 N100 로컬 저장소/clone/worktree로 우회하지 마. 단, 현재 Git HEAD가 승인한 Google Drive canonical HD source transport는 원본 DDS 취득에 사용하며 GitHub-only라는 이유로 차단하지 마.",
        "GitHub 접근은 공개 웹/비인증 HTTP가 아니라 이 ChatGPT 프로젝트에 연결된 GitHub 플러그인으로 수행한다. GitHub 플러그인은 사용 가능하다고 전제하고 반드시 실제 플러그인 호출부터 해.",
        "GitHub 함수/schema가 바로 보이지 않는다고 중단하지 마. 현재 세션의 도구/connector 목록에서 GitHub action을 탐색한 뒤 실제 호출해. schema 노출 여부를 GitHub 연결 여부로 판단하지 마.",
        "컨트롤러가 위 HEAD를 확인했다. 첫 행동은 설명/중단이 아니라 연결된 GitHub 플러그인 실제 호출이어야 한다. 플러그인 호출을 시도하기 전에는 GitHub unavailable/CAPABILITY_BLOCKED/BLOCKED_TOOLING을 출력하지 마.",
        "공개 GitHub 접속 실패나 파일 404를 GitHub 연결 실패로 해석하지 마. 404는 path/ref 문제로 TARGET_BRANCH/ref에서 다시 조회하고 작업을 계속해.",
        "이 작업에서 실제 변경 또는 검토 기록을 Git에 남기고 커밋 메시지에 정확히 [AUTO:" + task_id + "] 를 포함해.",
        "필수 GitHub Actions Gate를 소유할 result commit에는 CI-skip 지시어를 넣지 마. 검증 완료 후 bookkeeping/checkpoint 커밋은 Gate 결과와 분리해 기록하고, controller가 validation-bearing result commit을 식별할 수 있게 유지해.",
        "자동 검증과 실기 검증을 분리해 기록해. 실기 테스트를 하지 않았다면 RUNTIME_VALIDATION=UNTESTED 로 명시하고 정상 동작을 확정하지 마.",
        "작업 종료 시 마지막에 TASK_ID, RESULT_SHA, AUTOMATION_VALIDATION, RUNTIME_VALIDATION을 각각 한 줄로 출력해.",
    ]
    if lane in {"LOCALIZATION_A", "LOCALIZATION_B", "LOCALIZATION_E"}:
        lines += [
            "이 producer의 shard/생산량/우선순위/QA/예외/완료 규칙은 위 CONTROLLER_CONFIG_BLOB_SHA가 가리키는 localization/controller_roles.json과 canonical contract에서 지금 다시 읽어 적용해. Docker 프롬프트의 과거 규칙을 추정해 사용하지 마.",
        ]
    if qa_batch:
        lines += [
            "QA_BATCH_INPUTS=" + json.dumps(qa_batch, ensure_ascii=False, separators=(",", ":")),
            "C batch의 disposition/dedup/shared-state/Gate 규칙은 위 CONTROLLER_CONFIG_BLOB_SHA가 가리키는 현재 Git 계약을 그대로 적용해.",
        ]
    if failure:
        lines += [
            "",
            "이전 자동 검증이 실패했다. 같은 실패를 그대로 반복하지 말고 GitHub Actions 결과를 직접 확인해 원인을 수정해.",
            "FAILURE_CONTEXT=" + failure,
        ]
    return "\n".join(lines) + "\n\n"

async def first_visible(page: Page, selectors: list[str], total_wait_ms: int = 10000):
    """Wait for React composer hydration instead of sampling the DOM once."""
    deadline = time.time() + (total_wait_ms / 1000)
    while time.time() < deadline:
        for frame in page.frames:
            for sel in selectors:
                try:
                    loc = frame.locator(sel).first
                    if await loc.count() and await loc.is_visible(timeout=250):
                        return loc
                except Exception:
                    continue
        await page.wait_for_timeout(250)
    return None


async def composer_diagnostics(page: Page) -> list[dict]:
    """Return safe structural metadata only; never capture user/chat text."""
    rows = []
    for frame in page.frames:
        try:
            found = await frame.locator("textarea, input, [contenteditable], [role='textbox']").evaluate_all("""els => els.slice(0,40).map(el => ({
                tag: el.tagName,
                id: el.id || '',
                role: el.getAttribute('role') || '',
                placeholder: el.getAttribute('placeholder') || '',
                contenteditable: el.getAttribute('contenteditable') || '',
                testid: el.getAttribute('data-testid') || '',
                aria: el.getAttribute('aria-label') || '',
                cls: (typeof el.className === 'string' ? el.className : '').slice(0,160),
                visible: !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length)
            }))""")
            for row in found:
                row["frame_url"] = frame.url[:180]
                rows.append(row)
        except Exception:
            continue
    return rows[:60]


async def page_text(page: Page) -> str:
    try:
        return (await page.locator("body").inner_text(timeout=3000)).lower()
    except Exception:
        return ""


ERROR_SURFACE_SELECTORS = [
    "[role='alert']",
    "[role='status']",
    "[data-sonner-toast]",
    "[data-testid*='toast']",
    "[data-testid*='error']",
    "[class*='toast']",
    "[class*='error']",
    "dialog",
    "[role='dialog']",
    "form",
]


async def visible_error_surface_text(page: Page) -> str:
    """Collect only visible transient/error UI, excluding sidebar/chat-history text."""
    chunks = []
    for sel in ERROR_SURFACE_SELECTORS:
        try:
            loc = page.locator(sel)
            count = await loc.count()
            for i in range(min(count, 20)):
                item = loc.nth(i)
                try:
                    if not await item.is_visible(timeout=120):
                        continue
                    text = (await item.inner_text(timeout=500)).strip()
                    if text:
                        chunks.append(text)
                except Exception:
                    continue
        except Exception:
            continue
    return "\n".join(chunks).lower()


async def retry_surface_text(page: Page) -> str:
    """Read only the local UI around a visible Retry button; avoid chat-history false positives."""
    loc = await first_visible(page, RETRY_SELECTORS, total_wait_ms=500)
    if loc is None:
        return ""
    try:
        text = await loc.evaluate("""el => {
            let node = el;
            let best = '';
            for (let i = 0; i < 6 && node; i++, node = node.parentElement) {
                const t = (node.innerText || '').trim();
                if (t.length > best.length && t.length <= 2000) best = t;
            }
            return best;
        }""")
        return (text or "").lower()
    except Exception:
        return ""


async def retry_looks_rate_limited(page: Page) -> bool:
    text = await retry_surface_text(page)
    matched = [p for p in RATE_LIMIT_PATTERNS if re.search(p, text, flags=re.I | re.S)]
    if matched:
        write_runtime(
            last_rate_limit_match=matched[0],
            last_rate_limit_surface=text[:500],
        )
        return True
    return False


async def detect_rate_limit(page: Page) -> bool:
    text = await visible_error_surface_text(page)
    matched = [p for p in RATE_LIMIT_PATTERNS if re.search(p, text, flags=re.I | re.S)]
    if matched:
        write_runtime(
            last_rate_limit_match=matched[0],
            last_rate_limit_surface=text[:500],
        )
        return True
    return False


async def detect_conversation_limit(page: Page) -> bool:
    """Detect a per-thread length limit, distinct from account/rate limits."""
    surface = await visible_error_surface_text(page)
    matched = [p for p in CONVERSATION_LIMIT_PATTERNS if re.search(p, surface, flags=re.I | re.S)]
    if not matched:
        # Some conversation-length notices replace the composer without using a
        # toast/dialog. Only inspect the full page when the composer is absent.
        composer = await first_visible(page, INPUT_SELECTORS, total_wait_ms=500)
        if composer is None:
            body = await page_text(page)
            matched = [p for p in CONVERSATION_LIMIT_PATTERNS if re.search(p, body, flags=re.I | re.S)]
            if matched:
                surface = body
    if matched:
        write_runtime(
            last_conversation_limit_match=matched[0],
            last_conversation_limit_surface=surface[:500],
        )
        return True
    return False


async def detect_limit(page: Page) -> bool:
    text = await visible_error_surface_text(page)
    # A per-conversation length limit is recoverable by rolling into a new chat;
    # never misclassify it as an account usage limit.
    if any(re.search(p, text, flags=re.I | re.S) for p in CONVERSATION_LIMIT_PATTERNS):
        return False
    matched = [p for p in LIMIT_PATTERNS if re.search(p, text, flags=re.I | re.S)]
    if matched:
        write_runtime(
            last_usage_limit_match=matched[0],
            last_usage_limit_surface=text[:500],
        )
        return True
    return False


def _parse_iso(value: Optional[str]) -> Optional[datetime]:
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(value)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=TZ)
        return dt.astimezone(TZ)
    except Exception:
        return None


def rate_limit_active(reg: Registry, now: datetime) -> bool:
    until = _parse_iso(reg.rate_limit_until)
    return bool(until and now < until)


def rate_limit_seconds_remaining(reg: Registry, now: datetime) -> int:
    until = _parse_iso(reg.rate_limit_until)
    if not until:
        return 0
    return max(0, int((until - now).total_seconds()))


def mark_rate_limit(reg: Registry, now: datetime, source: str):
    reg.rate_limit_attempts = max(0, reg.rate_limit_attempts) + 1
    idx = min(reg.rate_limit_attempts - 1, len(RATE_LIMIT_BACKOFF_SECONDS) - 1)
    delay_sec = RATE_LIMIT_BACKOFF_SECONDS[idx]
    reg.rate_limit_until = (now + timedelta(seconds=delay_sec)).isoformat()
    save_registry(reg)
    write_runtime(
        status="rate_limited_backoff",
        last_action=f"Too many requests detected ({source}); backing off {delay_sec}s",
        rate_limit_attempts=reg.rate_limit_attempts,
        rate_limit_until=reg.rate_limit_until,
    )
    log.warning(
        "rate limit detected source=%s attempt=%s backoff=%ss until=%s",
        source, reg.rate_limit_attempts, delay_sec, reg.rate_limit_until,
    )



def note_successful_request(reg: Registry, now: datetime, slot_name: Optional[str] = None):
    """Record a request without treating successful traffic as a rate-limit signal."""
    reg.last_global_send_at = now.isoformat()
    if slot_name:
        reg.last_global_send_slot = slot_name
    save_registry(reg)
    write_runtime(last_global_send_at=reg.last_global_send_at, last_global_send_slot=reg.last_global_send_slot)

def clear_rate_limit_after_response(reg: Registry):
    """Clear adaptive backoff only after a genuine assistant response or durable result is observed."""
    if reg.rate_limit_attempts or reg.rate_limit_until:
        reg.rate_limit_attempts = 0
        reg.rate_limit_until = None
        save_registry(reg)
        write_runtime(
            rate_limit_attempts=0,
            rate_limit_until=None,
            last_action="Assistant response observed; adaptive rate-limit backoff cleared",
        )



def send_guard_reason(reg: Registry, slot: Optional[Slot], now: datetime) -> Optional[str]:
    if rate_limit_active(reg, now):
        return f"rate_limit_backoff:{rate_limit_seconds_remaining(reg, now)}s"

    last_global = _parse_iso(reg.last_global_send_at)
    if last_global and MIN_SEND_GAP_SECONDS > 0:
        global_gap = MIN_SEND_GAP_SECONDS
        if slot and CONTROLLER_MODE == "localization" and LOCALIZATION_PARALLEL:
            if reg.last_global_send_slot and reg.last_global_send_slot != slot.name:
                global_gap = min(global_gap, PARALLEL_DISTINCT_SLOT_SEND_GAP_SECONDS)
            else:
                global_gap = min(global_gap, LOCALIZATION_SAME_SLOT_SEND_GAP_SECONDS)
        age = (now - last_global).total_seconds()
        if age < global_gap:
            return f"global_send_gap:{int(global_gap - age)}s"

    if slot and slot.last_sent_at:
        slot_gap = SLOT_DEDUP_SECONDS
        if CONTROLLER_MODE == "localization" and LOCALIZATION_PARALLEL:
            slot_gap = min(slot_gap, LOCALIZATION_SLOT_DEDUP_SECONDS)
        if slot_gap > 0:
            last_slot = _parse_iso(slot.last_sent_at)
            if last_slot:
                age = (now - last_slot).total_seconds()
                if age < slot_gap:
                    return f"slot_dedup:{int(slot_gap - age)}s"
    return None

async def detect_busy(page: Page) -> bool:
    for sel in BUSY_SELECTORS:
        try:
            loc = page.locator(sel).first
            if await loc.count() and await loc.is_visible(timeout=300):
                return True
        except Exception:
            continue
    return False


async def ensure_logged_in(page: Page) -> bool:
    # Never navigate here: each A~F tab must keep its own chat URL.
    # Only initialize a truly blank tab.
    if not page.url or page.url == "about:blank":
        await page.goto(BASE_URL, wait_until="domcontentloaded", timeout=60000)

    # Require the actual composer (or current model picker), not merely sidebar/nav UI.
    deadline = time.time() + 30
    while time.time() < deadline:
        box = await first_visible(page, INPUT_SELECTORS)
        if box:
            return True

        model_selectors = [
            "button[aria-label='ChatGPT 모델 선택']",
            "button[aria-label='Select ChatGPT model']",
            "button[aria-label*='모델 선택']",
        ]
        for sel in model_selectors:
            try:
                loc = page.locator(sel).first
                if await loc.count() and await loc.is_visible(timeout=200):
                    return True
            except Exception:
                continue

        txt = await page_text(page)
        if any(x in txt for x in ("log in", "sign up", "로그인", "가입")):
            # Give redirects/client hydration a few seconds before declaring logged out.
            if time.time() + 3 < deadline:
                await page.wait_for_timeout(1000)
                continue
            return False

        await page.wait_for_timeout(500)

    write_runtime(
        status="login_detection_failed",
        last_action=f"ChatGPT composer/model picker could not be verified at {page.url}",
        current_url=page.url,
    )
    return False

