@dataclass
class Slot:
    name: str
    url: Optional[str] = None
    runs: int = 0
    last_sent_at: Optional[str] = None
    last_result: Optional[str] = None
    last_assistant_hash: Optional[str] = None
    last_assistant_change_at: Optional[str] = None
    watchdog_resumes_since_schedule: int = 0
    last_watchdog_at: Optional[str] = None


@dataclass
class Registry:
    logical_date: str
    next_slot: int
    slots: list[Slot]
    active_lanes: dict = field(default_factory=dict)
    artifact_records: dict = field(default_factory=dict)
    qa_queue: list = field(default_factory=list)
    producer_cooldowns: dict = field(default_factory=dict)
    schema: str = "lane-asset-v1"
    reconciled_head: Optional[str] = None
    rate_limit_attempts: int = 0
    rate_limit_until: Optional[str] = None
    last_global_send_at: Optional[str] = None
    last_global_send_slot: Optional[str] = None


