@dataclass
class Slot:
    name: str
    url: Optional[str] = None
    runs: int = 0
    last_sent_at: Optional[str] = None
    last_result: Optional[str] = None
    last_assistant_hash: Optional[str] = None
    last_assistant_change_at: Optional[str] = None
    watchdog_resumes_since_schedule: int = 0
    last_watchdog_at: Optional[str] = None
    thinking_verify_failures: int = 0
    last_thinking_failure_at: Optional[str] = None
    chat_task_count: int = 0
    chat_started_at: Optional[str] = None
    last_task_completed_at: Optional[str] = None

class ControllerRestartRequested(RuntimeError):
    pass


class GitHubTransientError(RuntimeError):
    """Temporary GitHub transport/API failure; queue state must be preserved and retried."""
    pass


@dataclass
class Registry:
    logical_date: str
