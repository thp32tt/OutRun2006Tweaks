def _project_id_from_url(url: str) -> Optional[str]:
    try:
        path = urllib.parse.urlparse(url or "").path
    except Exception:
        return None
    m = re.search(r"/g/(g-p-[A-Za-z0-9]+)", path)
    return m.group(1) if m else None

