class StatusHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        return

    def do_GET(self):
        if self.path == "/healthz":
            now = datetime.now(TZ)
            heartbeat = _parse_iso(runtime.get("queue_loop_heartbeat_at"))
            started = _parse_iso(runtime.get("started_at")) or now
            reference = heartbeat or started
            age = max(0, int((now - reference).total_seconds()))
            memory_fields = _cgroup_memory_runtime_fields()
            memory_percent = memory_fields.get("container_memory_percent")
            healthy = (
                age < PROCESS_HEARTBEAT_FATAL_SECONDS
                and (memory_percent is None or memory_percent < MEMORY_FATAL_RESTART_PERCENT)
            )
            body = json.dumps({
                "healthy": healthy,
                "heartbeat_age_seconds": age,
                "fatal_after_seconds": PROCESS_HEARTBEAT_FATAL_SECONDS,
                "memory_percent": memory_percent,
                "memory_fatal_percent": MEMORY_FATAL_RESTART_PERCENT,
                "status": runtime.get("status"),
            }, ensure_ascii=False).encode("utf-8")
            self.send_response(200 if healthy else 503)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers(); self.wfile.write(body)
            return
        if self.path not in ("/", "/status"):
            self.send_response(404); self.end_headers(); return
        now = datetime.now(TZ)
        reg = load_registry(now)
        q = load_queue_state()
        execution = (
            (
                f"QUEUE / localization continuous A/B/E producers + independent batched C QA (check every {QUEUE_CHECK_SECONDS}s)"
                if CONTROLLER_MODE == "localization" and LOCALIZATION_PARALLEL
                else f"QUEUE / event-driven (check every {QUEUE_CHECK_SECONDS}s; legacy schedule ignored)"
            )
            if QUEUE_MODE else
            f"SCHEDULE / minute {SCHEDULE_MINUTES} KST"
        )
        legacy_schedule = "ignored while QUEUE_MODE=true" if QUEUE_MODE else f"active: minute {SCHEDULE_MINUTES} KST"
        body = f"""<!doctype html><html><head><meta charset='utf-8'><title>OutRun Chat Controller</title>
<style>body{{font-family:sans-serif;max-width:1000px;margin:40px auto;padding:0 20px}}pre{{background:#f5f5f5;padding:16px;overflow:auto}}.ok{{font-weight:700}}</style></head><body>
<h1>OutRun Chat Controller</h1>
<p><b>Controller mode:</b> {html.escape(str(CONTROLLER_MODE))}</p>
<p><b>AUTO_SEND:</b> {html.escape(str(AUTO_SEND))}</p>
<p><b>Execution:</b> <span class='ok'>{html.escape(execution)}</span></p>
<p><b>Legacy schedule:</b> {html.escape(legacy_schedule)}</p>
<p><b>Status:</b> {html.escape(str(runtime.get('status')))}</p>
<p><b>Last action:</b> {html.escape(str(runtime.get('last_action')))}</p>
<p><b>Queue:</b> poll {QUEUE_CHECK_SECONDS}s / response stable {QUEUE_STABLE_SECONDS}s / no-response grace {QUEUE_RESULT_GRACE_SECONDS}s / GitHub discovery {GITHUB_POLL_SECONDS}s / exact run {GITHUB_BOUND_RUN_POLL_SECONDS}s / missing-run timeout {WAIT_ACTIONS_NO_RUN_TIMEOUT_SECONDS}s / max attempts {MAX_TASK_ATTEMPTS}</p>
<p><b>Conversation rollover:</b> {html.escape(str(CONVERSATION_ROLLOVER_ENABLED))} / max {MAX_CHAT_ROLLOVERS_PER_TASK} per task / rollover does not increment attempt</p>
<p><b>Watchdog:</b> {html.escape(str(WATCHDOG_ENABLED))} / recovery-only in queue mode / idle {WATCHDOG_STALL_MINUTES}m / busy-stall {WATCHDOG_BUSY_STALL_MINUTES}m / force-stop {html.escape(str(WATCHDOG_FORCE_STOP_STALLED))}</p>
<p><b>Liveness bounds:</b> Actions max {WAIT_ACTIONS_MAX_SECONDS}s / heartbeat fatal {PROCESS_HEARTBEAT_FATAL_SECONDS}s / queue errors {QUEUE_ERROR_RESTART_THRESHOLD} / watchdog errors {WATCHDOG_ERROR_RESTART_THRESHOLD}</p>
<p><b>Rate limit:</b> attempts {reg.rate_limit_attempts} / until {html.escape(str(reg.rate_limit_until))} / backoff {html.escape(str(RATE_LIMIT_BACKOFF_SECONDS))}s / global-gap {MIN_SEND_GAP_SECONDS}s / slot-dedup {SLOT_DEDUP_SECONDS}s</p>
<p><b>GitHub REST:</b> token {html.escape(str(bool(GITHUB_TOKEN)))} / task-cache {GITHUB_TASK_COMMIT_CACHE_SECONDS}s / actions-cache {GITHUB_ACTIONS_CACHE_SECONDS}s / remaining {html.escape(str(runtime.get('github_rate_limit_remaining')))} / blocked-until {html.escape(str(runtime.get('github_api_blocked_until')))}</p>
<p><b>Execution:</b> Native connected plugins / controller GitHub observer (read only)</p>
<p><b>Thinking:</b> required {html.escape(PREFERRED_THINKING_LEVEL)} / strict {html.escape(str(STRICT_THINKING_LEVEL))} / last {html.escape(str(runtime.get('last_thinking_level_result')))}</p>
<p><b>Logical date:</b> {html.escape(reg.logical_date)}</p>
<p><b>Next slot:</b> {html.escape(reg.slots[reg.next_slot].name)}</p>
<p><b>noVNC:</b> {f"<a href='{html.escape(NOVNC_PUBLIC_URL, quote=True)}' target='_blank' rel='noopener noreferrer'>{html.escape(NOVNC_PUBLIC_URL)}</a>" if NOVNC_PUBLIC_URL else "not configured"}</p>
<h2>Queue State</h2><pre>{html.escape(json.dumps(q, ensure_ascii=False, indent=2))}</pre>
<h2>Registry</h2><pre>{html.escape(json.dumps({"next_slot": reg.next_slot, "rate_limit_attempts": reg.rate_limit_attempts, "rate_limit_until": reg.rate_limit_until, "last_global_send_at": reg.last_global_send_at, "last_global_send_slot": reg.last_global_send_slot, "slots": [asdict(s) for s in reg.slots]}, ensure_ascii=False, indent=2))}</pre>
<h2>Runtime</h2><pre>{html.escape(json.dumps(runtime, ensure_ascii=False, indent=2))}</pre>
</body></html>""".encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers(); self.wfile.write(body)


def start_status_server():
    server = ThreadingHTTPServer(("0.0.0.0", STATUS_PORT), StatusHandler)
    t = threading.Thread(target=server.serve_forever, daemon=True)
    t.start()
    log.info("status server listening on :%s", STATUS_PORT)


def start_process_liveness_monitor():
    """Exit a wedged controller so Docker can reconstruct Chrome/Playwright/controller."""
    def monitor():
        while True:
            time.sleep(30)
            if not AUTO_SEND or not QUEUE_MODE:
                continue
            now = datetime.now(TZ)
            memory_fields = _cgroup_memory_runtime_fields()
            runtime.update(memory_fields)
            memory_percent = memory_fields.get("container_memory_percent")
            has_active = True
            try:
                q = load_queue_state()
                active = q.get("active")
                lanes = q.get("active_by_lane") or {}
                has_active = bool(active) or any(
                    task and task.get("phase") != "DONE" for task in lanes.values()
                )
            except Exception:
                log.exception("liveness monitor could not inspect queue activity; treating queue as active")

            memory_restart = False
            memory_status = None
            if memory_percent is not None and memory_percent >= MEMORY_FATAL_RESTART_PERCENT:
                memory_restart = True
                memory_status = "memory_pressure_fatal_restart"
            elif memory_percent is not None and memory_percent >= MEMORY_IDLE_RESTART_PERCENT and not has_active:
                memory_restart = True
                memory_status = "memory_pressure_idle_restart"
            if memory_restart:
                message = (
                    f"Container memory reached {memory_percent:.1f}% "
                    f"(idle={MEMORY_IDLE_RESTART_PERCENT:.1f}%, fatal={MEMORY_FATAL_RESTART_PERCENT:.1f}%); "
                    f"active={has_active}; exiting for clean Docker restart before OOM"
                )
                log.warning(message)
                try:
                    runtime["status"] = memory_status
                    runtime["last_action"] = message
                    runtime["last_error"] = None
                    RUNTIME_FILE.write_text(json.dumps(runtime, ensure_ascii=False, indent=2), encoding="utf-8")
                except Exception:
                    log.exception("failed to persist memory-pressure restart state")
                os._exit(71)

            heartbeat = _parse_iso(runtime.get("queue_loop_heartbeat_at"))
            started = _parse_iso(runtime.get("started_at")) or now
            reference = heartbeat or started
            age = max(0, int((now - reference).total_seconds()))
            if age < PROCESS_HEARTBEAT_FATAL_SECONDS:
                continue
            message = (
                f"Queue heartbeat stale for {age}s (fatal={PROCESS_HEARTBEAT_FATAL_SECONDS}s); "
                "exiting so Docker restart policy can recover the full browser/controller stack"
            )
            log.critical(message)
            try:
                runtime["status"] = "heartbeat_stalled_restart"
                runtime["last_action"] = message
                runtime["last_error"] = message
                runtime["heartbeat_stale_seconds"] = age
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                RUNTIME_FILE.write_text(json.dumps(runtime, ensure_ascii=False, indent=2), encoding="utf-8")
            except Exception:
                log.exception("failed to persist heartbeat-stalled restart state")
            os._exit(70)

    threading.Thread(target=monitor, name="controller-liveness-monitor", daemon=True).start()
    log.info("process liveness monitor armed fatal_after=%ss", PROCESS_HEARTBEAT_FATAL_SECONDS)


def queue_rollover_prompt(active: dict) -> str:
    rollover = int(active.get("chat_rollovers", 0)) + 1
    lines = [
        "[롤오버 재개]",
        f"TASK_ID={active['task_id']}",
        f"LANE={active['lane']}",
        f"TARGET_BRANCH={active['branch']}",
        f"ATTEMPT={active['attempt']}/{MAX_TASK_ATTEMPTS}",
        f"CHAT_ROLLOVER={rollover}",
    ]
    if CONTROLLER_MODE == "localization":
        schema_version, config_blob_sha = localization_controller_contract_fingerprint()
        lines += [
            f"CONTROLLER_SCHEMA_VERSION={schema_version}",
            f"CONTROLLER_CONFIG_BLOB_SHA={config_blob_sha}",
            localization_final_artwork_progress_hint(active["branch"]),
        ]
        if _is_localization_producer(active):
            lines += [
                "ACTIVE_TASK_LATCH=ON",
                f"CONTROLLER_STAGE={active.get('controller_stage') or 'WAIT_MATERIAL_COMMIT'}",
                f"LAST_CHECKPOINT_HEAD={active.get('last_checkpoint_head') or active.get('base_sha') or ''}",
                f"PREMATURE_STOP_RECOVERY_TOTAL={int(active.get('premature_stop_total', 0) or 0)}",
                "FIRST_EXECUTION_ACTION=DO_NOT_PLAN; resume material/tool execution immediately.",
            ]
    elif CONTROLLER_MODE == "conversion" and active.get("task_latched", True):
        lines += [
            "GITHUB_ONLY_DEVELOPMENT=true",
            "ACTIVE_TASK_LATCH=ON",
            f"CONTROLLER_STAGE={active.get('controller_stage') or 'WAIT_DURABLE_RESULT'}",
            f"LAST_CHECKPOINT_HEAD={active.get('last_checkpoint_head') or active.get('base_sha') or ''}",
            f"PREMATURE_STOP_RECOVERY_TOTAL={int(active.get('premature_stop_total', 0) or 0)}",
            "FIRST_EXECUTION_ACTION=DO_NOT_PLAN; continue the requested repository work immediately.",
            "No local PC/RenderDoc/OpenXR runtime is required for source/static/CI progress.",
        ]
    lines += [
        "같은 TASK_ID를 계속해. 완료 작업 반복 금지. 실기 미검증이면 RUNTIME_VALIDATION=UNTESTED.",
    ]
    lines += ["", native_plugin_instructions(active)]
    if CONTROLLER_MODE == "conversion":
        lines = [GAME_MOD_CONTEXT, ""] + lines
    return "\n".join(lines)


async def queue_rollover_chat(context: BrowserContext, pages: dict[str, Page], active: dict, reason: str) -> bool:
    """Move one active task to a fresh chat without consuming a repair attempt."""
    if not CONVERSATION_ROLLOVER_ENABLED:
        return False
    count = int(active.get("chat_rollovers", 0))
    if count >= MAX_CHAT_ROLLOVERS_PER_TASK:
        if _is_latched_execution_task(active) and active.get("task_latched", True):
            # Producer continuity outranks the legacy per-task chat budget.
            # Rollovers are already gated by explicit failure signals and send spacing.
            active["rollover_soft_limit_exceeded"] = count
            active["assistant_claim_verification"] = "ACTIVE_TASK_LATCH_ROLLOVER_RECOVERY"
        else:
            active["failure_context"] = (
                f"conversation rollover limit reached ({MAX_CHAT_ROLLOVERS_PER_TASK}) after: {reason}"
            )
            active["phase"] = "BLOCKED"
            return False

    now = datetime.now(TZ)
    reg = load_registry(now)
    slot = next((s for s in reg.slots if s.name == active["slot"]), None)
    if slot is None:
        return False

    guard = send_guard_reason(reg, slot, now)
    if guard:
        write_runtime(
            status="conversation_rollover_wait",
            last_action=f"{active['task_id']} rollover waiting for {guard}",
        )
        return False

    # Build/refresh the task prompt before closing the current page. A temporary
    # GitHub policy lookup failure must never create an unnecessary blank chat.
    try:
        rollover_prompt = queue_rollover_prompt(active)
    except GitHubTransientError as e:
        write_runtime(
            status="github_retry_wait",
            last_action=f"{active['task_id']}: GitHub temporary error before rollover; keeping current chat and retrying GitHub",
            last_error=repr(e),
        )
        return False
    except Exception as e:
        if CONTROLLER_MODE == "localization":
            write_runtime(
                status="policy_refresh_wait",
                last_action=f"{active['task_id']}: rollover policy refresh failed; current chat preserved for later retry",
                last_error=repr(e),
            )
            return False
        raise

    old_page = pages.get(slot.name)
    old_url = slot.url or (old_page.url if old_page and not old_page.is_closed() else None)
    previous = list(active.get("previous_chat_urls", []))
    if old_url and old_url not in previous:
        previous.append(old_url)
    active["previous_chat_urls"] = previous[-20:]

    page = await replace_with_fresh_slot_page(context, pages, slot)
    if not await ensure_logged_in(page):
        write_runtime(status="login_required", last_action=f"{active['task_id']}: login required after conversation rollover")
        return False
    if await first_visible(page, INPUT_SELECTORS, total_wait_ms=5000) is None:
        write_runtime(status="conversation_rollover_failed", last_action=f"{active['task_id']}: fresh project composer unavailable")
        return False

    runtime["queue_task_id"] = active["task_id"]
    runtime["queue_lane"] = active["lane"]
    runtime["queue_branch"] = active["branch"]
    runtime["queue_attempt"] = active["attempt"]
    runtime["queue_wave_id"] = active.get("wave_id")
    runtime["queue_failure_context"] = active.get("failure_context", "")

    thinking_ok = await ensure_thinking_level(page)
    if thinking_ok:
        track_thinking_verification(reg, slot, True, "conversation_rollover")
    elif STRICT_THINKING_LEVEL:
        track_thinking_verification(reg, slot, False, "conversation_rollover")
        return False

    result = await send_message(page, rollover_prompt)
    if result != "sent":
        write_runtime(status="conversation_rollover_failed", last_action=f"{active['task_id']}: rollover send failed: {result}")
        return False

    sent_at = datetime.now(TZ)
    new_url = await wait_for_chat_url(page, timeout_sec=8)
    if new_url:
        slot.url = new_url
        active["active_chat_url"] = new_url

    active["chat_rollovers"] = count + 1
    active["last_rollover_reason"] = reason
    active["last_rollover_at"] = sent_at.isoformat()
    active["sent_at"] = sent_at.isoformat()
    active["dispatch_confirmed"] = True
    active["last_hash"] = None
    active["last_hash_changed_at"] = sent_at.isoformat()
    active["generic_retry_clicks"] = 0
    active["last_retry_click_at"] = None
    active["last_retry_backoff_at"] = None
    active["phase"] = "WAIT_CHAT"
    active["native_plugin_protocol_version"] = NATIVE_PLUGIN_PROTOCOL_VERSION
    slot.last_sent_at = sent_at.isoformat()
    slot.chat_task_count = 1
    if not slot.chat_started_at:
        slot.chat_started_at = sent_at.isoformat()
    slot.last_task_completed_at = None
    slot.last_assistant_hash = None
    slot.last_assistant_change_at = sent_at.isoformat()
    slot.last_result = "conversation_rollover_sent"
    note_successful_request(reg, sent_at, slot.name)
    save_registry(reg)
    write_runtime(
        status="conversation_rollover_sent",
        last_action=f"{active['task_id']} moved to fresh chat rollover={active['chat_rollovers']} without incrementing attempt",
        queue=active,
    )
    return True


async def collect_retry_diagnostic(
    page: Page,
    slot: Slot,
    active: dict,
    retry_text: str,
    *,
    busy: bool,
) -> dict:
    """Capture bounded UI/queue evidence for persistent Retry without dumping chat history."""
    now = datetime.now(TZ)
    composer = await first_visible(page, INPUT_SELECTORS, total_wait_ms=250)
    composer_rows = []
    if composer is None:
        composer_rows = (await composer_diagnostics(page))[:8]
    assistant_text = await current_assistant_text(page)
    rate_matches = [p for p in RATE_LIMIT_PATTERNS if re.search(p, retry_text, flags=re.I | re.S)]
    conversation_matches = [p for p in CONVERSATION_LIMIT_PATTERNS if re.search(p, retry_text, flags=re.I | re.S)]
    usage_matches = [p for p in LIMIT_PATTERNS if re.search(p, retry_text, flags=re.I | re.S)]
    if rate_matches:
        classification = "RATE_LIMIT"
    elif conversation_matches:
        classification = "CONVERSATION_LIMIT"
    elif usage_matches:
        classification = "USAGE_LIMIT"
    elif busy:
        classification = "BUSY_WITH_RETRY"
    elif composer is None:
        classification = "GENERIC_RETRY_COMPOSER_MISSING"
    else:
        classification = "GENERIC_RETRY_COMPOSER_PRESENT"
    try:
        page_title = (await page.title())[:160]
    except Exception:
        page_title = ""
    sent_at = _parse_iso(active.get("sent_at"))
    return {
        "at": now.isoformat(),
        "classification": classification,
        "controller_mode": CONTROLLER_MODE,
        "task_id": active.get("task_id"),
        "slot": getattr(slot, "name", None),
        "lane": active.get("lane"),
        "branch": active.get("branch"),
        "phase": active.get("phase"),
        "attempt": active.get("attempt"),
        "task_latched": active.get("task_latched"),
        "controller_stage": active.get("controller_stage"),
        "page_url": str(getattr(page, "url", "") or "")[:500],
        "page_title": page_title,
        "retry_surface": (retry_text or "")[:800],
        "busy": bool(busy),
        "composer_visible": composer is not None,
        "composer_diagnostics": composer_rows,
        "assistant_response_present": bool(assistant_text),
        "assistant_response_chars": len(assistant_text or ""),
        "assistant_response_hash": stable_hash(assistant_text) if assistant_text else None,
        "rate_limit_match": rate_matches[0] if rate_matches else None,
        "conversation_limit_match": conversation_matches[0] if conversation_matches else None,
        "usage_limit_match": usage_matches[0] if usage_matches else None,
        "generic_retry_clicks": int(active.get("generic_retry_clicks", 0) or 0),
        "chat_rollovers": int(active.get("chat_rollovers", 0) or 0),
        "seconds_since_send": (
            max(0, int((now - sent_at).total_seconds())) if sent_at else None
        ),
    }


async def queue_handle_retry_surface(context: BrowserContext, pages: dict[str, Page], page: Page, reg: Registry, slot: Slot, active: dict, q: dict) -> bool:
    """Serialize Retry handling while distinguishing real rate pressure from generic transient Retry."""
    retry = await first_visible(page, RETRY_SELECTORS, total_wait_ms=500)
    if retry is None:
        return False

    now = datetime.now(TZ)
    retry_text = await retry_surface_text(page)
    busy = await detect_busy(page)
    diagnostic = await collect_retry_diagnostic(
        page, slot, active, retry_text, busy=busy
    )
    persist_retry_diagnostic(diagnostic)
    active["last_retry_diagnostic_at"] = diagnostic["at"]
    active["last_retry_classification"] = diagnostic["classification"]
    active["last_retry_composer_visible"] = diagnostic["composer_visible"]
    active["last_retry_surface"] = diagnostic["retry_surface"]
    save_queue_state(q)

    if busy:
        write_runtime(
            status="retry_busy_observed",
            last_action=f"{active['task_id']} Retry visible while generation is still busy",
            queue=active,
        )
        return True

    is_rate = diagnostic["classification"] == "RATE_LIMIT"
    generic_clicks = int(active.get("generic_retry_clicks", 0) or 0)

    # An idle, stable response is handled before stale generic Retry UI.
    # The caller has already checked Git for a durable task commit.
    if not is_rate:
        assistant_text = await current_assistant_text(page)
        if assistant_text:
            h = stable_hash(assistant_text)
            if h != active.get("last_hash"):
                active["last_hash"] = h
                active["last_hash_changed_at"] = now.isoformat()
                save_queue_state(q)
                return True
            changed_at = _parse_iso(active.get("last_hash_changed_at")) or now
            if (now - changed_at).total_seconds() < QUEUE_STABLE_SECONDS:
                return True
            await queue_handle_native_response(context, pages, active, assistant_text)
            save_queue_state(q)
            return True

    if is_rate:
        if rate_limit_active(reg, now):
            write_runtime(
                status="rate_limited_backoff",
                last_action=f"Too many requests on {active['task_id']}; waiting {rate_limit_seconds_remaining(reg, now)}s",
                rate_limit_attempts=reg.rate_limit_attempts,
                rate_limit_until=reg.rate_limit_until,
            )
            return True

        last_backoff = _parse_iso(active.get("last_retry_backoff_at"))
        last_click = _parse_iso(active.get("last_retry_click_at"))
        if last_backoff is None or (last_click is not None and last_click > last_backoff):
            mark_rate_limit(reg, now, f"queue-retry:{active['task_id']}:too-many-requests")
            active["last_retry_backoff_at"] = now.isoformat()
            active["last_retry_context"] = retry_text[:500]
            slot.last_result = "queue_rate_limit_backoff"
            save_registry(reg)
            save_queue_state(q)
            return True

        guard = send_guard_reason(reg, slot, now)
        if guard:
            write_runtime(status="retry_wait", last_action=f"Rate-limit Retry for {active['task_id']} waiting for {guard}")
            return True
    else:
        # A persistent generic Retry means the current conversation surface is not a
        # usable input surface. After the bounded controlled clicks, preserve TASK_ID
        # but move to a fresh project chat instead of cooling down in the broken chat.
        if generic_clicks >= GENERIC_RETRY_ROLLOVER_CLICKS:
            reason = (
                f"Generic Retry remained visible after {generic_clicks} controlled clicks; "
                "current chat input is unusable, so resume the same TASK_ID in a fresh project chat."
            )
            active["failure_context"] = reason
            active["task_latched"] = True
            if CONTROLLER_MODE == "localization":
                active["controller_stage"] = (
                    "WAIT_QA_RESULT" if str(active.get("lane") or "") == "LOCALIZATION_C"
                    else active.get("controller_stage") or "WAIT_MATERIAL_COMMIT"
                )
            else:
                active["controller_stage"] = active.get("controller_stage") or "WAIT_DURABLE_RESULT"
            active.pop("generic_retry_cooldown_until", None)
            if await queue_rollover_chat(context, pages, active, reason):
                active["generic_retry_clicks"] = 0
                active["last_retry_recovery_action"] = "FRESH_CHAT_ROLLOVER"
                save_queue_state(q)
                return True
            # Rollover may be temporarily deferred by normal send spacing. Stay
            # nonterminal and retry the rollover on the next queue cycle.
            active["phase"] = "WAIT_CHAT"
            active["terminal"] = None
            save_queue_state(q)
            write_runtime(
                status="generic_retry_rollover_wait",
                last_action=f"{active['task_id']} input unavailable; waiting to roll the same TASK_ID to a fresh chat",
                queue=active,
            )
            return True

        last_click = _parse_iso(active.get("last_retry_click_at"))
        if last_click:
            age = (now - last_click).total_seconds()
            if age < RETRY_BUTTON_COOLDOWN_SECONDS:
                write_runtime(
                    status="retry_wait",
                    last_action=f"Generic Retry for {active['task_id']} cooling down {max(1, int(RETRY_BUTTON_COOLDOWN_SECONDS-age))}s",
                )
                return True
        guard = send_guard_reason(reg, slot, now)
        if guard and not guard.startswith("slot_dedup:"):
            write_runtime(status="retry_wait", last_action=f"Generic Retry for {active['task_id']} waiting for {guard}")
            return True

    if await click_retry_generation(page):
        request_now = datetime.now(TZ)
        note_successful_request(reg, request_now, slot.name)
        active["last_retry_click_at"] = request_now.isoformat()
        active["last_retry_recovery_action"] = "CONTROLLED_RETRY_CLICK"
        if not is_rate:
            active["generic_retry_clicks"] = generic_clicks + 1
        active["sent_at"] = request_now.isoformat()
        active["last_hash"] = None
        active["last_hash_changed_at"] = request_now.isoformat()
        slot.last_sent_at = request_now.isoformat()
        slot.last_assistant_hash = None
        slot.last_assistant_change_at = request_now.isoformat()
        slot.last_result = "queue_retry_clicked"
        save_registry(reg)
        save_queue_state(q)
        write_runtime(
            status="queue_retry_clicked",
            last_action=f"Clicked one controlled {'rate-limit' if is_rate else 'generic'} Retry for {active['task_id']}",
            queue=active,
        )
        return True

    write_runtime(status="retry_wait", last_action=f"Retry visible for {active['task_id']} but controlled click unavailable")
    return True



async def queue_send_same_chat_control_message(
    context: BrowserContext,
    pages: dict[str, Page],
    active: dict,
    prompt: str,
    *,
    status: str,
    result_label: str,
) -> bool:
    """Send controller-owned protocol/control traffic without opening a new chat.

    Control traffic obeys the same send spacing, dedup and rate-limit guards.
    Active generation and unverified High thinking also defer it.
    """
    now = datetime.now(TZ)
    reg = load_registry(now)
    slot = next((s for s in reg.slots if s.name == active["slot"]), None)
    if slot is None:
        return False
    guard = same_task_control_send_guard_reason(reg, slot, now)
    if guard:
        write_runtime(
            status=f"{status}_wait",
            last_action=f"{active['task_id']} control message waiting for {guard}",
            queue=active,
        )
        return False

    page = await slot_page(context, pages, slot)
    if await detect_busy(page):
        return False

    thinking_ok = await ensure_thinking_level(page)
    if thinking_ok:
        track_thinking_verification(reg, slot, True, result_label)
    elif STRICT_THINKING_LEVEL:
        track_thinking_verification(reg, slot, False, result_label)
        return False

    result = await send_message(page, prompt)
    if result != "sent":
        write_runtime(
            status=f"{status}_send_failed",
            last_action=f"{active['task_id']} control message send failed: {result}",
            queue=active,
        )
        return False

    sent_at = datetime.now(TZ)
    note_successful_request(reg, sent_at, slot.name)
    active["sent_at"] = sent_at.isoformat()
    active["last_hash"] = None
    active["last_hash_changed_at"] = sent_at.isoformat()
    slot.last_sent_at = sent_at.isoformat()
    slot.last_assistant_hash = None
    slot.last_assistant_change_at = sent_at.isoformat()
    slot.last_result = result_label
    save_registry(reg)
    write_runtime(
        status=status,
        last_action=f"{active['task_id']} {result_label}",
        queue=active,
    )
    return True


async def queue_send_github_recovery(context: BrowserContext, pages: dict[str, Page], active: dict) -> bool:
    now = datetime.now(TZ)

    wait_until = _parse_iso(active.get("github_tooling_retry_until"))
    if wait_until and now < wait_until:
        remaining = max(1, int((wait_until - now).total_seconds()))
        write_runtime(
            status="github_tooling_circuit_wait",
            last_action=f"{active['task_id']} GitHub recovery paused in same chat for {remaining}s",
            queue=active,
        )
        return True
    if wait_until and now >= wait_until:
        active.pop("github_tooling_retry_until", None)
        active["github_recovery_prompts"] = 0

    count = int(active.get("github_recovery_prompts", 0) or 0)
    if count >= GITHUB_ASSISTANT_RECOVERY_MAX:
        wait_until = now + timedelta(seconds=GITHUB_TOOLING_RETRY_COOLDOWN_SECONDS)
        active["github_tooling_retry_until"] = wait_until.isoformat()
        write_runtime(
            status="github_tooling_circuit_wait",
            last_action=f"{active['task_id']} GitHub recovery reached {count} handoffs; same chat/task preserved for cooldown",
            queue=active,
        )
        return True

    latest_head = github_branch_head(active["branch"])
    if not latest_head:
        if github_transient_retry_pending():
            write_runtime(
                status="github_retry_wait",
                last_action=f"{active['task_id']}: controller GitHub preflight is temporarily retrying; task/attempt preserved",
                queue=active,
            )
        return False

    prompt = (
        f"TASK_ID={active['task_id']} BRANCH={active['branch']} HEAD={latest_head}\n"
        "컨트롤러 read 성공은 채팅 도구 연결 증거가 아니다. 같은 TASK_ID의 미완료 작업을 계속해.\n"
        + native_plugin_instructions(active)
    )
    sent = await queue_send_same_chat_control_message(
        context,
        pages,
        active,
        prompt,
        status="github_recovery_sent",
        result_label="github_recovery_sent",
    )
    if sent:
        active["github_recovery_prompts"] = count + 1
        active["last_github_recovery_at"] = datetime.now(TZ).isoformat()
        active["github_recovery_parent_head_sha"] = latest_head
    return sent


def _is_localization_producer(active: dict) -> bool:
    lane = str(active.get("lane") or "")
    slot = str(active.get("slot") or "")
    return CONTROLLER_MODE == "localization" and (
        slot in {"A", "B", "D"}
        or lane in {"LOCALIZATION_A", "LOCALIZATION_B", "LOCALIZATION_E"}
    )


def _is_latched_execution_task(active: dict) -> bool:
    """Queue tasks whose assistant/UI turn must not be treated as task completion."""
    if CONTROLLER_MODE == "conversion":
        return True
    if CONTROLLER_MODE == "localization":
        lane = str(active.get("lane") or "")
        slot = str(active.get("slot") or "")
        return slot in {"A", "B", "C", "D"} or lane.startswith("LOCALIZATION_")
    return False


async def queue_send_producer_execution_continuation(
    context: BrowserContext,
    pages: dict[str, Page],
    active: dict,
    response_hash: str,
) -> bool:
    """Keep a producer TASK latched through premature assistant turn termination."""
    now = datetime.now(TZ)
    active["task_latched"] = True
    active["controller_stage"] = "WAIT_MATERIAL_COMMIT"

    # Count at most once for the controller request that produced this assistant turn.
    # send_message/control traffic updates active["sent_at"], making the next turn a
    # new countable observation even if the model repeats identical prose.
    turn_key = str(active.get("sent_at") or active.get("dispatch_started_at") or "")
    if active.get("premature_stop_counted_for_send_at") != turn_key:
        active["premature_stop_count"] = int(active.get("premature_stop_count", 0) or 0) + 1
        active["premature_stop_total"] = int(active.get("premature_stop_total", 0) or 0) + 1
        active["premature_stop_counted_for_send_at"] = turn_key
        active["last_premature_stop_at"] = now.isoformat()
        active["last_premature_response_hash"] = response_hash

    latest_head = github_branch_head(active["branch"])
    if not latest_head:
        return False

    active["last_checkpoint_head"] = latest_head
    active["last_checkpoint_at"] = now.isoformat()
    active["last_checkpoint_stage"] = "WAIT_MATERIAL_COMMIT"

    strikes = int(active.get("premature_stop_count", 0) or 0)
    if strikes >= PREMATURE_STOP_ROLLOVER_THRESHOLD:
        reason = (
            f"PREMATURE_STOP:{strikes} consecutive assistant turns ended without a durable material result; "
            "same TASK_ID must continue from the persistent controller checkpoint in a fresh chat."
        )
        active["failure_context"] = reason
        active["assistant_claim_verification"] = "PREMATURE_STOP_ROLLOVER_REQUIRED"
        rolled = await queue_rollover_chat(context, pages, active, reason)
        if rolled:
            active["premature_stop_count"] = 0
            active["producer_continuation_response_hash"] = None
            active["producer_continuation_sent_at"] = None
            active["controller_stage"] = "WAIT_MATERIAL_COMMIT"
            active["assistant_claim_verification"] = "PREMATURE_STOP_ROLLOVER_SENT"
            return True
        # A send/rate-limit guard may defer rollover. Keep the task active and
        # retry later; never convert this recoverable state to terminal failure.
        active["phase"] = "WAIT_CHAT"
        active["terminal"] = None
        write_runtime(
            status="producer_rollover_wait",
            last_action=f"{active['task_id']} remains ACTIVE; premature-stop rollover deferred",
            queue=active,
        )
        return True

    if active.get("producer_continuation_response_hash") == response_hash:
        last = _parse_iso(active.get("producer_continuation_sent_at"))
        if last and (now - last).total_seconds() < PRODUCER_CONTINUATION_COOLDOWN_SECONDS:
            write_runtime(
                status="producer_execution_wait",
                last_action=f"{active['task_id']} remains ACTIVE waiting for material execution / durable Git result",
                queue=active,
            )
            return True

    prompt = (
        f"TASK_ID={active['task_id']} BRANCH={active['branch']} HEAD={latest_head}\n"
        f"ACTIVE_TASK_LATCH=ON PREMATURE_STOP={strikes}/{PREMATURE_STOP_ROLLOVER_THRESHOLD} "
        "CONTROLLER_STAGE=WAIT_MATERIAL_COMMIT. "
        "INTERMEDIATE_STATUS_NOT_TERMINAL. 상태 재구성/HEAD 확인/후보 스캔/계획은 이미 끝난 중간 단계로 취급해. "
        "RESULT_SHA=NOT_CREATED/미커밋 상태로 응답을 끝내지 마. 사용자 확인을 기다리지 말고 지금 도구 호출부터 시작해서 "
        "실제 material 작업(DDS 생성/재작업)→검증→새 [AUTO:TASK_ID] durable commit까지 같은 TASK_ID에서 계속해. "
        "현재 asset이 dependency-blocked면 같은 shard의 다음 독립 runnable asset으로 즉시 전환해. "
        "'다음 단계'를 설명하지 말고 도구 호출과 실제 변경부터 수행해."
    )
    sent = await queue_send_same_chat_control_message(
        context,
        pages,
        active,
        prompt,
        status="producer_execution_continuation",
        result_label="producer_execution_continuation",
    )
    if sent:
        active["producer_continuation_response_hash"] = response_hash
        active["producer_continuation_sent_at"] = now.isoformat()
        active["assistant_claim_verification"] = "INTERMEDIATE_STATUS_REJECTED_TASK_STILL_ACTIVE"
    return sent


async def queue_send_conversion_execution_continuation(
    context: BrowserContext,
    pages: dict[str, Page],
    active: dict,
    response_hash: str,
) -> bool:
    """Keep conversion TASK active when a stable assistant turn ends without a task commit."""
    now = datetime.now(TZ)
    active["task_latched"] = True
    active["controller_stage"] = "WAIT_DURABLE_RESULT"

    turn_key = str(active.get("sent_at") or active.get("dispatch_started_at") or "")
    if active.get("premature_stop_counted_for_send_at") != turn_key:
        active["premature_stop_count"] = int(active.get("premature_stop_count", 0) or 0) + 1
        active["premature_stop_total"] = int(active.get("premature_stop_total", 0) or 0) + 1
        active["premature_stop_counted_for_send_at"] = turn_key
        active["last_premature_stop_at"] = now.isoformat()
        active["last_premature_response_hash"] = response_hash

    latest_head = github_branch_head(active["branch"])
    if not latest_head:
        return False

    active["last_checkpoint_head"] = latest_head
    active["last_checkpoint_at"] = now.isoformat()
    active["last_checkpoint_stage"] = "WAIT_DURABLE_RESULT"

    strikes = int(active.get("premature_stop_count", 0) or 0)
    if strikes >= PREMATURE_STOP_ROLLOVER_THRESHOLD:
        reason = (
            f"PREMATURE_STOP:{strikes} consecutive conversion turns ended without a durable TASK commit; "
            "same TASK_ID must continue from checkpoint in a fresh chat."
        )
        active["failure_context"] = reason
        active["assistant_claim_verification"] = "PREMATURE_STOP_ROLLOVER_REQUIRED"
        rolled = await queue_rollover_chat(context, pages, active, reason)
        if rolled:
            active["premature_stop_count"] = 0
            active["conversion_continuation_response_hash"] = None
            active["conversion_continuation_sent_at"] = None
            active["controller_stage"] = "WAIT_DURABLE_RESULT"
            active["assistant_claim_verification"] = "PREMATURE_STOP_ROLLOVER_SENT"
            return True
        active["phase"] = "WAIT_CHAT"
        active["terminal"] = None
        write_runtime(
            status="conversion_rollover_wait",
            last_action=f"{active['task_id']} remains ACTIVE; conversion rollover deferred",
            queue=active,
        )
        return True

    if active.get("conversion_continuation_response_hash") == response_hash:
        last = _parse_iso(active.get("conversion_continuation_sent_at"))
        if last and (now - last).total_seconds() < PRODUCER_CONTINUATION_COOLDOWN_SECONDS:
            write_runtime(
                status="conversion_execution_wait",
                last_action=f"{active['task_id']} remains ACTIVE waiting for durable repository progress",
                queue=active,
            )
            return True

    prompt = (
        f"TASK_ID={active['task_id']} BRANCH={active['branch']} HEAD={latest_head}\n"
        f"GITHUB_ONLY_DEVELOPMENT=true ACTIVE_TASK_LATCH=ON PREMATURE_STOP={strikes}/{PREMATURE_STOP_ROLLOVER_THRESHOLD} "
        "CONTROLLER_STAGE=WAIT_DURABLE_RESULT. "
        "HEAD/AGENTS/상태복구/리뷰/계획은 중간 단계다. 로컬 개발 PC, RenderDoc, OpenXR runtime 부재는 "
        "source/static/disassembly/GitHub Actions 작업의 blocker가 아니다. 설치 Skill은 직접 도움이 될 때만 사용하고 "
        "없거나 부적합하면 기존 GitHub-only 방식으로 계속해. 지금 실제 지정 작업(소스 수정 또는 bounded evidence 갱신), "
        "검증, 새 [AUTO:TASK_ID] durable commit까지 진행해. RESULT_SHA=NOT_CREATED/다음 단계 설명만으로 종료하지 마."
    )
    sent = await queue_send_same_chat_control_message(
        context,
        pages,
        active,
        prompt,
        status="conversion_execution_continuation",
        result_label="conversion_execution_continuation",
    )
    if sent:
        active["conversion_continuation_response_hash"] = response_hash
        active["conversion_continuation_sent_at"] = now.isoformat()
        active["assistant_claim_verification"] = "INTERMEDIATE_STATUS_REJECTED_TASK_STILL_ACTIVE"
    return sent


async def queue_handle_native_response(
    context: BrowserContext,
    pages: dict[str, Page],
    active: dict,
    text: str,
) -> bool:
    """Own every idle, stable no-commit response; prose is not execution evidence."""
    if not text:
        return False
    now = datetime.now(TZ)
    h = stable_hash(text)

    # Localization producers must never stop after a plan/status-only response.
    # This path is reached only when no authoritative TASK_ID commit was found.
    if _is_localization_producer(active):
        active["native_last_response_hash"] = h
        active["assistant_claim_verification"] = "UNVERIFIED_NO_TASK_COMMIT"
        handled = await queue_send_producer_execution_continuation(
            context, pages, active, h
        )
        if handled:
            return True

    # Conversion workers use the same task-liveness rule. Review/status text is
    # not a terminal result when the requested durable TASK commit does not exist.
    if CONTROLLER_MODE == "conversion":
        active["native_last_response_hash"] = h
        active["assistant_claim_verification"] = "UNVERIFIED_NO_TASK_COMMIT"
        handled = await queue_send_conversion_execution_continuation(
            context, pages, active, h
        )
        if handled:
            return True

    last = _parse_iso(active.get("native_recovery_observed_at"))
    if active.get("native_recovery_response_hash") == h and last:
        if (now - last).total_seconds() < GITHUB_TOOLING_RETRY_COOLDOWN_SECONDS:
            write_runtime(status="native_result_wait", last_action=f"{active['task_id']} waiting for plugin work / durable Git result", queue=active)
            return True
    active["assistant_claim_verification"] = "UNVERIFIED_NO_TASK_COMMIT"
    active["native_last_response_hash"] = h
    handled = await queue_send_github_recovery(context, pages, active)
    if handled:
        active["native_recovery_response_hash"] = h
        active["native_recovery_observed_at"] = now.isoformat()
    # Deferred sends must not fall through into failure, attempt increment or rollover.
    return True


async def queue_send_retry(context: BrowserContext, pages: dict[str, Page], active: dict, reason: str) -> bool:
    now = datetime.now(TZ)
    reg = load_registry(now)
    slot = next((s for s in reg.slots if s.name == active["slot"]), None)
    if slot is None:
        return False

    guard = send_guard_reason(reg, slot, now)
    if guard:
        write_runtime(status="queue_retry_wait", last_action=f"{active['task_id']} repair send waiting for {guard}")
        return False

    page = await slot_page(context, pages, slot)
    retry_fresh_chat = False
    if await detect_busy(page):
        busy_since = _parse_iso(active.get("last_hash_changed_at")) or _parse_iso(active.get("sent_at")) or now
        busy_age = (now - busy_since).total_seconds()
        if busy_age < WATCHDOG_BUSY_STALL_MINUTES * 60:
            write_runtime(status="queue_retry_wait", last_action=f"{active['task_id']} repair send waiting for active generation ({int(busy_age)}s)")
            return False
        retry_fresh_chat = True
    if await first_visible(page, RETRY_SELECTORS, total_wait_ms=500) is not None:
        retry_fresh_chat = True
    if retry_fresh_chat:
        old_url = slot.url or page.url
        if old_url:
            history = active.setdefault("previous_chat_urls", [])
            if old_url not in history:
                history.append(old_url)
                active["previous_chat_urls"] = history[-10:]
        page = await replace_with_fresh_slot_page(context, pages, slot)
        save_registry(reg)
        write_runtime(
            status="queue_retry_fresh_chat",
            last_action=f"{active['task_id']} repair moved to a fresh project chat because the previous UI was stale/busy",
            queue=active,
        )

    latest_head = github_branch_head(active["branch"])
    if not latest_head:
        write_runtime(status="queue_github_unavailable", last_action=f"{active['task_id']} retry could not refresh latest branch HEAD")
        return False
    previous_base = active.get("base_sha")
    active["base_sha"] = latest_head
    active["retry_parent_head_sha"] = latest_head

    runtime["queue_base_sha"] = latest_head
    runtime["queue_task_id"] = active["task_id"]
    runtime["queue_lane"] = active["lane"]
    runtime["queue_branch"] = active["branch"]
    runtime["queue_attempt"] = active["attempt"]
    runtime["queue_wave_id"] = active.get("wave_id")
    runtime["queue_failure_context"] = reason
    runtime["queue_qa_batch"] = active.get("qa_batch") or []

    try:
        prompt = prompt_for_slot(slot, "repair")
    except Exception as e:
        if CONTROLLER_MODE == "localization":
            active["base_sha"] = previous_base
            write_runtime(
                status="policy_refresh_wait",
                last_action=f"{active['task_id']}: retry policy refresh failed; retrying later without changing attempt state",
                last_error=repr(e),
            )
            return False
        raise
    thinking_ok = await ensure_thinking_level(page)
    if thinking_ok:
        track_thinking_verification(reg, slot, True, "queue_retry")
    elif STRICT_THINKING_LEVEL:
        track_thinking_verification(reg, slot, False, "queue_retry")
        active["base_sha"] = previous_base
        return False
    result = await send_message(page, prompt)
    if result != "sent":
        active["base_sha"] = previous_base
        write_runtime(status="queue_retry_send_failed", last_action=f"{active['task_id']} retry send failed: {result}")
        return False

    now = datetime.now(TZ)
    if retry_fresh_chat or not slot.url:
        new_url = await wait_for_chat_url(page, timeout_sec=8)
        if new_url:
            slot.url = new_url
            active["active_chat_url"] = new_url
    note_successful_request(reg, now, slot.name)
    active["sent_at"] = now.isoformat()
    active["dispatch_confirmed"] = True
    active["last_hash"] = None
    active["last_hash_changed_at"] = now.isoformat()
    active["result_sha"] = None
    active["phase"] = "WAIT_CHAT"
    active["last_gate_poll_at"] = None
    active.pop("wait_actions_started_at", None)
    active.pop("missing_gate_run_detected_at", None)
    active.pop("missing_gate_run_reason", None)
    active["last_gate_status"] = None
    active["last_gate_status_changed_at"] = None
    active["last_jobs_refresh_at"] = None
    active.pop("gate_run", None)
    active.pop("gate_jobs", None)
    active["failure_context"] = reason
    slot.last_sent_at = now.isoformat()
    slot.last_assistant_hash = None
    slot.last_assistant_change_at = now.isoformat()
    slot.last_result = "queue_retry_sent"
    save_registry(reg)
    return True


async def recover_missing_gate_run(
    context: BrowserContext,
    pages: dict[str, Page],
    active: dict,
    now: datetime,
) -> Optional[tuple[str, str]]:
    """Turn a missing required Actions run into a bounded repair instead of an infinite wait."""
    result_sha = str(active.get("result_sha") or "").strip()
    message = str(active.get("result_message") or "")
    if not message and result_sha:
        message = github_commit_message(result_sha) or ""
        if message:
            active["result_message"] = message

    directive = github_actions_skip_directive(message)
    wait_started = (
        _parse_iso(active.get("wait_actions_started_at"))
        or _parse_iso(active.get("task_commit_rebound_at"))
        or _parse_iso(active.get("last_hash_changed_at"))
        or _parse_iso(active.get("sent_at"))
        or now
    )
    active.setdefault("wait_actions_started_at", wait_started.isoformat())
    age_seconds = max(0, int((now - wait_started).total_seconds()))

    if not directive and age_seconds < WAIT_ACTIONS_NO_RUN_TIMEOUT_SECONDS:
        return None

    if directive:
        reason = (
            f"Result commit {result_sha} contains GitHub Actions skip directive {directive!r}; "
            f"required workflow {active['workflow']} cannot validate that exact SHA. "
            "Create a follow-up task commit without any CI-skip directive."
        )
    else:
        reason = (
            f"No authoritative {active['workflow']} run was created for result SHA {result_sha} "
            f"after {age_seconds}s (timeout={WAIT_ACTIONS_NO_RUN_TIMEOUT_SECONDS}s). "
            "Treating the missing run as a repairable automation failure instead of waiting forever."
        )

    active["missing_gate_run_detected_at"] = now.isoformat()
    active["missing_gate_run_reason"] = reason
    if active["attempt"] < MAX_TASK_ATTEMPTS:
        previous_attempt = active["attempt"]
        active["attempt"] = previous_attempt + 1
        if await queue_send_retry(context, pages, active, reason):
            return ("retry_sent", reason)
        active["attempt"] = previous_attempt
        active["failure_context"] = reason
        return ("retry_deferred", reason)

    active["failure_context"] = reason
    active["phase"] = "BLOCKED"
    return ("blocked", reason)


async def localization_send_lane_task(
    context: BrowserContext,
    pages: dict[str, Page],
    q: dict,
    slot_name: str,
    wave_id: str,
    qa_batch: Optional[list[dict]] = None,
) -> bool:
    """Send one lane task without changing the other parallel lane."""
    now = datetime.now(TZ)
    reg = load_registry(now)
    slot = next((s for s in reg.slots if s.name == slot_name), None)
    if slot is None:
        return False

    guard = send_guard_reason(reg, slot, now)
    if guard:
        write_runtime(
            status="parallel_dispatch_wait",
            last_action=f"Wave {wave_id} lane {slot_name} waiting for {guard}",
        )
        return False

    target = queue_target_for_slot(slot_name)
    base_sha = github_branch_head(target["branch"])
    if not base_sha:
        if github_transient_retry_pending():
            write_runtime(
                status="github_retry_wait",
                last_action=f"GitHub temporary error for {target['branch']}; queue state preserved and automatic retry continues",
            )
        else:
            write_runtime(status="queue_github_unavailable", last_action=f"Could not read branch {target['branch']}")
        return False

    # Localization refreshes its canonical controller policy before dispatch.
    # Conversion lanes use branch-local AGENTS/CONVERSION_LANE_STATE in the prompt,
    # so no localization policy lookup is applicable there.
    if CONTROLLER_MODE == "localization":
        try:
            localization_controller_contract_fingerprint()
        except GitHubTransientError as e:
            write_runtime(
                status="github_retry_wait",
                last_action=f"Wave {wave_id} lane {slot_name}: GitHub policy lookup retrying automatically; current chat preserved",
                last_error=repr(e),
            )
            return False
        except Exception as e:
            write_runtime(
                status="policy_refresh_wait",
                last_action=f"Wave {wave_id} lane {slot_name}: policy refresh unavailable; current chat preserved",
                last_error=repr(e),
            )
            return False

    if FRESH_CHAT_EACH_RUN:
        # Legacy compatibility only. Normal queue policy now reuses a bounded chat.
        previous_page = await slot_page(context, pages, slot)
        if await detect_busy(previous_page):
            write_runtime(
                status="previous_task_ui_settle_wait",
                last_action=f"Wave {wave_id} lane {slot_name}: previous task still generating; not opening a new chat yet",
            )
            return False
        page = await replace_with_fresh_slot_page(context, pages, slot)
        save_registry(reg)
        write_runtime(
            status="fresh_task_chat_started",
            last_action=f"Wave {wave_id} lane {slot_name}: legacy fresh-per-task policy opened one project chat",
            active_slot=slot.name,
            tab_count=len([p for p in pages.values() if not p.is_closed()]),
        )
    else:
        page = await prepare_reusable_slot_chat(context, pages, reg, slot, f"wave {wave_id}")
        if page is None:
            return False
        if slot.url and not is_project_scoped_chat_url(slot.url):
            slot.url = None
            save_registry(reg)
            page = await replace_with_fresh_slot_page(context, pages, slot)

    if not await ensure_logged_in(page):
        write_runtime(status="login_required", last_action=f"Wave {wave_id} lane {slot_name}: login required")
        return False

    if await first_visible(page, INPUT_SELECTORS, total_wait_ms=1500) is None:
        page = await recover_slot_composer(context, pages, slot, page)
        if await first_visible(page, INPUT_SELECTORS, total_wait_ms=3000) is None:
            write_runtime(status="ui_changed", last_action=f"Wave {wave_id} lane {slot_name}: composer unavailable")
            return False

    # A stale/transient "Too many requests" surface can remain visible while the
    # current turn is still generating successfully. Do not stall the whole
    # localization queue on banner text alone. Only a Retry surface represents
    # an actionable failed generation; handle that through the queue retry path.
    if await detect_rate_limit(page):
        if await first_visible(page, RETRY_SELECTORS, total_wait_ms=300) is not None and not await detect_busy(page):
            mark_rate_limit(reg, datetime.now(TZ), f"parallel-dispatch:{slot_name}")
            return False
        write_runtime(last_action=f"Wave {wave_id} lane {slot_name}: transient rate-limit surface ignored while work remains active")
    if await detect_limit(page):
        write_runtime(status="limit_detected", last_action=f"Wave {wave_id} lane {slot_name}: usage limit detected")
        return False

    task_counter = int(q.get("counter", 0)) + 1
    task_prefix = "CONVERSION" if CONTROLLER_MODE == "conversion" else "LOCALIZATION"
    task_id = f"{task_prefix}-{target['lane']}-{task_counter:05d}"
    runtime["queue_task_id"] = task_id
    runtime["queue_lane"] = target["lane"]
    runtime["queue_branch"] = target["branch"]
    runtime["queue_base_sha"] = base_sha
    runtime["queue_attempt"] = 1
    runtime["queue_wave_id"] = wave_id
    runtime["queue_failure_context"] = ""
    runtime["queue_qa_batch"] = qa_batch or []

    thinking_ok = await ensure_thinking_level(page)
    if thinking_ok:
        track_thinking_verification(reg, slot, True, f"parallel_dispatch:{slot_name}")
    elif STRICT_THINKING_LEVEL:
        track_thinking_verification(reg, slot, False, f"parallel_dispatch:{slot_name}")
        return False

    try:
        prompt = prompt_for_slot(slot, "parallel")
    except FileNotFoundError as e:
        q.setdefault("lane_dispatch_errors", {})[slot_name] = {
            "at": datetime.now(TZ).isoformat(),
            "error": repr(e),
            "task_lane": target["lane"],
        }
        save_queue_state(q)
        write_runtime(
            status="lane_dispatch_config_error",
            last_action=f"Lane {slot_name}/{target['lane']} prompt package missing; other lanes continue",
            last_error=repr(e),
            queue=q,
        )
        return False
    except Exception as e:
        q.setdefault("lane_dispatch_errors", {})[slot_name] = {
            "at": datetime.now(TZ).isoformat(),
            "error": repr(e),
            "task_lane": target["lane"],
            "kind": "policy_refresh_or_prompt_build",
        }
        save_queue_state(q)
        write_runtime(
            status="policy_refresh_wait",
            last_action=f"Lane {slot_name}/{target['lane']} prompt policy refresh failed; deferring this lane while others continue",
            last_error=repr(e),
            queue=q,
        )
        return False
    if q.get("lane_dispatch_errors", {}).pop(slot_name, None) is not None:
        save_queue_state(q)

    # Persist TASK_ID ownership before touching the ChatGPT composer. If the
    # controller/container dies after the browser accepts the prompt but before
    # post-send bookkeeping, restart recovery can still find the exact task and
    # must not reuse this TASK_ID.
    previous_counter = int(q.get("counter", 0))
    dispatch_started_at = datetime.now(TZ)
    provisional = {
        "task_id": task_id,
        "slot": slot_name,
        "lane": target["lane"],
        "branch": target["branch"],
        "workflow": target["workflow"],
        "base_sha": base_sha,
        "result_sha": None,
        "attempt": 1,
        "wave_id": wave_id,
        "chat_rollovers": 0,
        "previous_chat_urls": [],
        "active_chat_url": slot.url,
        "phase": "WAIT_CHAT",
        "terminal": None,
        "sent_at": dispatch_started_at.isoformat(),
        "dispatch_started_at": dispatch_started_at.isoformat(),
        "dispatch_confirmed": False,
        "last_hash": None,
        "last_hash_changed_at": dispatch_started_at.isoformat(),
        "last_gate_poll_at": None,
        "failure_context": "",
        "qa_batch": [dict(item) for item in (qa_batch or [])],
        "native_plugin_protocol_version": NATIVE_PLUGIN_PROTOCOL_VERSION,
        "task_latched": True if CONTROLLER_MODE == "conversion" else slot_name in {"A", "B", "D"},
        "controller_stage": (
            "WAIT_DURABLE_RESULT" if CONTROLLER_MODE == "conversion"
            else ("WAIT_MATERIAL_COMMIT" if slot_name in {"A", "B", "D"} else "WAIT_QA_RESULT")
        ),
        "premature_stop_count": 0,
        "premature_stop_total": 0,
        "premature_stop_counted_for_send_at": None,
        "last_checkpoint_head": base_sha,
        "last_checkpoint_at": dispatch_started_at.isoformat(),
    }
    q["counter"] = task_counter
    q.setdefault("active_by_lane", {})[slot_name] = provisional
    save_queue_state(q)

    result = await send_message(page, prompt)
    if result != "sent":
        current = q.setdefault("active_by_lane", {}).get(slot_name)
        if current and current.get("task_id") == task_id and current.get("dispatch_confirmed") is False:
            q["active_by_lane"].pop(slot_name, None)
            q["counter"] = previous_counter
            save_queue_state(q)
        write_runtime(status="ui_changed", last_action=f"Wave {wave_id} lane {slot_name}: send failed at {result}")
        return False

    sent_at = datetime.now(TZ)
    if not slot.url:
        new_url = await wait_for_chat_url(page, timeout_sec=8)
        if new_url:
            slot.url = new_url

    post_send_rate_limited = False
    if await detect_rate_limit(page):
        if await first_visible(page, RETRY_SELECTORS, total_wait_ms=300) is not None and not await detect_busy(page):
            # send_message already submitted the TASK_ID. Keep an active queue
            # record so the bounded Retry/backoff path owns recovery; never orphan
            # a possibly accepted request or reuse its TASK_ID.
            post_send_rate_limited = True
            mark_rate_limit(reg, sent_at, f"parallel-send:{slot_name}")
        # A transient/stale banner while generation is active is still a sent task.

    note_successful_request(reg, sent_at, slot.name)
    slot.runs += 1
    slot.chat_task_count += 1
    if not slot.chat_started_at:
        slot.chat_started_at = sent_at.isoformat()
    slot.last_task_completed_at = None
    slot.watchdog_resumes_since_schedule = 0
    slot.last_assistant_hash = None
    slot.last_assistant_change_at = sent_at.isoformat()
    slot.last_sent_at = sent_at.isoformat()
    slot.last_result = "parallel_sent_rate_limited" if post_send_rate_limited else "parallel_sent"
    save_registry(reg)

    active_record = q.setdefault("active_by_lane", {}).get(slot_name)
    if not active_record or active_record.get("task_id") != task_id:
        # Defensive reconstruction only; normal flow always has the provisional record.
        active_record = provisional
        q["active_by_lane"][slot_name] = active_record
    active_record["dispatch_confirmed"] = True
    active_record["sent_at"] = sent_at.isoformat()
    active_record["last_hash_changed_at"] = sent_at.isoformat()
    active_record["active_chat_url"] = slot.url
    save_queue_state(q)
    write_runtime(
        status="parallel_wave_running",
        last_action=f"Wave {wave_id}: sent lane {slot_name} as {task_id}",
        queue=q,
    )
    return True


async def localization_safe_send_lane_task(
    context: BrowserContext,
    pages: dict[str, Page],
    q: dict,
    slot_name: str,
    wave_id: str,
    qa_batch: Optional[list[dict]] = None,
) -> bool:
    """Isolate one localization dispatch failure so the other lanes keep progressing."""
    touch_queue_heartbeat()
    now = datetime.now(TZ)
    errors = q.setdefault("lane_dispatch_errors", {})
    previous = errors.get(slot_name) or {}
    retry_after = _parse_iso(previous.get("retry_not_before"))
    if retry_after and now < retry_after:
        return False
    try:
        sent = await localization_send_lane_task(context, pages, q, slot_name, wave_id, qa_batch=qa_batch)
        if sent and errors.pop(slot_name, None) is not None:
            save_queue_state(q)
        return sent
    except Exception as e:
        if isinstance(e, ControllerRestartRequested) or is_browser_transport_failure(e):
            raise
        signature = f"{type(e).__name__}:{e}"
        count = int(previous.get("count", 0)) + 1 if previous.get("signature") == signature else 1
        delay = min(300, 30 * count)
        errors[slot_name] = {
            "at": now.isoformat(),
            "signature": signature,
            "count": count,
            "retry_not_before": (now + timedelta(seconds=delay)).isoformat(),
            "wave_id": wave_id,
        }
        save_queue_state(q)
        log.exception("localization dispatch failed lane=%s wave=%s count=%s", slot_name, wave_id, count)
        write_runtime(
            status="lane_dispatch_error",
            last_action=f"Lane {slot_name} dispatch failed ({count}); retry in {delay}s while other lanes continue",
            last_error=repr(e),
            queue=q,
        )
        return False


async def localization_recover_rejected_producer_commit(
    context: BrowserContext,
    pages: dict[str, Page],
    active: dict,
    task_commit: dict,
    reasons: list[str],
) -> None:
    """Keep the same producer TASK alive when a durable no-work result fails the global completion guard."""
    result_sha = str(task_commit.get("sha") or "")
    same_rejection = active.get("producer_no_work_rejected_sha") == result_sha
    active["producer_no_work_rejected_sha"] = result_sha
    active["producer_no_work_guard_reasons"] = reasons
    active["assistant_claim_verification"] = "REJECTED_NO_WORK_COMPLETION"
    active["phase"] = "WAIT_CHAT"
    active["terminal"] = None
    active["task_latched"] = True
    active["controller_stage"] = "WAIT_MATERIAL_COMMIT"
    active["result_sha"] = None
    active["automation_validation"] = "PENDING"
    invalidate_task_commit_cache(active["branch"], active["task_id"])

    if same_rejection and active.get("producer_no_work_recovery_sent_at"):
        write_runtime(
            status="producer_no_work_guard_wait",
            last_action=f"{active['task_id']} rejected no-work result {result_sha[:12]}; waiting for material follow-up commit",
            queue=active,
        )
        return

    reason_text = "; ".join(reasons[:12])
    prompt = (
        f"TASK_ID={active['task_id']} RESULT_SHA={result_sha}\n"
        "NO_WORK_GUARD_REJECTED: 이 커밋은 producer 완료로 인정되지 않는다. "
        f"현재 미완료 근거={reason_text}.\n"
        "같은 TASK_ID로 실제 미완료 작업을 계속하고 material deliverable과 새 [AUTO:TASK_ID] 커밋을 남겨. "
        "TASK 결과 파일 없음/신규 TASK 결과 없음/'커밋할 변경 없음'은 종료 사유가 아니다. "
        "NO_WORK/NO_ACTION/review-only는 전체 completion guard가 모두 clear일 때만 허용된다."
    )
    sent = await queue_send_same_chat_control_message(
        context,
        pages,
        active,
        prompt,
        status="producer_no_work_guard_recovery",
        result_label="producer_no_work_guard_recovery",
    )
    if sent:
        active["producer_no_work_recovery_sent_at"] = datetime.now(TZ).isoformat()


async def localization_handle_producer_commit(
    context: BrowserContext,
    pages: dict[str, Page],
    q: dict,
    active: dict,
    task_commit: dict,
    now: datetime,
) -> bool:
    """Validate producer task evidence before release. False means same TASK remains active."""
    valid, reasons, _record = localization_validate_producer_result_commit(
        active["task_id"], task_commit["sha"]
    )
    if not valid:
        await localization_recover_rejected_producer_commit(
            context, pages, active, task_commit, reasons
        )
        return False
    for key in (
        "producer_no_work_rejected_sha",
        "producer_no_work_guard_reasons",
        "producer_no_work_recovery_sent_at",
    ):
        active.pop(key, None)
    finalize_localization_producer_commit(q, active, task_commit, now)
    return True


def finalize_localization_producer_commit(q: dict, active: dict, task_commit: dict, now: datetime) -> None:
    """Release A/B/E on durable commit; validation is deferred to the C batch gate."""
    active["result_sha"] = task_commit["sha"]
    active["result_message"] = task_commit.get("message")
    active["automation_validation"] = "PENDING"
    active["validation_mode"] = "C_BATCH_GATE"
    active["batch_validation_pending"] = True
    active["runtime_validation"] = "UNTESTED"
    active["completed_at"] = now.isoformat()
    active["terminal"] = "PRODUCED"
    active["phase"] = "DONE"
    active["task_latched"] = False
    active["controller_stage"] = "DONE"
    active["last_material_progress_at"] = now.isoformat()
    active["last_checkpoint_head"] = task_commit["sha"]
    active["last_checkpoint_at"] = now.isoformat()
    for key in (
        "gate_run",
        "last_gate_poll_at",
        "last_gate_status",
        "last_gate_status_changed_at",
        "gate_jobs",
        "last_jobs_refresh_at",
        "startup_reconcile_pending",
    ):
        active.pop(key, None)
    q["completed"] = (q.get("completed", []) + [dict(active)])[-100:]


def localization_reconcile_producer_commit_without_ui(
    q: dict,
    active: dict,
    task_commit: dict,
    now: datetime,
    source: str,
) -> bool:
    """Apply the producer NO_WORK guard during startup/watchdog reconciliation."""
    valid, reasons, _record = localization_validate_producer_result_commit(
        str(active.get("task_id") or ""), str(task_commit.get("sha") or "")
    )
    if valid:
        finalize_localization_producer_commit(q, active, task_commit, now)
        return True

    active["phase"] = "WAIT_CHAT"
    active["terminal"] = None
    active["result_sha"] = None
    active["automation_validation"] = "PENDING"
    active["producer_no_work_rejected_sha"] = task_commit.get("sha")
    active["producer_no_work_guard_reasons"] = reasons
    active["assistant_claim_verification"] = "REJECTED_NO_WORK_COMPLETION"
    active["task_latched"] = True
    active["controller_stage"] = "WAIT_MATERIAL_COMMIT"
    active["failure_context"] = f"NO_WORK_GUARD_REARMED_{source}"
    active.pop("completed_at", None)
    active.pop("batch_validation_pending", None)
    active.pop("wait_actions_started_at", None)
    active.pop("startup_reconcile_pending", None)
    invalidate_task_commit_cache(
        str(active.get("branch") or ""), str(active.get("task_id") or "")
    )
    return False


async def localization_process_lane(
    context: BrowserContext,
    pages: dict[str, Page],
    q: dict,
    lane_key: str,
) -> None:
    active = q.get("active_by_lane", {}).get(lane_key)
    if not active or active.get("phase") == "DONE":
        return

    now = datetime.now(TZ)
    reg = load_registry(now)
    slot = next((s for s in reg.slots if s.name == active["slot"]), None)
    if slot is None:
        active["failure_context"] = "slot_missing"
        active["phase"] = "BLOCKED"
    else:
        page = await slot_page(context, pages, slot)

        if active["phase"] == "WAIT_CHAT":
            # Durable Git always outranks transient UI state. A stale Retry/busy
            # surface must never cause duplicate work after the task already committed.
            task_commit = github_find_task_commit(
                active["branch"],
                active["task_id"],
                allow_ci_skip_fallback=CONTROLLER_MODE == "localization" and lane_key in {"A", "B", "D"},
            )
            if task_commit:
                if CONTROLLER_MODE == "localization" and lane_key in {"A", "B", "D"}:
                    accepted = await localization_handle_producer_commit(
                        context, pages, q, active, task_commit, now
                    )
                    save_queue_state(q)
                    if accepted:
                        write_runtime(
                            status="producer_commit_ready",
                            last_action=f"{active['task_id']} durable material commit accepted; producer released",
                            queue=q,
                        )
                else:
                    active["result_sha"] = task_commit["sha"]
                    active["result_message"] = task_commit["message"]
                    active["phase"] = "WAIT_ACTIONS"
                    active["wait_actions_started_at"] = now.isoformat()
                    active["last_gate_poll_at"] = None
                    save_queue_state(q)
                    write_runtime(
                        status="qa_wait_actions",
                        last_action=f"{active['task_id']} durable C commit found before UI recovery; Gate pending",
                        queue=q,
                    )
                return

            if CONTROLLER_MODE == "conversion" or lane_key == "C":
                skipped_commit = github_find_task_commit(
                    active["branch"], active["task_id"], allow_ci_skip_fallback=True
                )
                if skipped_commit and skipped_commit.get("ci_skip_directive"):
                    active["result_sha"] = skipped_commit["sha"]
                    active["result_message"] = skipped_commit["message"]
                    active["phase"] = "WAIT_ACTIONS"
                    active["wait_actions_started_at"] = now.isoformat()
                    active["last_gate_poll_at"] = None
                    recovery = await recover_missing_gate_run(context, pages, active, now)
                    save_queue_state(q)
                    if recovery:
                        action, reason = recovery
                        write_runtime(
                            status="qa_missing_gate_recovery",
                            last_action=f"{active['task_id']} {action}: {reason}",
                            queue=active,
                        )
                    return

            if github_transient_retry_pending():
                write_runtime(
                    status="github_retry_wait",
                    last_action=f"{active['task_id']}: GitHub temporary error; holding current chat/task and retrying GitHub automatically",
                    queue=active,
                )
                return

            if active.get("dispatch_confirmed") is False:
                dispatch_started = _parse_iso(active.get("dispatch_started_at")) or _parse_iso(active.get("sent_at")) or now
                dispatch_age = (now - dispatch_started).total_seconds()
                if dispatch_age < QUEUE_RESULT_GRACE_SECONDS:
                    write_runtime(
                        status="dispatch_uncertain_wait",
                        last_action=f"{active['task_id']} provisional dispatch is {int(dispatch_age)}s old; checking Git before any resend",
                        queue=active,
                    )
                    return
                reason = (
                    "Controller restarted or failed during ChatGPT dispatch before post-send confirmation; "
                    "no durable task commit appeared within the grace period. Re-send the same TASK_ID in a fresh chat."
                )
                active["failure_context"] = reason
                if await queue_rollover_chat(context, pages, active, reason):
                    save_queue_state(q)
                elif active.get("phase") == "BLOCKED":
                    save_queue_state(q)
                return

            if (not slot.url or not is_project_scoped_chat_url(slot.url)) and is_project_scoped_chat_url(page.url):
                slot.url = page.url
                active["active_chat_url"] = page.url
                save_registry(reg)
                save_queue_state(q)

            if await queue_handle_retry_surface(context, pages, page, reg, slot, active, q):
                return

            if not slot.url or not is_project_scoped_chat_url(slot.url):
                reason = "Active lane chat URL is missing or outside the configured project."
                if await queue_rollover_chat(context, pages, active, reason):
                    save_queue_state(q)
                return

            if await detect_conversation_limit(page):
                reason = "ChatGPT reported that the current conversation reached its length limit."
                if await queue_rollover_chat(context, pages, active, reason):
                    save_queue_state(q)
                return

            if await detect_busy(page):
                busy_since = _parse_iso(active.get("last_hash_changed_at")) or _parse_iso(active.get("sent_at")) or now
                busy_age = (now - busy_since).total_seconds()
                if busy_age < WATCHDOG_BUSY_STALL_MINUTES * 60:
                    return
                reason = (
                    f"ChatGPT remained busy without durable Git progress for {int(busy_age)}s; "
                    "rolling the same task to a fresh chat instead of waiting indefinitely."
                )
                active["failure_context"] = reason
                if await queue_rollover_chat(context, pages, active, reason):
                    save_queue_state(q)
                elif active.get("phase") == "BLOCKED":
                    save_queue_state(q)
                return

            # A task commit is authoritative even if the UI failed to expose the final assistant message.
            task_commit = github_find_task_commit(active["branch"], active["task_id"])
            text = await current_assistant_text(page)
            if not text:
                if task_commit:
                    if CONTROLLER_MODE == "localization" and lane_key in {"A", "B", "D"}:
                        await localization_handle_producer_commit(
                            context, pages, q, active, task_commit, now
                        )
                    else:
                        active["result_sha"] = task_commit["sha"]
                        active["result_message"] = task_commit["message"]
                        active["phase"] = "WAIT_ACTIONS"
                        active["last_gate_poll_at"] = None
                    save_queue_state(q)
                    return
                sent_at = _parse_iso(active.get("sent_at")) or now
                if (now - sent_at).total_seconds() < QUEUE_RESULT_GRACE_SECONDS:
                    return
                reason = "No assistant response or durable task commit was detected before the queue result grace period expired."
                if await queue_rollover_chat(context, pages, active, reason):
                    save_queue_state(q)
                return

            clear_rate_limit_after_response(reg)
            active["last_retry_backoff_at"] = None
            active["last_retry_click_at"] = None
            active["generic_retry_clicks"] = 0
            h = stable_hash(text)
            changed_at = _parse_iso(active.get("last_hash_changed_at")) or now
            if h != active.get("last_hash"):
                active["last_hash"] = h
                active["last_hash_changed_at"] = now.isoformat()
                save_queue_state(q)
                return
            if (now - changed_at).total_seconds() < QUEUE_STABLE_SECONDS:
                return

            task_commit = task_commit or github_find_task_commit(active["branch"], active["task_id"])
            if task_commit:
                if CONTROLLER_MODE == "localization" and lane_key in {"A", "B", "D"}:
                    accepted = await localization_handle_producer_commit(
                        context, pages, q, active, task_commit, now
                    )
                    save_queue_state(q)
                    if accepted:
                        write_runtime(
                            status="producer_commit_ready",
                            last_action=f"{active['task_id']} -> {active['result_sha']} queued for C batch validation; producer released",
                            queue=q,
                        )
                else:
                    active["result_sha"] = task_commit["sha"]
                    active["result_message"] = task_commit["message"]
                    active["phase"] = "WAIT_ACTIONS"
                    active["wait_actions_started_at"] = now.isoformat()
                    active["last_gate_poll_at"] = None
                    if github_actions_skip_directive(active["result_message"]):
                        recovery = await recover_missing_gate_run(context, pages, active, now)
                        save_queue_state(q)
                        if recovery:
                            action, reason = recovery
                            write_runtime(
                                status="qa_missing_gate_recovery",
                                last_action=f"{active['task_id']} {action}: {reason}",
                                queue=active,
                            )
                        return
                    save_queue_state(q)
                    write_runtime(
                        status="qa_wait_actions",
                        last_action=f"{active['task_id']} -> {active['result_sha']} C batch Gate pending",
                        queue=q,
                    )
                return

            await queue_handle_native_response(context, pages, active, text)
            save_queue_state(q)
            return

        if active["phase"] == "WAIT_ACTIONS":
            if CONTROLLER_MODE == "localization" and lane_key in {"A", "B", "D"}:
                task_commit = github_find_task_commit(active["branch"], active["task_id"])
                if task_commit:
                    active["phase"] = "WAIT_CHAT"
                    accepted = await localization_handle_producer_commit(
                        context, pages, q, active, task_commit, now
                    )
                    save_queue_state(q)
                    if accepted:
                        write_runtime(
                            status="producer_wait_actions_migrated",
                            last_action=f"{active['task_id']} migrated from legacy WAIT_ACTIONS to C batch validation",
                            queue=q,
                        )
                return
            # C alone waits for the batched GitHub Actions Gate. Persisted C state
            # may still point at an older failed attempt, so rebind by TASK_ID.
            rebound = refresh_wait_actions_task_binding(
                active,
                force_refresh=bool(active.get("startup_reconcile_pending")),
            )
            if rebound:
                save_queue_state(q)
                write_runtime(
                    status="task_commit_rebound",
                    last_action=f"Rebound stale WAIT_ACTIONS task commit {rebound}",
                    queue=q,
                )
            bound_run_id = (active.get("gate_run") or {}).get("id")
            poll_seconds = GITHUB_BOUND_RUN_POLL_SECONDS if bound_run_id else GITHUB_POLL_SECONDS
            last_poll = _parse_iso(active.get("last_gate_poll_at"))
            if last_poll and (now - last_poll).total_seconds() < poll_seconds:
                return
            active["last_gate_poll_at"] = now.isoformat()
            run = github_gate_run(
                active["branch"],
                active["result_sha"],
                active["workflow"],
                run_id=bound_run_id,
                force_discovery=not bool(bound_run_id),
            )
            save_queue_state(q)
            if run is None:
                if github_transient_retry_pending():
                    write_runtime(
                        status="github_retry_wait",
                        last_action=f"{active['task_id']}: GitHub temporary error; C Gate lookup will retry automatically without changing this task",
                        queue=active,
                    )
                    return
                recovery = await recover_missing_gate_run(context, pages, active, now)
                if recovery:
                    action, reason = recovery
                    save_queue_state(q)
                    write_runtime(
                        status="parallel_missing_gate_recovery",
                        last_action=f"{active['task_id']} {action}: {reason}",
                        queue=active,
                    )
                    return
                save_queue_state(q)
                write_runtime(
                    status="parallel_validation_pending",
                    last_action=f"No authoritative {active['workflow']} run yet for {active['task_id']} SHA {active['result_sha']}",
                    queue=q,
                )
                return

            active["gate_run"] = run
            status_key = f"{run.get('status')}:{run.get('conclusion')}"
            if status_key != active.get("last_gate_status"):
                active["last_gate_status"] = status_key
                active["last_gate_status_changed_at"] = now.isoformat()

            if run["status"] != "completed":
                wait_started = (
                    _parse_iso(active.get("wait_actions_started_at"))
                    or _parse_iso(active.get("task_commit_rebound_at"))
                    or _parse_iso(active.get("sent_at"))
                    or now
                )
                active.setdefault("wait_actions_started_at", wait_started.isoformat())
                wait_age = (now - wait_started).total_seconds()
                if wait_age >= WAIT_ACTIONS_MAX_SECONDS:
                    reason = (
                        f"{active['workflow']} exact run {run.get('id')} remained {run.get('status')} "
                        f"for {int(wait_age)}s (max={WAIT_ACTIONS_MAX_SECONDS}s); bounded recovery required."
                    )
                    if active["attempt"] < MAX_TASK_ATTEMPTS:
                        previous_attempt = active["attempt"]
                        active["attempt"] = previous_attempt + 1
                        if await queue_send_retry(context, pages, active, reason):
                            save_queue_state(q)
                        else:
                            active["attempt"] = previous_attempt
                            active["failure_context"] = reason
                            save_queue_state(q)
                        return
                    active["failure_context"] = reason
                    active["phase"] = "BLOCKED"
                    save_queue_state(q)
                    return
                changed_at = _parse_iso(active.get("last_gate_status_changed_at")) or now
                last_jobs = _parse_iso(active.get("last_jobs_refresh_at"))
                if (
                    (now - changed_at).total_seconds() >= WAIT_ACTIONS_STALE_SECONDS
                    and (not last_jobs or (now - last_jobs).total_seconds() >= WAIT_ACTIONS_STALE_SECONDS)
                ):
                    active["gate_jobs"] = github_action_jobs_summary(run["id"])
                    active["last_jobs_refresh_at"] = now.isoformat()
                save_queue_state(q)
                write_runtime(
                    status="parallel_validation_running",
                    last_action=f"{active['workflow']} exact run {run['id']} is {run['status']}",
                    queue=q,
                )
                return

            if run.get("conclusion") == "success":
                active["automation_validation"] = "PASS"
                active["runtime_validation"] = "UNTESTED"
                active["completed_at"] = now.isoformat()
                active["terminal"] = "PASS"
                active["phase"] = "DONE"
                active["task_latched"] = False
                active["controller_stage"] = "DONE"
                q["completed"] = (q.get("completed", []) + [dict(active)])[-100:]
                save_queue_state(q)
                return

            active["gate_jobs"] = github_action_jobs_summary(run["id"])
            reason = f"{active['workflow']} exact run {run.get('id')} concluded {run.get('conclusion')}; inspect {run.get('html_url')}"
            if active["attempt"] < MAX_TASK_ATTEMPTS:
                previous_attempt = active["attempt"]
                active["attempt"] = previous_attempt + 1
                if await queue_send_retry(context, pages, active, reason):
                    save_queue_state(q)
                else:
                    active["attempt"] = previous_attempt
                    save_queue_state(q)
                return
            active["failure_context"] = reason
            active["phase"] = "BLOCKED"

    if active.get("phase") == "BLOCKED":
        active["automation_validation"] = "FAIL"
        active["runtime_validation"] = "UNTESTED"
        active["blocked_at"] = now.isoformat()
        active["terminal"] = "BLOCKED"
        active["phase"] = "DONE"
        active["task_latched"] = False
        active["controller_stage"] = "BLOCKED"
        q["blocked"] = (q.get("blocked", []) + [dict(active)])[-100:]
        save_queue_state(q)


async def localization_process_lane_isolated(
    context: BrowserContext,
    pages: dict[str, Page],
    q: dict,
    lane_key: str,
) -> None:
    """Keep one broken localization lane from stopping the other three workers."""
    touch_queue_heartbeat()
    active = q.get("active_by_lane", {}).get(lane_key)
    if not active:
        return
    try:
        await localization_process_lane(context, pages, q, lane_key)
        changed = False
        for key in ("lane_exception_signature", "lane_exception_count", "lane_exception_at"):
            if active.pop(key, None) is not None:
                changed = True
        if changed:
            save_queue_state(q)
        return
    except Exception as e:
        if isinstance(e, ControllerRestartRequested) or is_browser_transport_failure(e):
            raise
        now = datetime.now(TZ)
        log.exception("localization active lane failed lane=%s task=%s", lane_key, active.get("task_id"))

        commit = github_find_task_commit(
            str(active.get("branch") or ""),
            str(active.get("task_id") or ""),
            allow_ci_skip_fallback=CONTROLLER_MODE == "localization" and lane_key in {"A", "B", "D"},
        )
        if commit:
            if CONTROLLER_MODE == "localization" and lane_key in {"A", "B", "D"}:
                accepted = await localization_handle_producer_commit(
                    context, pages, q, active, commit, now
                )
                if not accepted:
                    save_queue_state(q)
                    return
            else:
                active["result_sha"] = commit["sha"]
                active["result_message"] = commit.get("message")
                active["phase"] = "WAIT_ACTIONS"
                active["wait_actions_started_at"] = now.isoformat()
                active["last_gate_poll_at"] = None
            save_queue_state(q)
            write_runtime(
                status="lane_exception_commit_recovered",
                last_action=f"{active.get('task_id')} durable commit recovered after lane exception",
                last_error=repr(e),
                queue=q,
            )
            return

        signature = f"{type(e).__name__}:{e}"
        previous_signature = active.get("lane_exception_signature")
        count = int(active.get("lane_exception_count", 0)) + 1 if previous_signature == signature else 1
        active["lane_exception_signature"] = signature
        active["lane_exception_count"] = count
        active["lane_exception_at"] = now.isoformat()
        if count >= QUEUE_ERROR_RESTART_THRESHOLD:
            reason = f"Lane-local controller failure repeated {count} times: {signature}"
            if _is_latched_execution_task(active) and active.get("task_latched", True):
                # Preserve the producer TASK_ID/checkpoint and restart the controller
                # process instead of converting a recoverable orchestration failure
                # into a terminal task result. Docker restart policy resumes from /data.
                active["failure_context"] = reason
                active["automation_validation"] = "PENDING"
                active["runtime_validation"] = "UNTESTED"
                active["terminal"] = None
                active["phase"] = "WAIT_CHAT"
                active["task_latched"] = True
                active["controller_stage"] = (
                    "WAIT_MATERIAL_COMMIT" if CONTROLLER_MODE == "localization"
                    else "WAIT_DURABLE_RESULT"
                )
                active["controller_restart_recovery_count"] = int(active.get("controller_restart_recovery_count", 0) or 0) + 1
                active["last_checkpoint_at"] = now.isoformat()
                save_queue_state(q)
                write_runtime(
                    status="lane_exception_restart",
                    last_action=f"{active.get('task_id')} remains ACTIVE; restarting controller after {count} repeated lane-local failures",
                    last_error=repr(e),
                    queue=q,
                )
                raise ControllerRestartRequested(reason)
            active["failure_context"] = reason
            active["automation_validation"] = "FAIL"
            active["runtime_validation"] = "UNTESTED"
            active["blocked_at"] = now.isoformat()
            active["terminal"] = "BLOCKED"
            active["phase"] = "DONE"
            q["blocked"] = (q.get("blocked", []) + [dict(active)])[-100:]
            status = "lane_exception_blocked"
            action = f"{active.get('task_id')} blocked after {count} lane-local controller failures; other lanes continue"
        else:
            status = "lane_exception"
            action = f"{active.get('task_id')} lane-local failure {count}/{QUEUE_ERROR_RESTART_THRESHOLD}; other lanes continue"
        save_queue_state(q)
        write_runtime(status=status, last_action=action, last_error=repr(e), queue=q)


def _qa_item_key(item: dict) -> str:
    return f"{item.get('task_id','')}@{item.get('result_sha','')}"


def _qa_completed_input_keys(q: dict) -> set[str]:
    keys: set[str] = set()
    for record in q.get("qa_completed", []):
        keys.update(record.get("input_keys", []))
    # qa_blocked is diagnostic only: those inputs were never validated and must
    # remain eligible for a later C batch.
    return keys


def _qa_retry_delay_seconds(retry_count: int) -> int:
    return min(1800, 300 * (2 ** min(max(retry_count - 1, 0), 3)))


def _qa_item_ready(item: dict, now: datetime) -> bool:
    retry_at = _parse_iso(item.get("qa_retry_not_before"))
    return retry_at is None or now >= retry_at


def select_ready_qa_batch(q: dict, now: datetime) -> list[dict]:
    return [item for item in q.get("qa_pending", []) if _qa_item_ready(item, now)][:LOCALIZATION_QA_BATCH_SIZE]


def next_qa_retry_wait_seconds(q: dict, now: datetime) -> Optional[int]:
    waits = []
    for item in q.get("qa_pending", []):
        retry_at = _parse_iso(item.get("qa_retry_not_before"))
        if retry_at and retry_at > now:
            waits.append((retry_at - now).total_seconds())
    return max(1, int(min(waits))) if waits else None


def reconcile_blocked_qa_inputs(q: dict) -> int:
    """Restore legacy C-blocked inputs that older controller versions consumed."""
    completed = _qa_completed_input_keys(q)
    pending = q.setdefault("qa_pending", [])
    pending_keys = {_qa_item_key(x) for x in pending}
    restored = 0
    now = datetime.now(TZ)
    for record in q.get("qa_blocked", []):
        for source in record.get("inputs", []) or []:
            key = _qa_item_key(source)
            if not source.get("task_id") or not source.get("result_sha"):
                continue
            if key in completed or key in pending_keys:
                continue
            item = dict(source)
            item["qa_retry_count"] = max(1, int(item.get("qa_retry_count", 0) or 0))
            item["qa_retry_not_before"] = (now + timedelta(seconds=_qa_retry_delay_seconds(item["qa_retry_count"]))).isoformat()
            item["last_qa_blocked_task_id"] = record.get("qa_task_id")
            item["last_qa_blocked_at"] = record.get("completed_at") or now.isoformat()
            pending.append(item)
            pending_keys.add(key)
            restored += 1
    if restored:
        q["qa_blocked_requeued_count"] = int(q.get("qa_blocked_requeued_count", 0)) + restored
        q["qa_blocked_requeued_at"] = now.isoformat()
    return restored


def enqueue_producer_result_for_qa(q: dict, task: dict) -> bool:
    if task.get("terminal") not in {"PRODUCED", "PASS"} or not task.get("result_sha"):
        return False
    item = {
        "task_id": task.get("task_id"),
        "lane": task.get("lane"),
        "result_sha": task.get("result_sha"),
        "result_message": task.get("result_message"),
        "completed_at": task.get("completed_at"),
        "producer_id": task.get("wave_id"),
        "automation_validation": task.get("automation_validation", "PENDING"),
        "validation_mode": task.get("validation_mode", "C_BATCH_GATE"),
    }
    key = _qa_item_key(item)
    pending_keys = {_qa_item_key(x) for x in q.get("qa_pending", [])}
    if key in pending_keys or key in _qa_completed_input_keys(q):
        return False
    q.setdefault("qa_pending", []).append(item)
    # Never truncate unconsumed QA work. Git is the durable SSOT, but dropping an
    # in-memory pending key here could permanently skip C validation during a long backlog.
    return True


def finalize_c_qa_batch(q: dict, task: dict) -> None:
    batch = task.get("qa_batch") or []
    input_keys = [_qa_item_key(x) for x in batch]
    record = {
        "qa_task_id": task.get("task_id"),
        "qa_result_sha": task.get("result_sha"),
        "terminal": task.get("terminal"),
        "completed_at": task.get("completed_at") or task.get("blocked_at"),
        "input_keys": input_keys,
        "inputs": batch,
    }
    if task.get("terminal") == "PASS":
        q["qa_completed"] = (q.get("qa_completed", []) + [record])[-100:]
        input_key_set = set(input_keys)
        for producer in q.get("completed", []):
            if _qa_item_key(producer) in input_key_set:
                producer["automation_validation"] = "PASS"
                producer["batch_validation_pending"] = False
                producer["validated_by_qa_task_id"] = task.get("task_id")
                producer["validated_by_qa_result_sha"] = task.get("result_sha")
        consumed = set(input_keys)
        q["qa_pending"] = [x for x in q.get("qa_pending", []) if _qa_item_key(x) not in consumed]
    else:
        # C infrastructure/controller/Gate failure is diagnostic, not validation.
        # Keep every immutable TASK_ID@RESULT_SHA input pending, but rotate the
        # failed inputs behind other QA work and apply bounded exponential backoff.
        q["qa_blocked"] = (q.get("qa_blocked", []) + [record])[-100:]
        blocked_keys = set(input_keys)
        untouched = []
        deferred = []
        retry_now = datetime.now(TZ)
        for item in q.get("qa_pending", []):
            if _qa_item_key(item) not in blocked_keys:
                untouched.append(item)
                continue
            updated = dict(item)
            retry_count = int(updated.get("qa_retry_count", 0) or 0) + 1
            retry_delay = _qa_retry_delay_seconds(retry_count)
            updated["qa_retry_count"] = retry_count
            updated["qa_retry_not_before"] = (retry_now + timedelta(seconds=retry_delay)).isoformat()
            updated["last_qa_blocked_task_id"] = task.get("task_id")
            updated["last_qa_blocked_at"] = retry_now.isoformat()
            deferred.append(updated)
        q["qa_pending"] = untouched + deferred


async def queue_upgrade_native_context(
    context: BrowserContext,
    pages: dict[str, Page],
    q: dict,
    active: dict,
) -> bool:
    if not active or active.get("phase") != "WAIT_CHAT":
        return False
    if active.get("native_plugin_protocol_version") == NATIVE_PLUGIN_PROTOCOL_VERSION:
        return False
    commit = github_find_task_commit(
        active["branch"], active["task_id"],
        allow_ci_skip_fallback=CONTROLLER_MODE == "localization" and active.get("slot") in {"A", "B", "D"},
    )
    if commit:
        # Let the normal exact-SHA/producer path reconcile it without another prompt.
        active["native_plugin_protocol_version"] = NATIVE_PLUGIN_PROTOCOL_VERSION
        save_queue_state(q)
        return False
    if github_transient_retry_pending():
        return False
    prompt = (
        f"[작업 방식 변경] TASK_ID={active['task_id']} TARGET_BRANCH={active['branch']}\n"
        "이전 브로커 태그 지침은 폐기한다. 연결된 플러그인으로 직접 작업을 재개해. "
        "기존 TASK_ID/진행 기록을 유지하고 이미 저장된 작업은 반복하지 마.\n"
        + native_plugin_instructions(active)
    )
    sent = await queue_send_same_chat_control_message(
        context, pages, active, prompt,
        status="native_plugin_migrated", result_label="native_plugin_migrated",
    )
    if sent:
        if active.get("broker_pending_file"):
            active["legacy_broker_pending_file"] = active["broker_pending_file"]
        for key in list(active):
            if key.startswith("broker_"):
                active.pop(key, None)
        active["native_plugin_protocol_version"] = NATIVE_PLUGIN_PROTOCOL_VERSION
        active["github_recovery_prompts"] = 0
        active.pop("generic_retry_cooldown_until", None)
        active.pop("github_tooling_retry_until", None)
        active["failure_context"] = ""
        save_queue_state(q)
    return sent


async def localization_parallel_cycle(context: BrowserContext, pages: dict[str, Page]):
    """Run A/B/E as continuous producers and C as an independent batched QA consumer."""
    now = datetime.now(TZ)
    q = load_queue_state()
    restored_blocked = reconcile_blocked_qa_inputs(q)
    if restored_blocked:
        save_queue_state(q)
        write_runtime(
            qa_blocked_requeued_last=restored_blocked,
            last_action=f"Restored {restored_blocked} legacy C-blocked QA input(s) to qa_pending",
        )
    reg = load_registry(now)
    active_by_lane = q.setdefault("active_by_lane", {})

    # Migrate one idle chat per cycle; a busy/deferred lane must not starve others.
    for task in sorted(active_by_lane.values(), key=lambda x: x.get("sent_at") or ""):
        if await queue_upgrade_native_context(context, pages, q, task):
            return

    # One-time migration from the old single-active localization queue.
    legacy = q.get("active")
    if legacy and not active_by_lane:
        legacy_slot = legacy.get("slot")
        if legacy_slot in {"A", "B", "C"}:
            legacy.setdefault("terminal", None)
            active_by_lane[legacy_slot] = legacy
            q["active"] = None
            save_queue_state(q)

    chat_backoff = rate_limit_active(reg, now)
    if chat_backoff:
        write_runtime(
            status="rate_limited_backoff",
            last_action=f"ChatGPT send backoff active ({rate_limit_seconds_remaining(reg, now)}s); Git/Actions reconciliation continues",
            queue=q,
        )

    # Fill an actually missing worker before active Retry traffic can refresh the
    # global send timestamp again. This prevents a Retry-heavy active lane from
    # starving D->E or a ready C batch forever.
    pending_count = len(q.get("qa_pending", []))
    # C QA backlog is consumer-only state. It must never pause A/B/E producer dispatch.
    e_throttled = False
    q["e_backlog_throttled"] = False
    q["e_backlog_pending_count"] = pending_count

    priority_lane = None
    priority_batch = None
    pending = q.get("qa_pending", [])
    if "C" not in active_by_lane and pending:
        batch = select_ready_qa_batch(q, now)
        if batch:
            oldest = _parse_iso(batch[0].get("completed_at")) or now
            age = (now - oldest).total_seconds()
            if len(batch) >= LOCALIZATION_QA_BATCH_SIZE or age >= LOCALIZATION_QA_COALESCE_SECONDS:
                priority_lane = "C"
                priority_batch = batch

    if priority_lane is None:
        slot_by_name = {slot.name: slot for slot in reg.slots}
        missing_producers = [
            lane for lane in ("A", "B", "D")
            if lane not in active_by_lane
        ]
        missing_producers.sort(key=lambda lane: (slot_by_name.get(lane).last_sent_at if slot_by_name.get(lane) else "") or "")
        if missing_producers:
            priority_lane = missing_producers[0]

    if priority_lane is not None and not chat_backoff:
        priority_slot = next((slot for slot in reg.slots if slot.name == priority_lane), None)
        guard = send_guard_reason(reg, priority_slot, now) if priority_slot else "slot_missing"
        if guard:
            q["dispatch_fairness_wait_lane"] = priority_lane
            q["dispatch_fairness_wait_reason"] = guard
            save_queue_state(q)
            write_runtime(
                status="priority_dispatch_wait",
                last_action=f"Priority lane {priority_lane} waiting for {guard}; preserving send gap before active Retry traffic",
                queue=q,
            )
            return
        dispatch_id = (
            f"Q{int(q.get('qa_batch_counter', 0)) + 1:05d}"
            if priority_lane == "C"
            else f"P{int(q.get('producer_counter', 0)) + 1:05d}"
        )
        if await localization_safe_send_lane_task(context, pages, q, priority_lane, dispatch_id, qa_batch=priority_batch):
            if priority_lane == "C":
                q["qa_batch_counter"] = int(q.get("qa_batch_counter", 0)) + 1
            else:
                q["producer_counter"] = int(q.get("producer_counter", 0)) + 1
            q["dispatch_fairness_last_lane"] = priority_lane
            q["dispatch_fairness_last_at"] = datetime.now(TZ).isoformat()
            q.pop("dispatch_fairness_wait_lane", None)
            q.pop("dispatch_fairness_wait_reason", None)
            save_queue_state(q)
            write_runtime(
                status="priority_dispatch_sent",
                last_action=f"Filled priority lane {priority_lane} before servicing active Retry traffic",
                queue=q,
            )
            return

    # Advance active lanes oldest-send first. Retry/rollover actions consume the
    # shared ChatGPT send gap, so fixed A->B->C->D ordering can starve D/E forever
    # when earlier lanes keep presenting Retry. The oldest effective send wins the
    # next recovery opportunity, which naturally rotates fairness after a click.
    def _active_lane_send_epoch(lane_key: str) -> float:
        task = active_by_lane.get(lane_key) or {}
        stamp = (
            _parse_iso(task.get("last_retry_click_at"))
            or _parse_iso(task.get("last_rollover_at"))
            or _parse_iso(task.get("sent_at"))
        )
        return stamp.timestamp() if stamp else 0.0

    active_lane_order = sorted(
        [lane for lane in ("A", "B", "C", "D") if lane in active_by_lane],
        key=_active_lane_send_epoch,
    )
    q["active_lane_recovery_order"] = active_lane_order
    for lane_key in active_lane_order:
        await localization_process_lane_isolated(context, pages, q, lane_key)

    active_by_lane = q.setdefault("active_by_lane", {})

    # Retire completed producers immediately and enqueue immutable task/result SHAs for C.
    # Mark the slot completion timestamp before another task may reuse the same chat.
    producer_retired = []
    registry_changed = False
    for lane_key in ("A", "B", "D"):
        task = active_by_lane.get(lane_key)
        if task and task.get("phase") == "DONE":
            if enqueue_producer_result_for_qa(q, task):
                producer_retired.append(f"{task.get('task_id')}->{task.get('result_sha')}")
            completed_slot = next((s for s in reg.slots if s.name == lane_key), None)
            if completed_slot is not None:
                completed_slot.last_task_completed_at = now.isoformat()
                registry_changed = True
            active_by_lane.pop(lane_key, None)

    # Retire one finished C batch without touching producer slots.
    ctask = active_by_lane.get("C")
    if ctask and ctask.get("phase") == "DONE":
        finalize_c_qa_batch(q, ctask)
        completed_slot = next((s for s in reg.slots if s.name == "C"), None)
        if completed_slot is not None:
            completed_slot.last_task_completed_at = now.isoformat()
            registry_changed = True
        active_by_lane.pop("C", None)

    if registry_changed:
        save_registry(reg)
    if producer_retired or (ctask and ctask.get("phase") == "DONE"):
        save_queue_state(q)

    # Keep A/B/E producers fed independently from the C QA backlog.
    pending_count = len(q.get("qa_pending", []))
    # C QA backlog is consumer-only state. It must never pause A/B/E producer dispatch.
    e_throttled = False
    q["e_backlog_throttled"] = False
    q["e_backlog_pending_count"] = pending_count
    save_queue_state(q)

    # No producer/C barrier exists.
    for lane_key in ("A", "B", "D"):
        active_by_lane = q.setdefault("active_by_lane", {})
        if lane_key in active_by_lane:
            continue
        producer_id = f"P{int(q.get('producer_counter', 0)) + 1:05d}"
        if await localization_safe_send_lane_task(context, pages, q, lane_key, producer_id):
            q["producer_counter"] = int(q.get("producer_counter", 0)) + 1
            save_queue_state(q)

    # C consumes immutable producer results in batches. Waiting briefly for coalescing
    # reduces repeated source/header/atlas/shared-state work without pausing production.
    active_by_lane = q.setdefault("active_by_lane", {})
    pending = q.get("qa_pending", [])
    if "C" not in active_by_lane and pending:
        batch = select_ready_qa_batch(q, now)
        if not batch:
            wait_sec = next_qa_retry_wait_seconds(q, now)
            write_runtime(
                status="qa_batch_retry_backoff",
                last_action=f"C QA pending={len(pending)} but all eligible inputs are in retry backoff for about {wait_sec or 0}s",
                queue=q,
            )
            return
        oldest = _parse_iso(batch[0].get("completed_at")) or now
        age = (now - oldest).total_seconds()
        if len(batch) < LOCALIZATION_QA_BATCH_SIZE and age < LOCALIZATION_QA_COALESCE_SECONDS:
            write_runtime(
                status="qa_batch_coalescing",
                last_action=f"C QA collecting ready batch: {len(batch)}/{LOCALIZATION_QA_BATCH_SIZE}, oldest {int(age)}s",
                queue=q,
            )
            return
        qa_id = f"Q{int(q.get('qa_batch_counter', 0)) + 1:05d}"
        if await localization_safe_send_lane_task(context, pages, q, "C", qa_id, qa_batch=batch):
            q["qa_batch_counter"] = int(q.get("qa_batch_counter", 0)) + 1
            save_queue_state(q)
            write_runtime(
                status="qa_batch_running",
                last_action=f"{qa_id}: C reviewing {len(batch)} ready producer results while A/B/E continue",
                queue=q,
            )
            return

    active_by_lane = q.setdefault("active_by_lane", {})
    write_runtime(
        status="continuous_production_qa_running",
        last_action=(
            f"A/B/E continuous producers; C QA pending={len(q.get('qa_pending', []))} "
            f"active={','.join(sorted(active_by_lane.keys())) or 'none'}"
        ),
        queue=q,
    )

def reconcile_legacy_conversion_blocked(q: dict) -> bool:
    """Move historical UI-detection false failures to completed when exact task SHA gate already passed."""
    if CONTROLLER_MODE != "conversion":
        return False
    # v2 retries the earlier reconciliation because v1 could mark itself complete
    # even after GitHub REST rate limiting interrupted the scan.
    if int(q.get("conversion_blocked_reconcile_version", 0)) >= 2:
        return False

    original = list(q.get("blocked", []))
    kept = []
    recovered = []
    lookup_failed = False

    for idx, record in enumerate(original):
        task_id = record.get("task_id")
        branch = record.get("branch")
        workflow = record.get("workflow") or "Backend Conversion Gate"
        if not task_id or not branch:
            kept.append(record)
            continue

        commit = github_find_task_commit(branch, task_id)
        if commit is None:
            kept.append(record)
            if _github_blocked_seconds() > 0:
                lookup_failed = True
                kept.extend(original[idx + 1:])
                break
            continue

        run = github_gate_run(branch, commit["sha"], workflow)
        if run is None:
            kept.append(record)
            if _github_blocked_seconds() > 0:
                lookup_failed = True
                kept.extend(original[idx + 1:])
                break
            continue

        if run.get("status") == "completed" and run.get("conclusion") == "success":
            fixed = dict(record)
            fixed["result_sha"] = commit["sha"]
            fixed["result_message"] = commit["message"]
            fixed["gate_run"] = run
            fixed["automation_validation"] = "PASS"
            fixed["runtime_validation"] = record.get("runtime_validation") or "UNTESTED"
            fixed["recovered_from_false_blocked"] = True
            fixed["recovered_at"] = datetime.now(TZ).isoformat()
            fixed["original_failure_context"] = record.get("failure_context")
            fixed["failure_context"] = ""
            recovered.append(fixed)
        else:
            kept.append(record)

    q["blocked"] = kept
    if recovered:
        existing_ids = {r.get("task_id") for r in q.get("completed", [])}
        q["completed"] = (
            q.get("completed", []) + [r for r in recovered if r.get("task_id") not in existing_ids]
        )[-100:]

    q["last_blocked_reconcile_at"] = datetime.now(TZ).isoformat()
    q["last_blocked_recovered_count"] = len(recovered)

    if lookup_failed:
        # Do not seal reconciliation while REST is rate-limited; retry automatically later.
        q["conversion_blocked_reconcile_version"] = 1
        save_queue_state(q)
        write_runtime(
            status="queue_history_reconcile_paused",
            last_action=f"Recovered {len(recovered)} historical tasks; reconciliation paused by GitHub REST rate limit",
            recovered_tasks=[r["task_id"] for r in recovered],
        )
        return bool(recovered)

    q["conversion_blocked_reconcile_version"] = 2
    save_queue_state(q)
    if recovered:
        write_runtime(
            status="queue_history_reconciled",
            last_action=f"Recovered {len(recovered)} historical conversion tasks that had durable PASS commits/gates",
            recovered_tasks=[r["task_id"] for r in recovered],
        )
    return bool(recovered)


async def conversion_parallel_cycle(context: BrowserContext, pages: dict[str, Page]):
    """Run DX11/A and DXVK/B independently so one lane cannot starve the other."""
    now = datetime.now(TZ)
    q = load_queue_state()
    reconcile_legacy_conversion_blocked(q)
    q = load_queue_state()
    reg = load_registry(now)
    active_by_lane = q.setdefault("active_by_lane", {})

    # One-time migration from the old single-active conversion queue. Preserve
    # the exact TASK_ID/attempt/chat/checkpoint rather than redispatching it.
    legacy = q.get("active")
    if legacy:
        legacy_slot = str(legacy.get("slot") or "")
        if legacy_slot in {"A", "B"} and legacy_slot not in active_by_lane:
            legacy["task_latched"] = True
            legacy.setdefault("premature_stop_count", 0)
            legacy.setdefault("premature_stop_total", 0)
            legacy["controller_stage"] = (
                "WAIT_ACTIONS" if legacy.get("phase") == "WAIT_ACTIONS"
                else legacy.get("controller_stage") or "WAIT_DURABLE_RESULT"
            )
            active_by_lane[legacy_slot] = legacy
            q["active"] = None
            q["conversion_parallel_migrated_at"] = now.isoformat()
            save_queue_state(q)

    # Upgrade older prompt protocol without letting one lane starve the other.
    for task in sorted(active_by_lane.values(), key=lambda x: x.get("sent_at") or ""):
        if await queue_upgrade_native_context(context, pages, q, task):
            return

    chat_backoff = rate_limit_active(reg, now)
    if chat_backoff:
        write_runtime(
            status="rate_limited_backoff",
            last_action=(
                f"ChatGPT send backoff active ({rate_limit_seconds_remaining(reg, now)}s); "
                "DX11/DXVK Git/Actions reconciliation continues independently"
            ),
            queue=q,
        )

    # Advance both active lanes oldest-send first. WAIT_ACTIONS polling does not
    # consume the ChatGPT send gap, while Retry/rollover remains serialized.
    def _send_epoch(lane_key: str) -> float:
        task = active_by_lane.get(lane_key) or {}
        stamp = (
            _parse_iso(task.get("last_retry_click_at"))
            or _parse_iso(task.get("last_rollover_at"))
            or _parse_iso(task.get("sent_at"))
        )
        return stamp.timestamp() if stamp else 0.0

    for lane_key in sorted([x for x in ("A", "B") if x in active_by_lane], key=_send_epoch):
        await localization_process_lane_isolated(context, pages, q, lane_key)

    active_by_lane = q.setdefault("active_by_lane", {})
    registry_changed = False
    retired = []
    for lane_key in ("A", "B"):
        task = active_by_lane.get(lane_key)
        if task and task.get("phase") == "DONE":
            slot = next((s for s in reg.slots if s.name == lane_key), None)
            if slot is not None:
                slot.last_task_completed_at = now.isoformat()
                registry_changed = True
            retired.append(f"{task.get('task_id')}:{task.get('terminal')}")
            active_by_lane.pop(lane_key, None)
    if registry_changed:
        save_registry(reg)
    if retired:
        save_queue_state(q)

    # Fill missing backends independently. The normal global send gap means at
    # most one fresh ChatGPT dispatch usually occurs per cycle; the other lane
    # is picked up automatically on a later cycle instead of waiting for the
    # first lane's task/Gate to finish.
    if not chat_backoff:
        slot_by_name = {s.name: s for s in reg.slots}
        missing = [lane for lane in ("A", "B") if lane not in active_by_lane]
        missing.sort(key=lambda lane: (slot_by_name.get(lane).last_sent_at if slot_by_name.get(lane) else "") or "")
        for lane_key in missing:
            dispatch_id = f"V{int(q.get('conversion_parallel_counter', 0)) + 1:05d}"
            if await localization_safe_send_lane_task(
                context, pages, q, lane_key, dispatch_id, qa_batch=None
            ):
                q["conversion_parallel_counter"] = int(q.get("conversion_parallel_counter", 0)) + 1
                q["conversion_parallel_last_lane"] = lane_key
                q["conversion_parallel_last_at"] = datetime.now(TZ).isoformat()
                save_queue_state(q)
                break

    active_by_lane = q.setdefault("active_by_lane", {})
    lane_summary = []
    for lane_key in ("A", "B"):
        task = active_by_lane.get(lane_key)
        if task:
            lane_summary.append(
                f"{lane_key}:{task.get('lane')}:{task.get('phase')}:{task.get('task_id')}"
            )
        else:
            lane_summary.append(f"{lane_key}:idle")
    write_runtime(
        status="conversion_parallel_running",
        last_action="DX11/DXVK independent lanes; " + " | ".join(lane_summary),
        queue=q,
    )


async def queue_cycle(context: BrowserContext, pages: dict[str, Page]):
    now = datetime.now(TZ)
    q = load_queue_state()
    reg = load_registry(now)
    if CONTROLLER_MODE == "conversion":
        reconcile_legacy_conversion_blocked(q)
        q = load_queue_state()
    active = q.get("active")

    if active and await queue_upgrade_native_context(context, pages, q, active):
        return

    if rate_limit_active(reg, now) and not active:
        write_runtime(
            status="rate_limited_backoff",
            last_action=f"No active task; new ChatGPT send paused for adaptive backoff ({rate_limit_seconds_remaining(reg, now)}s remaining)",
            rate_limit_attempts=reg.rate_limit_attempts,
            rate_limit_until=reg.rate_limit_until,
        )
        return
    if rate_limit_active(reg, now) and active:
        write_runtime(
            status="rate_limited_backoff",
            last_action=f"ChatGPT send backoff active ({rate_limit_seconds_remaining(reg, now)}s); Git/Actions reconciliation continues for {active.get('task_id')}",
            rate_limit_attempts=reg.rate_limit_attempts,
            rate_limit_until=reg.rate_limit_until,
        )

    if not active:
        not_before = _parse_iso(q.get("next_task_not_before"))
        if not_before and now < not_before:
            remaining = max(1, int((not_before - now).total_seconds()))
            write_runtime(
                status="queue_next_task_cooldown",
                last_action=f"Previous task finished; waiting {remaining}s before starting the next ChatGPT request",
            )
            return
        slot = reg.slots[reg.next_slot]
        target = queue_target_for_slot(slot.name)
        base_sha = github_branch_head(target["branch"])
        if not base_sha:
            if github_transient_retry_pending():
                write_runtime(
                    status="github_retry_wait",
                    last_action=f"GitHub temporary error for {target['branch']}; no TASK attempt consumed, automatic retry continues",
                )
            else:
                write_runtime(status="queue_github_unavailable", last_action=f"Could not read branch {target['branch']}")
            return
        previous_counter = int(q.get("counter", 0))
        q["counter"] = previous_counter + 1
        task_id = f"{CONTROLLER_MODE.upper()}-{target['lane']}-{q['counter']:05d}"
        runtime["queue_task_id"] = task_id
        runtime["queue_lane"] = target["lane"]
        runtime["queue_branch"] = target["branch"]
        runtime["queue_base_sha"] = base_sha
        runtime["queue_attempt"] = 1
        runtime["queue_failure_context"] = ""
        slot_name = slot.name
        dispatch_started_at = datetime.now(TZ)
        q["active"] = {
            "task_id": task_id,
            "slot": slot_name,
            "lane": target["lane"],
            "branch": target["branch"],
            "workflow": target["workflow"],
            "base_sha": base_sha,
            "result_sha": None,
            "attempt": 1,
            "chat_rollovers": 0,
            "previous_chat_urls": [],
            "active_chat_url": slot.url,
            "phase": "WAIT_CHAT",
            "sent_at": dispatch_started_at.isoformat(),
            "dispatch_started_at": dispatch_started_at.isoformat(),
            "dispatch_confirmed": False,
            "last_hash": None,
            "last_hash_changed_at": dispatch_started_at.isoformat(),
            "last_gate_poll_at": None,
            "failure_context": "",
            "native_plugin_protocol_version": NATIVE_PLUGIN_PROTOCOL_VERSION,
            "task_latched": True,
            "controller_stage": "WAIT_DURABLE_RESULT",
            "premature_stop_count": 0,
            "premature_stop_total": 0,
            "premature_stop_counted_for_send_at": None,
            "last_checkpoint_head": base_sha,
            "last_checkpoint_at": dispatch_started_at.isoformat(),
        }
        save_queue_state(q)
        write_runtime(
            status="queue_dispatching",
            last_action=f"Reserved {task_id} before ChatGPT send; awaiting explicit send confirmation",
            queue=q["active"],
        )
        await run_cycle(context, pages)
        if runtime.get("status") != "sent":
            current = q.get("active")
            if current and current.get("task_id") == task_id and current.get("dispatch_confirmed") is False:
                q["active"] = None
                q["counter"] = previous_counter
                save_queue_state(q)
            return

        # run_cycle owns the registry and may have rotated to a fresh chat. Reload
        # it before confirming the provisional record so URL/send-time are exact.
        confirmed_reg = load_registry(datetime.now(TZ))
        confirmed_slot = next((s for s in confirmed_reg.slots if s.name == slot_name), None)
        confirmed_at = _parse_iso(confirmed_slot.last_sent_at) if confirmed_slot else None
        confirmed_at = confirmed_at or datetime.now(TZ)
        current = q.get("active")
        if not current or current.get("task_id") != task_id:
            raise RuntimeError(f"provisional queue identity lost after dispatch: {task_id}")
        current["dispatch_confirmed"] = True
        current["sent_at"] = confirmed_at.isoformat()
        current["last_hash_changed_at"] = confirmed_at.isoformat()
        current["active_chat_url"] = confirmed_slot.url if confirmed_slot else current.get("active_chat_url")
        save_queue_state(q)
        write_runtime(status="queue_wait_chat", last_action=f"Sent {task_id}", queue=current)
        return

    slot = next((s for s in reg.slots if s.name == active["slot"]), None)
    if slot is None:
        active["failure_context"] = "slot_missing"
        q["blocked"].append(active)
        q["active"] = None
        save_queue_state(q)
        return
    page = await slot_page(context, pages, slot)

    if active["phase"] == "WAIT_CHAT":
        # Durable Git is authoritative. ChatGPT UI response detection can fail even
        # after the task already committed its result, so check the exact task marker first.
        task_commit = github_find_task_commit(active["branch"], active["task_id"])
        if task_commit:
            active["result_sha"] = task_commit["sha"]
            active["result_message"] = task_commit["message"]
            active["last_checkpoint_head"] = task_commit["sha"]
            active["last_checkpoint_at"] = now.isoformat()
            active["controller_stage"] = "WAIT_ACTIONS"
            active["phase"] = "WAIT_ACTIONS"
            active["wait_actions_started_at"] = now.isoformat()
            active["last_gate_poll_at"] = None
            save_queue_state(q)
            write_runtime(
                status="queue_wait_actions",
                last_action=f"{active['task_id']} durable task commit found -> {active['result_sha']}",
                queue=active,
            )
            return

        skipped_commit = github_find_task_commit(
            active["branch"], active["task_id"], allow_ci_skip_fallback=True
        )
        if skipped_commit and skipped_commit.get("ci_skip_directive"):
            active["result_sha"] = skipped_commit["sha"]
            active["result_message"] = skipped_commit["message"]
            active["phase"] = "WAIT_ACTIONS"
            active["wait_actions_started_at"] = now.isoformat()
            active["last_gate_poll_at"] = None
            recovery = await recover_missing_gate_run(context, pages, active, now)
            save_queue_state(q)
            if recovery:
                action, reason = recovery
                write_runtime(
                    status="queue_missing_gate_recovery",
                    last_action=f"{active['task_id']} {action}: {reason}",
                    queue=active,
                )
            return

        if github_transient_retry_pending():
            write_runtime(
                status="github_retry_wait",
                last_action=f"{active['task_id']}: GitHub temporary error; holding current chat/task and retrying GitHub automatically",
                queue=active,
            )
            return

        if active.get("dispatch_confirmed") is False:
            dispatch_started = _parse_iso(active.get("dispatch_started_at")) or _parse_iso(active.get("sent_at")) or now
            dispatch_age = (now - dispatch_started).total_seconds()
            if dispatch_age < QUEUE_RESULT_GRACE_SECONDS:
                write_runtime(
                    status="dispatch_uncertain_wait",
                    last_action=f"{active['task_id']} provisional dispatch is {int(dispatch_age)}s old; checking Git before any resend",
                    queue=active,
                )
                return
            reason = (
                "Controller restarted or failed during ChatGPT dispatch before post-send confirmation; "
                "no durable task commit appeared within the grace period. Re-send the same TASK_ID in a fresh chat."
            )
            active["failure_context"] = reason
            if await queue_rollover_chat(context, pages, active, reason):
                save_queue_state(q)
            elif active.get("phase") == "BLOCKED":
                save_queue_state(q)
            return

        if (not slot.url or not is_project_scoped_chat_url(slot.url)) and is_project_scoped_chat_url(page.url):
            slot.url = page.url
            active["active_chat_url"] = page.url
            save_registry(reg)
            save_queue_state(q)

        if await queue_handle_retry_surface(context, pages, page, reg, slot, active, q):
            return
        if not slot.url or not is_project_scoped_chat_url(slot.url):
            reason = "Active task chat URL is missing or outside the configured project after restart/project-scope reconciliation."
            if await queue_rollover_chat(context, pages, active, reason):
                save_queue_state(q)
                return
            if active.get("phase") == "BLOCKED":
                save_queue_state(q)
            return
        if await detect_conversation_limit(page):
            reason = "ChatGPT reported that the current conversation reached its length limit."
            if await queue_rollover_chat(context, pages, active, reason):
                save_queue_state(q)
                return
            if active.get("phase") == "BLOCKED":
                save_queue_state(q)
            return
        if await detect_busy(page):
            busy_since = _parse_iso(active.get("last_hash_changed_at")) or _parse_iso(active.get("sent_at")) or now
            busy_age = (now - busy_since).total_seconds()
            if busy_age < WATCHDOG_BUSY_STALL_MINUTES * 60:
                return
            reason = (
                f"ChatGPT remained busy without durable Git progress for {int(busy_age)}s; "
                "rolling the same task to a fresh chat instead of waiting indefinitely."
            )
            active["failure_context"] = reason
            if await queue_rollover_chat(context, pages, active, reason):
                save_queue_state(q)
            elif active.get("phase") == "BLOCKED":
                save_queue_state(q)
            return
        text = await current_assistant_text(page)
        if not text:
            sent_at = _parse_iso(active.get("sent_at")) or now
            if (now - sent_at).total_seconds() < QUEUE_RESULT_GRACE_SECONDS:
                return
            reason = (
                "No assistant response was detected before the queue result grace period expired; "
                "the active chat may be stale, hidden, or failed before generation started."
            )
            if await queue_rollover_chat(context, pages, active, reason):
                save_queue_state(q)
                return
            if active.get("phase") == "BLOCKED":
                save_queue_state(q)
            return
        clear_rate_limit_after_response(reg)
        active["last_retry_backoff_at"] = None
        active["last_retry_click_at"] = None
        active["generic_retry_clicks"] = 0
        h = stable_hash(text)
        changed_at = _parse_iso(active.get("last_hash_changed_at")) or now
        if h != active.get("last_hash"):
            active["last_hash"] = h
            active["last_hash_changed_at"] = now.isoformat()
            save_queue_state(q)
            return
        if (now - changed_at).total_seconds() < QUEUE_STABLE_SECONDS:
            return

        task_commit = github_find_task_commit(active["branch"], active["task_id"])
        if not task_commit:
            await queue_handle_native_response(context, pages, active, text)
            save_queue_state(q)
            return
        else:
            active["result_sha"] = task_commit["sha"]
            active["result_message"] = task_commit["message"]
            active["phase"] = "WAIT_ACTIONS"
            active["wait_actions_started_at"] = now.isoformat()
            active["last_gate_poll_at"] = None
            if github_actions_skip_directive(active["result_message"]):
                recovery = await recover_missing_gate_run(context, pages, active, now)
                save_queue_state(q)
                if recovery:
                    action, reason = recovery
                    write_runtime(
                        status="queue_missing_gate_recovery",
                        last_action=f"{active['task_id']} {action}: {reason}",
                        queue=active,
                    )
                return
            save_queue_state(q)
            write_runtime(
                status="queue_wait_actions",
                last_action=f"{active['task_id']} -> {active['result_sha']} (exact task commit)",
                queue=active,
            )
            return

    if active["phase"] == "WAIT_ACTIONS":
        bound_run_id = (active.get("gate_run") or {}).get("id")
        poll_seconds = GITHUB_BOUND_RUN_POLL_SECONDS if bound_run_id else GITHUB_POLL_SECONDS
        last_poll = _parse_iso(active.get("last_gate_poll_at"))
        if last_poll and (now - last_poll).total_seconds() < poll_seconds:
            return
        active["last_gate_poll_at"] = now.isoformat()
        run = github_gate_run(
            active["branch"],
            active["result_sha"],
            active["workflow"],
            run_id=bound_run_id,
            force_discovery=not bool(bound_run_id),
        )
        save_queue_state(q)
        if run is None:
            if github_transient_retry_pending():
                write_runtime(
                    status="github_retry_wait",
                    last_action=f"{active['task_id']}: GitHub temporary error; Gate lookup will retry automatically without attempt/rollover changes",
                    queue=active,
                )
                return
            recovery = await recover_missing_gate_run(context, pages, active, now)
            if recovery:
                action, reason = recovery
                save_queue_state(q)
                write_runtime(
                    status="queue_missing_gate_recovery",
                    last_action=f"{active['task_id']} {action}: {reason}",
                    queue=active,
                )
                return
            save_queue_state(q)
            write_runtime(status="queue_validation_pending", last_action=f"No authoritative {active['workflow']} run yet for {active['result_sha']}", queue=active)
            return

        active["gate_run"] = run
        status_key = f"{run.get('status')}:{run.get('conclusion')}"
        if status_key != active.get("last_gate_status"):
            active["last_gate_status"] = status_key
            active["last_gate_status_changed_at"] = now.isoformat()

        if run["status"] != "completed":
            wait_started = (
                _parse_iso(active.get("wait_actions_started_at"))
                or _parse_iso(active.get("task_commit_rebound_at"))
                or _parse_iso(active.get("sent_at"))
                or now
            )
            active.setdefault("wait_actions_started_at", wait_started.isoformat())
            wait_age = (now - wait_started).total_seconds()
            if wait_age >= WAIT_ACTIONS_MAX_SECONDS:
                reason = (
                    f"{active['workflow']} exact run {run.get('id')} remained {run.get('status')} "
                    f"for {int(wait_age)}s (max={WAIT_ACTIONS_MAX_SECONDS}s); bounded recovery required."
                )
                if active["attempt"] < MAX_TASK_ATTEMPTS:
                    previous_attempt = active["attempt"]
                    previous_base = active["base_sha"]
                    active["attempt"] = previous_attempt + 1
                    if await queue_send_retry(context, pages, active, reason):
                        save_queue_state(q)
                    else:
                        active["attempt"] = previous_attempt
                        active["base_sha"] = previous_base
                        active["failure_context"] = reason
                        save_queue_state(q)
                    return
                active["failure_context"] = reason
                active["phase"] = "BLOCKED"
                save_queue_state(q)
                return
            changed_at = _parse_iso(active.get("last_gate_status_changed_at")) or now
            last_jobs = _parse_iso(active.get("last_jobs_refresh_at"))
            if (
                (now - changed_at).total_seconds() >= WAIT_ACTIONS_STALE_SECONDS
                and (not last_jobs or (now - last_jobs).total_seconds() >= WAIT_ACTIONS_STALE_SECONDS)
            ):
                active["gate_jobs"] = github_action_jobs_summary(run["id"])
                active["last_jobs_refresh_at"] = now.isoformat()
            save_queue_state(q)
            write_runtime(status="queue_validation_running", last_action=f"{active['workflow']} exact run {run['id']} is {run['status']}", queue=active)
            return

        if run.get("conclusion") == "success":
            record = dict(active)
            record["automation_validation"] = "PASS"
            record["runtime_validation"] = "UNTESTED"
            record["completed_at"] = now.isoformat()
            record["task_latched"] = False
            record["controller_stage"] = "DONE"
            q["completed"] = (q.get("completed", []) + [record])[-100:]
            q["active"] = None
            completed_slot = next((s for s in reg.slots if s.name == record.get("slot")), None)
            if completed_slot is not None:
                completed_slot.last_task_completed_at = now.isoformat()
                save_registry(reg)
            q["next_task_not_before"] = (now + timedelta(seconds=QUEUE_NEXT_TASK_DELAY_SECONDS)).isoformat()
            save_queue_state(q)
            write_runtime(status="queue_pass", last_action=f"{record['task_id']} automation PASS; runtime UNTESTED", last_completed=record)
            return

        active["gate_jobs"] = github_action_jobs_summary(run["id"])
        reason = f"{active['workflow']} exact run {run.get('id')} concluded {run.get('conclusion')}; inspect {run.get('html_url')}"
        if active["attempt"] < MAX_TASK_ATTEMPTS:
            previous_attempt = active["attempt"]
            previous_base = active["base_sha"]
            active["attempt"] = previous_attempt + 1
            if await queue_send_retry(context, pages, active, reason):
                save_queue_state(q)
            else:
                active["attempt"] = previous_attempt
                active["base_sha"] = previous_base
                save_queue_state(q)
            return
        active["failure_context"] = reason
        active["phase"] = "BLOCKED"

    if active["phase"] == "BLOCKED":
        record = dict(active)
        record["automation_validation"] = "FAIL"
        record["runtime_validation"] = "UNTESTED"
        record["blocked_at"] = now.isoformat()
        record["task_latched"] = False
        record["controller_stage"] = "BLOCKED"
        q["blocked"] = (q.get("blocked", []) + [record])[-100:]
        q["active"] = None
        blocked_slot = next((s for s in reg.slots if s.name == record.get("slot")), None)
        if blocked_slot is not None:
            blocked_slot.last_task_completed_at = now.isoformat()
            save_registry(reg)
        q["next_task_not_before"] = (now + timedelta(seconds=QUEUE_NEXT_TASK_DELAY_SECONDS)).isoformat()
        save_queue_state(q)
        write_runtime(status="queue_blocked", last_action=f"{record['task_id']} blocked after {record['attempt']} attempts; advancing to next independent task", last_blocked=record)


def refresh_wait_actions_task_binding(task: dict, force_refresh: bool = False) -> Optional[str]:
    """Rebind persisted WAIT_ACTIONS to the newest durable commit for the same TASK_ID."""
    if task.get("phase") != "WAIT_ACTIONS":
        return None
    branch = str(task.get("branch") or "").strip()
    task_id = str(task.get("task_id") or "").strip()
    if not branch or not task_id:
        return None
    if force_refresh:
        invalidate_task_commit_cache(branch, task_id)
    commit = github_find_task_commit(branch, task_id)
    if not commit or not commit.get("sha"):
        return None

    old_sha = task.get("result_sha")
    new_sha = commit["sha"]
    task["startup_reconcile_pending"] = False
    if new_sha == old_sha:
        return None

    if old_sha:
        task["rebound_from_result_sha"] = old_sha
    old_failure = str(task.get("failure_context") or "").strip()
    if old_failure:
        task["previous_failure_context"] = old_failure
    task["result_sha"] = new_sha
    task["result_message"] = commit.get("message")
    task["failure_context"] = ""
    task["last_gate_poll_at"] = None
    task["task_commit_rebound_at"] = datetime.now(TZ).isoformat()
    task["wait_actions_started_at"] = task["task_commit_rebound_at"]
    task.pop("missing_gate_run_detected_at", None)
    task.pop("missing_gate_run_reason", None)
    for key in (
        "gate_run",
        "last_gate_status",
        "last_gate_status_changed_at",
        "gate_jobs",
        "last_jobs_refresh_at",
    ):
        task.pop(key, None)
    return f"{task_id}:{str(old_sha or 'none')[:8]}->{new_sha[:8]}"


def _queue_nonterminal_records(q: dict) -> list[dict]:
    records = []
    active = q.get("active")
    if isinstance(active, dict) and active.get("phase") not in {None, "DONE"}:
        records.append(active)
    for task in (q.get("active_by_lane") or {}).values():
        if isinstance(task, dict) and task.get("phase") not in {None, "DONE"}:
            records.append(task)
    return records


def reconcile_localization_blocked_producer_commits(q: dict) -> int:
    """Recover producer work falsely BLOCKED by stale ChatGPT UI after Git already persisted it."""
    if CONTROLLER_MODE != "localization":
        return 0
    now = datetime.now(TZ)
    blocked = list(q.get("blocked", []))
    if not blocked:
        return 0
    kept = []
    recovered = 0
    completed_keys = {
        (str(item.get("task_id") or ""), str(item.get("result_sha") or ""))
        for item in q.get("completed", [])
        if isinstance(item, dict)
    }
    for task in blocked:
        if not isinstance(task, dict):
            kept.append(task)
            continue
        lane = str(task.get("lane") or "")
        slot = str(task.get("slot") or "")
        is_producer = slot in {"A", "B", "D"} or lane in {
            "LOCALIZATION_A", "LOCALIZATION_B", "LOCALIZATION_E"
        }
        task_id = str(task.get("task_id") or "")
        if not is_producer or not task_id:
            kept.append(task)
            continue
        branch = str(task.get("branch") or "korean-localization-clean")
        invalidate_task_commit_cache(branch, task_id)
        commit = github_find_task_commit(branch, task_id, allow_ci_skip_fallback=True)
        if not commit:
            kept.append(task)
            continue

        valid, guard_reasons, _record = localization_validate_producer_result_commit(
            task_id, str(commit.get("sha") or "")
        )
        if not valid:
            slot_key = slot if slot in {"A", "B", "D"} else {
                "LOCALIZATION_A": "A",
                "LOCALIZATION_B": "B",
                "LOCALIZATION_E": "D",
            }.get(lane)
            active_by_lane = q.setdefault("active_by_lane", {})
            if slot_key and slot_key not in active_by_lane:
                rearmed = dict(task)
                rearmed["branch"] = branch
                rearmed["slot"] = slot_key
                rearmed["phase"] = "WAIT_CHAT"
                rearmed["terminal"] = None
                rearmed["result_sha"] = None
                rearmed["automation_validation"] = "PENDING"
                rearmed["producer_no_work_rejected_sha"] = commit.get("sha")
                rearmed["producer_no_work_guard_reasons"] = guard_reasons
                rearmed.pop("blocked_at", None)
                rearmed["failure_context"] = "NO_WORK_GUARD_REARMED_ON_STARTUP"
                active_by_lane[slot_key] = rearmed
                recovered += 1
                continue
            kept.append(task)
            continue

        fixed = dict(task)
        fixed["branch"] = branch
        fixed["recovered_from_false_blocked"] = True
        fixed["recovered_from_false_blocked_at"] = now.isoformat()
        fixed["recovered_blocked_reason"] = task.get("failure_context")
        fixed.pop("blocked_at", None)
        fixed["failure_context"] = ""
        key = (task_id, str(commit.get("sha") or ""))
        if key not in completed_keys:
            finalize_localization_producer_commit(q, fixed, commit, now)
            completed_keys.add(key)
        else:
            fixed["result_sha"] = commit["sha"]
            fixed["result_message"] = commit.get("message")
            fixed["automation_validation"] = "PENDING"
            fixed["validation_mode"] = "C_BATCH_GATE"
            fixed["batch_validation_pending"] = True
            fixed["runtime_validation"] = "UNTESTED"
            fixed["completed_at"] = fixed.get("completed_at") or now.isoformat()
            fixed["terminal"] = "PRODUCED"
            fixed["phase"] = "DONE"
        enqueue_producer_result_for_qa(q, fixed)
        recovered += 1

    if recovered:
        q["blocked"] = kept[-100:]
        q["startup_blocked_producer_recovered_count"] = int(
            q.get("startup_blocked_producer_recovered_count", 0)
        ) + recovered
        q["startup_blocked_producer_recovered_at"] = now.isoformat()
    return recovered


def startup_reconcile_queue_state() -> None:
    """Invalidate stale caches and reconcile persisted queue state against durable Git."""
    _github_commit_list_cache.clear()
    _github_task_commit_cache.clear()
    _github_actions_cache.clear()
    q = load_queue_state()
    recovered_producers = 0
    if CONTROLLER_MODE == "localization":
        restored_blocked = reconcile_blocked_qa_inputs(q)
        if restored_blocked:
            q["startup_qa_blocked_requeued"] = restored_blocked
        recovered_producers = reconcile_localization_blocked_producer_commits(q)
        if recovered_producers:
            q["startup_blocked_producer_recovered"] = recovered_producers
    now = datetime.now(TZ)
    records = _queue_nonterminal_records(q)
    branches = sorted({r.get("branch") for r in records if r.get("branch")})
    heads = {}
    for branch_name in branches:
        head = github_branch_head(branch_name)
        if head:
            heads[branch_name] = head

    rebounds = []
    for task in records:
        if _is_latched_execution_task(task):
            task["task_latched"] = True
            task.setdefault("premature_stop_count", 0)
            task.setdefault("premature_stop_total", 0)
            task.setdefault("premature_stop_counted_for_send_at", None)
            branch_head = heads.get(task.get("branch"))
            if branch_head:
                task.setdefault("last_checkpoint_head", branch_head)
            task.setdefault("last_checkpoint_at", now.isoformat())
            if task.get("phase") == "WAIT_ACTIONS":
                task["controller_stage"] = "WAIT_ACTIONS"
            elif CONTROLLER_MODE == "localization":
                task["controller_stage"] = (
                    "WAIT_QA_RESULT" if str(task.get("lane") or "") == "LOCALIZATION_C"
                    else task.get("controller_stage") or "WAIT_MATERIAL_COMMIT"
                )
            else:
                task["controller_stage"] = task.get("controller_stage") or "WAIT_DURABLE_RESULT"
            # Old releases could persist a five-minute generic-Retry circuit. The
            # new policy rolls a broken input surface to a fresh chat instead.
            task.pop("generic_retry_cooldown_until", None)
        if task.get("phase") == "WAIT_ACTIONS":
            if CONTROLLER_MODE == "localization" and task.get("slot") in {"A", "B", "D"}:
                invalidate_task_commit_cache(str(task.get("branch") or ""), str(task.get("task_id") or ""))
                commit = github_find_task_commit(task.get("branch"), task.get("task_id"))
                if commit:
                    accepted = localization_reconcile_producer_commit_without_ui(
                        q, task, commit, now, "STARTUP"
                    )
                    rebounds.append(
                        (f"producer-release:{task.get('task_id')}->{commit.get('sha','')[:8]}")
                        if accepted
                        else f"producer-no-work-rearmed:{task.get('task_id')}"
                    )
                continue
            task["last_gate_poll_at"] = None
            task["startup_reconcile_pending"] = True
            rebound = refresh_wait_actions_task_binding(task, force_refresh=True)
            if rebound:
                rebounds.append(rebound)

    if not records:
        not_before = _parse_iso(q.get("next_task_not_before"))
        if not_before and (not_before - now).total_seconds() > QUEUE_IDLE_REARM_SECONDS:
            q["next_task_not_before"] = (now + timedelta(seconds=QUEUE_NEXT_TASK_DELAY_SECONDS)).isoformat()
    q["last_startup_reconcile_at"] = now.isoformat()
    q["startup_branch_heads"] = heads
    q["startup_task_rebounds"] = rebounds[-20:]
    save_queue_state(q)
    write_runtime(
        status="startup_reconcile",
        last_action=(
            f"Startup reconciled {len(records)} nonterminal queue record(s); "
            f"task-commit rebounds={len(rebounds)}"
        ),
        queue=q,
    )


def watchdog_rearm_queue_state(now: datetime) -> Optional[str]:
    """Re-arm stale queue state; the queue engine remains the only task sender."""
    q = load_queue_state()
    records = _queue_nonterminal_records(q)
    changed = False
    rearmed = []
    for task in records:
        if task.get("phase") != "WAIT_ACTIONS":
            continue
        if CONTROLLER_MODE == "localization" and task.get("slot") in {"A", "B", "D"}:
            invalidate_task_commit_cache(str(task.get("branch") or ""), str(task.get("task_id") or ""))
            commit = github_find_task_commit(task.get("branch"), task.get("task_id"))
            if commit:
                accepted = localization_reconcile_producer_commit_without_ui(
                    q, task, commit, now, "WATCHDOG"
                )
                rearmed.append(
                    f"producer-release:{task.get('task_id')}"
                    if accepted
                    else f"producer-no-work-rearmed:{task.get('task_id')}"
                )
                changed = True
            continue
        if task.get("startup_reconcile_pending"):
            rebound = refresh_wait_actions_task_binding(task, force_refresh=True)
            if rebound:
                rearmed.append("commit-rebound:" + rebound)
                changed = True
        last_poll = _parse_iso(task.get("last_gate_poll_at"))
        if last_poll and (now - last_poll).total_seconds() >= WAIT_ACTIONS_STALE_SECONDS:
            rebound = refresh_wait_actions_task_binding(task, force_refresh=True)
            task["last_gate_poll_at"] = None
            task["watchdog_rearmed_at"] = now.isoformat()
            rearmed.append(("commit-rebound:" + rebound) if rebound else str(task.get("task_id")))
            changed = True
    if not records:
        not_before = _parse_iso(q.get("next_task_not_before"))
        if not_before and (not_before - now).total_seconds() > QUEUE_IDLE_REARM_SECONDS:
            q["next_task_not_before"] = (now + timedelta(seconds=QUEUE_NEXT_TASK_DELAY_SECONDS)).isoformat()
            rearmed.append("idle-queue")
            changed = True
    if changed:
        save_queue_state(q)
        return "rearmed " + ", ".join(x for x in rearmed if x)
    return None


BROWSER_TRANSPORT_FAILURE_PATTERNS = (
    "connection closed while reading from the driver",
    "target page, context or browser has been closed",
    "browser has been closed",
)


def is_browser_transport_failure(exc: BaseException) -> bool:
    text = f"{type(exc).__name__}: {exc}".lower()
    return any(pattern in text for pattern in BROWSER_TRANSPORT_FAILURE_PATTERNS)


def record_browser_transport_failure(where: str, exc: BaseException):
    message = f"Browser automation transport lost in {where}; exiting so Docker restart policy can recover"
    log.critical("%s: %r", message, exc)
    write_runtime(
        status="browser_transport_lost",
        last_action=message,
        last_error=repr(exc),
    )


async def scheduler_loop(context: BrowserContext, pages: dict[str, Page], once: bool):
    if QUEUE_MODE:
        startup_reconcile_queue_state()
    if once:
        if QUEUE_MODE:
            if CONTROLLER_MODE == "localization" and LOCALIZATION_PARALLEL:
                await localization_parallel_cycle(context, pages)
            elif CONTROLLER_MODE == "conversion":
                await conversion_parallel_cycle(context, pages)
            else:
                await queue_cycle(context, pages)
        else:
            await run_cycle(context, pages)
        return
    last_tick = None
    last_watchdog_check = 0.0
    last_queue_check = 0.0
    last_heartbeat = 0.0
    queue_error_signature = None
    queue_error_count = 0
    watchdog_error_signature = None
    watchdog_error_count = 0
    write_runtime(status="idle", tab_mode="fresh_per_run" if FRESH_CHAT_EACH_RUN else "dedicated_per_slot", tab_count=len(pages))
    while True:
        now = datetime.now(TZ)
        mono = time.monotonic()
        did_work = False

        if mono - last_heartbeat >= HEARTBEAT_SECONDS:
            last_heartbeat = mono
            write_runtime(queue_loop_heartbeat_at=now.isoformat(), last_tick=now.isoformat())

        if AUTO_SEND and QUEUE_MODE and mono - last_queue_check >= QUEUE_CHECK_SECONDS:
            last_queue_check = mono
            did_work = True
            try:
                if CONTROLLER_MODE == "localization" and LOCALIZATION_PARALLEL:
                    await localization_parallel_cycle(context, pages)
                elif CONTROLLER_MODE == "conversion":
                    await conversion_parallel_cycle(context, pages)
                else:
                    await queue_cycle(context, pages)
                queue_error_signature = None
                queue_error_count = 0
            except Exception as e:
                if isinstance(e, ControllerRestartRequested):
                    write_runtime(status="controller_restart_requested", last_action=str(e), last_error=repr(e))
                    raise
                if is_browser_transport_failure(e):
                    record_browser_transport_failure("queue_cycle", e)
                    raise
                log.exception("queue cycle failed")
                signature = f"{type(e).__name__}:{e}"
                queue_error_signature = signature
                queue_error_count += 1
                write_runtime(
                    status="queue_error",
                    last_action=f"Queue cycle failed ({queue_error_count}/{QUEUE_ERROR_RESTART_THRESHOLD}): {type(e).__name__}: {e}",
                    last_error=repr(e),
                    queue_error_count=queue_error_count,
                )
                if queue_error_count >= QUEUE_ERROR_RESTART_THRESHOLD:
                    write_runtime(
                        status="queue_error_restart",
                        last_action=f"Repeated queue failure reached threshold {QUEUE_ERROR_RESTART_THRESHOLD}; exiting for Docker restart",
                        last_error=repr(e),
                    )
                    raise
        elif AUTO_SEND and not QUEUE_MODE:
            tick = now.strftime("%Y-%m-%dT%H:%M")
            if now.minute in SCHEDULE_MINUTES and tick != last_tick:
                last_tick = tick
                did_work = True
                write_runtime(last_tick=tick, status="running")
                try:
                    await run_cycle(context, pages)
                except Exception as e:
                    if isinstance(e, ControllerRestartRequested):
                        write_runtime(status="controller_restart_requested", last_action=str(e), last_error=repr(e))
                        raise
                    if is_browser_transport_failure(e):
                        record_browser_transport_failure("scheduled_cycle", e)
                        raise
                    log.exception("scheduled cycle failed")
                    write_runtime(status="error", last_error=repr(e))
        elif not AUTO_SEND:
            if runtime.get("status") not in ("login_required", "manual_mode"):
                write_runtime(status="manual_mode", last_action="AUTO_SEND=false; waiting for manual login/setup")

        if AUTO_SEND and WATCHDOG_ENABLED and not did_work and mono - last_watchdog_check >= WATCHDOG_CHECK_SECONDS:
            last_watchdog_check = mono
            try:
                await watchdog_cycle(context, pages)
                watchdog_error_signature = None
                watchdog_error_count = 0
            except Exception as e:
                if isinstance(e, ControllerRestartRequested):
                    write_runtime(status="controller_restart_requested", last_action=str(e), last_error=repr(e))
                    raise
                if is_browser_transport_failure(e):
                    record_browser_transport_failure("watchdog_cycle", e)
                    raise
                log.exception("watchdog cycle failed")
                signature = f"{type(e).__name__}:{e}"
                watchdog_error_signature = signature
                watchdog_error_count += 1
                write_runtime(
                    status="watchdog_error",
                    last_action=f"Watchdog failed ({watchdog_error_count}/{WATCHDOG_ERROR_RESTART_THRESHOLD}): {type(e).__name__}: {e}",
                    last_error=repr(e),
                    watchdog_error_count=watchdog_error_count,
                )
                if watchdog_error_count >= WATCHDOG_ERROR_RESTART_THRESHOLD:
                    write_runtime(
                        status="watchdog_error_restart",
                        last_action=f"Repeated watchdog failure reached threshold {WATCHDOG_ERROR_RESTART_THRESHOLD}; exiting for Docker restart",
                        last_error=repr(e),
                    )
                    raise
        await asyncio.sleep(5)


async def main_async(once: bool):
    start_status_server()
    validate_runtime_assets()
    write_runtime(status="browser_connecting", last_action="Runtime assets validated; attaching controller to Chrome DevTools")
    async with async_playwright() as p:
        browser = None
        for _ in range(60):
            try:
                browser = await p.chromium.connect_over_cdp("http://127.0.0.1:9222")
                break
            except Exception:
                await asyncio.sleep(1)
        if browser is None:
            raise RuntimeError("Could not attach to Google Chrome on CDP port 9222")

        context = browser.contexts[0] if browser.contexts else await browser.new_context()
        write_runtime(status="browser_attached", last_action="Chrome attached; restoring native-plugin tasks and read-only GitHub observation")
        reg = load_registry(datetime.now(TZ))
        pages = await prepare_slot_pages(context, reg)
        write_runtime(status="controller_ready", last_action="Queue/chat state restored; checking login and starting scheduler")

        # Login check on slot A tab; session is shared by all tabs.
        first_page = pages[reg.slots[0].name]
        if not await ensure_logged_in(first_page):
            write_runtime(status="login_required", last_action="Open noVNC and log in to ChatGPT")
        start_process_liveness_monitor()
        await scheduler_loop(context, pages, once=once)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--once", action="store_true", help="run one review cycle immediately")
    args = parser.parse_args()
    try:
        asyncio.run(main_async(args.once))
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
