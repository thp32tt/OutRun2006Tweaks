class StatusHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        return

    def do_GET(self):
        if self.path not in ("/", "/status"):
            self.send_response(404); self.end_headers(); return
        now = datetime.now(TZ)
        reg = load_registry(now)
        body = f"""<!doctype html><html><head><meta charset='utf-8'><title>OutRun Chat Controller</title>
<style>body{{font-family:sans-serif;max-width:1000px;margin:40px auto;padding:0 20px}}pre{{background:#f5f5f5;padding:16px;overflow:auto}}</style></head><body>
<h1>OutRun Chat Controller</h1>
<p><b>AUTO_SEND:</b> {html.escape(str(AUTO_SEND))}</p>
<p><b>Status:</b> {html.escape(str(runtime.get('status')))}</p>
<p><b>Last action:</b> {html.escape(str(runtime.get('last_action')))}</p>
<p><b>Schedule:</b> minute {html.escape(str(SCHEDULE_MINUTES))} / KST</p>
<p><b>Watchdog:</b> {html.escape(str(WATCHDOG_ENABLED))} / idle {WATCHDOG_STALL_MINUTES}m / busy-stall {WATCHDOG_BUSY_STALL_MINUTES}m / force-stop {html.escape(str(WATCHDOG_FORCE_STOP_STALLED))}</p>
<p><b>Rate limit:</b> attempts {reg.rate_limit_attempts} / until {html.escape(str(reg.rate_limit_until))} / backoff {html.escape(str(RATE_LIMIT_BACKOFF_SECONDS))}s / global-gap {MIN_SEND_GAP_SECONDS}s / slot-dedup {SLOT_DEDUP_SECONDS}s</p>
<p><b>Chat mode:</b> fresh_each_run {html.escape(str(FRESH_CHAT_EACH_RUN))} / retry cooldown {RETRY_BUTTON_COOLDOWN_SECONDS}s</p>
<p><b>Thinking:</b> required {html.escape(PREFERRED_THINKING_LEVEL)} / strict {html.escape(str(STRICT_THINKING_LEVEL))} / last {html.escape(str(runtime.get('last_thinking_level_result')))}</p>
<p><b>Logical date:</b> {html.escape(reg.logical_date)}</p>
<p><b>Next slot:</b> {html.escape(reg.slots[reg.next_slot].name)}</p>
<h2>Registry</h2><pre>{html.escape(json.dumps({"next_slot": reg.next_slot, "rate_limit_attempts": reg.rate_limit_attempts, "rate_limit_until": reg.rate_limit_until, "last_global_send_at": reg.last_global_send_at, "slots": [asdict(s) for s in reg.slots]}, ensure_ascii=False, indent=2))}</pre>
<h2>Runtime</h2><pre>{html.escape(json.dumps(runtime, ensure_ascii=False, indent=2))}</pre>
<p>noVNC: <a href='http://192.168.0.48:6080/vnc.html'>192.168.0.48:6080/vnc.html</a></p>
</body></html>""".encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers(); self.wfile.write(body)


def start_status_server():
    server = ThreadingHTTPServer(("0.0.0.0", STATUS_PORT), StatusHandler)
    t = threading.Thread(target=server.serve_forever, daemon=True)
    t.start()
    log.info("status server listening on :%s", STATUS_PORT)



async def queue_send_retry(context: BrowserContext, pages: dict[str, Page], active: dict, reason: str) -> bool:
    reg = load_registry(datetime.now(TZ))
    slot = next((s for s in reg.slots if s.name == active["slot"]), None)
    if slot is None:
        return False
    page = await slot_page(context, pages, slot)
    if await detect_busy(page):
        return False
    runtime["queue_task_id"] = active["task_id"]
    runtime["queue_lane"] = active["lane"]
    runtime["queue_branch"] = active["branch"]
    runtime["queue_attempt"] = active["attempt"]
    runtime["queue_failure_context"] = reason
    prompt = prompt_for_slot(slot, "repair")
    if not await ensure_thinking_level(page) and STRICT_THINKING_LEVEL:
        return False
    result = await send_message(page, prompt)
    if result != "sent":
        write_runtime(status="queue_retry_send_failed", last_action=f"{active['task_id']} retry send failed: {result}")
        return False
    now = datetime.now(TZ)
    active["sent_at"] = now.isoformat()
    active["last_hash"] = None
    active["last_hash_changed_at"] = now.isoformat()
    active["result_sha"] = None
    active["phase"] = "WAIT_CHAT"
    active["last_gate_poll_at"] = None
    active["failure_context"] = reason
    slot.last_sent_at = now.isoformat()
    slot.last_assistant_hash = None
    slot.last_assistant_change_at = now.isoformat()
    slot.last_result = "queue_retry_sent"
    save_registry(reg)
    return True


async def queue_cycle(context: BrowserContext, pages: dict[str, Page]):
    now = datetime.now(TZ)
    q = load_queue_state()
    reg = load_registry(now)
    active = q.get("active")

    if not active:
        slot = reg.slots[reg.next_slot]
        target = queue_target_for_slot(slot.name)
        base_sha = github_branch_head(target["branch"])
        if not base_sha:
            write_runtime(status="queue_github_unavailable", last_action=f"Could not read branch {target['branch']}")
            return
        q["counter"] = int(q.get("counter", 0)) + 1
        task_id = f"{CONTROLLER_MODE.upper()}-{target['lane']}-{q['counter']:05d}"
        runtime["queue_task_id"] = task_id
        runtime["queue_lane"] = target["lane"]
        runtime["queue_branch"] = target["branch"]
        runtime["queue_attempt"] = 1
        runtime["queue_failure_context"] = ""
        slot_name = slot.name
        await run_cycle(context, pages)
        if runtime.get("status") != "sent":
            q["counter"] -= 1
            save_queue_state(q)
            return
        q["active"] = {
            "task_id": task_id,
            "slot": slot_name,
            "lane": target["lane"],
            "branch": target["branch"],
            "workflow": target["workflow"],
            "base_sha": base_sha,
            "result_sha": None,
            "attempt": 1,
            "phase": "WAIT_CHAT",
            "sent_at": datetime.now(TZ).isoformat(),
            "last_hash": None,
            "last_hash_changed_at": datetime.now(TZ).isoformat(),
            "last_gate_poll_at": None,
            "failure_context": "",
        }
        save_queue_state(q)
        write_runtime(status="queue_wait_chat", last_action=f"Sent {task_id}", queue=q["active"])
        return

    slot = next((s for s in reg.slots if s.name == active["slot"]), None)
    if slot is None:
        active["failure_context"] = "slot_missing"
        q["blocked"].append(active)
        q["active"] = None
        save_queue_state(q)
        return
    page = await slot_page(context, pages, slot)

    if active["phase"] == "WAIT_CHAT":
        if await detect_busy(page):
            return
        text = await last_assistant_text(page)
        if not text:
            return
        h = stable_hash(text)
        changed_at = _parse_iso(active.get("last_hash_changed_at")) or now
        if h != active.get("last_hash"):
            active["last_hash"] = h
            active["last_hash_changed_at"] = now.isoformat()
            save_queue_state(q)
            return
        if (now - changed_at).total_seconds() < QUEUE_STABLE_SECONDS:
            return

        head = github_branch_head(active["branch"])
        if not head:
            return
        if head == active["base_sha"]:
            sent_at = _parse_iso(active.get("sent_at")) or now
            if (now - sent_at).total_seconds() < QUEUE_RESULT_GRACE_SECONDS:
                return
            reason = "Chat response stabilized but target branch HEAD did not change; no durable Git result commit was found."
            if active["attempt"] < MAX_TASK_ATTEMPTS:
                active["attempt"] += 1
                if await queue_send_retry(context, pages, active, reason):
                    save_queue_state(q)
                return
            active["failure_context"] = reason
            active["phase"] = "BLOCKED"
        else:
            msg = github_commit_message(head) or ""
            expected = f"[AUTO:{active['task_id']}]"
            if expected not in msg:
                reason = f"Target branch changed to {head} but commit message did not contain required task marker {expected}."
                if active["attempt"] < MAX_TASK_ATTEMPTS:
                    active["attempt"] += 1
                    active["base_sha"] = head
                    if await queue_send_retry(context, pages, active, reason):
                        save_queue_state(q)
                    return
                active["failure_context"] = reason
                active["phase"] = "BLOCKED"
            else:
                active["result_sha"] = head
                active["phase"] = "WAIT_ACTIONS"
                active["last_gate_poll_at"] = None
                save_queue_state(q)
                write_runtime(status="queue_wait_actions", last_action=f"{active['task_id']} -> {head}", queue=active)
                return

    if active["phase"] == "WAIT_ACTIONS":
        last_poll = _parse_iso(active.get("last_gate_poll_at"))
        if last_poll and (now - last_poll).total_seconds() < GITHUB_POLL_SECONDS:
            return
        active["last_gate_poll_at"] = now.isoformat()
        run = github_gate_run(active["branch"], active["result_sha"], active["workflow"])
        save_queue_state(q)
        if run is None:
            write_runtime(status="queue_validation_pending", last_action=f"No {active['workflow']} run yet for {active['result_sha']}", queue=active)
            return
        active["gate_run"] = run
        if run["status"] != "completed":
            save_queue_state(q)
            write_runtime(status="queue_validation_running", last_action=f"{active['workflow']} run {run['id']} is {run['status']}", queue=active)
            return
        if run.get("conclusion") == "success":
            record = dict(active)
            record["automation_validation"] = "PASS"
            record["runtime_validation"] = "UNTESTED"
            record["completed_at"] = now.isoformat()
            q["completed"] = (q.get("completed", []) + [record])[-100:]
            q["active"] = None
            save_queue_state(q)
            write_runtime(status="queue_pass", last_action=f"{record['task_id']} automation PASS; runtime UNTESTED", last_completed=record)
            return

        reason = f"{active['workflow']} run {run.get('id')} concluded {run.get('conclusion')}; inspect {run.get('html_url')}"
        if active["attempt"] < MAX_TASK_ATTEMPTS:
            active["attempt"] += 1
            active["base_sha"] = active["result_sha"]
            if await queue_send_retry(context, pages, active, reason):
                save_queue_state(q)
            return
        active["failure_context"] = reason
        active["phase"] = "BLOCKED"

    if active["phase"] == "BLOCKED":
        record = dict(active)
        record["automation_validation"] = "FAIL"
        record["runtime_validation"] = "UNTESTED"
        record["blocked_at"] = now.isoformat()
        q["blocked"] = (q.get("blocked", []) + [record])[-100:]
        q["active"] = None
        save_queue_state(q)
        write_runtime(status="queue_blocked", last_action=f"{record['task_id']} blocked after {record['attempt']} attempts; advancing to next independent task", last_blocked=record)


async def scheduler_loop(context: BrowserContext, pages: dict[str, Page], once: bool):
    if once:
        if QUEUE_MODE:
            await queue_cycle(context, pages)
        else:
            await run_cycle(context, pages)
        return
    last_tick = None
    last_watchdog_check = 0.0
    last_queue_check = 0.0
    write_runtime(status="idle", tab_mode="fresh_per_run" if FRESH_CHAT_EACH_RUN else "dedicated_per_slot", tab_count=len(pages))
    while True:
        now = datetime.now(TZ)
        mono = time.monotonic()
        did_work = False

        if AUTO_SEND and QUEUE_MODE and mono - last_queue_check >= QUEUE_CHECK_SECONDS:
            last_queue_check = mono
            did_work = True
            try:
                await queue_cycle(context, pages)
            except Exception as e:
                log.exception("queue cycle failed")
                write_runtime(status="queue_error", last_error=repr(e))
        elif AUTO_SEND and not QUEUE_MODE:
            tick = now.strftime("%Y-%m-%dT%H:%M")
            if now.minute in SCHEDULE_MINUTES and tick != last_tick:
                last_tick = tick
                did_work = True
                write_runtime(last_tick=tick, status="running")
                try:
                    await run_cycle(context, pages)
                except Exception as e:
                    log.exception("scheduled cycle failed")
                    write_runtime(status="error", last_error=repr(e))
        elif not AUTO_SEND:
            if runtime.get("status") not in ("login_required", "manual_mode"):
                write_runtime(status="manual_mode", last_action="AUTO_SEND=false; waiting for manual login/setup")

        if AUTO_SEND and WATCHDOG_ENABLED and not did_work and mono - last_watchdog_check >= WATCHDOG_CHECK_SECONDS:
            last_watchdog_check = mono
            try:
                await watchdog_cycle(context, pages)
            except Exception as e:
                log.exception("watchdog cycle failed")
                write_runtime(status="watchdog_error", last_error=repr(e))
        await asyncio.sleep(5)


async def main_async(once: bool):
    start_status_server()
    async with async_playwright() as p:
        browser = None
        for _ in range(60):
            try:
                browser = await p.chromium.connect_over_cdp("http://127.0.0.1:9222")
                break
            except Exception:
                await asyncio.sleep(1)
        if browser is None:
            raise RuntimeError("Could not attach to Google Chrome on CDP port 9222")

        context = browser.contexts[0] if browser.contexts else await browser.new_context()
        reg = load_registry(datetime.now(TZ))
        pages = await prepare_slot_pages(context, reg)

        # Login check on slot A tab; session is shared by all tabs.
        first_page = pages[reg.slots[0].name]
        if not await ensure_logged_in(first_page):
            write_runtime(status="login_required", last_action="Open noVNC and log in to ChatGPT")
        await scheduler_loop(context, pages, once=once)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--once", action="store_true", help="run one review cycle immediately")
    args = parser.parse_args()
    try:
        asyncio.run(main_async(args.once))
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
