class StatusHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        return

    def do_GET(self):
        if self.path not in {"/", "/status"}:
            self.send_response(404)
            self.end_headers()
            return
        # Read-only status requests cannot migrate or overwrite scheduler state.
        with registry_lock:
            snapshot = dict(runtime)
            registry = json.loads(REGISTRY_FILE.read_text()) if REGISTRY_FILE.exists() else {}
        body = ("<!doctype html><html><head><meta charset='utf-8'><title>OutRun Controller</title>"
                "</head><body><h1>OutRun lane / asset controller</h1>"
                "<p><b>Controller mode:</b> " + html.escape(CONTROLLER_MODE) + "</p>"
                "<h2>Runtime</h2><pre>" +
                html.escape(json.dumps({"runtime": snapshot, "registry": registry},
                                       ensure_ascii=False, indent=2)) + "</pre></body></html>").encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def start_status_server():
    server = ThreadingHTTPServer(("0.0.0.0", STATUS_PORT), StatusHandler)
    threading.Thread(target=server.serve_forever, daemon=True).start()


def block_lane(reg: Registry, active: dict, reason: str):
    active["state"] = "BLOCKED"
    active["reason"] = reason
    record = dict(active)
    if active.get("asset_path"):
        reg.artifact_records[active["asset_path"]] = record
    elif active.get("selection_mode") == "autonomous":
        reg.producer_cooldowns[active["lane"]] = (
            datetime.now(TZ) + timedelta(seconds=QUEUE_IDLE_REARM_SECONDS)).isoformat()
    reg.active_lanes.pop(active["lane"], None)
    publish_lane(active)
    save_registry(reg)


def finish_qa(reg: Registry, active: dict):
    path = active["asset_path"]
    current = reg.artifact_records.get(path, {})
    if (current.get("candidate_sha") != active["candidate_sha"] or
            current.get("reason") == "Candidate bytes changed without a new manifest"):
        reg.active_lanes.pop("C", None)
        return
    current.update(state=active["disposition"], qa_sha=active["result_sha"],
                   automation_validation="PASS", runtime_validation="UNTESTED")
    reg.qa_queue = [q for q in reg.qa_queue if qa_key(q) != qa_key(active)]
    reg.active_lanes.pop("C", None)
    publish_lane({**current, "lane": "C"})
    save_registry(reg)


async def poll_gate(reg: Registry, active: dict):
    now = datetime.now(TZ)
    run = await asyncio.to_thread(github_gate_run, active["branch"], active["result_sha"],
                                 active["workflow"], active.get("run_id"), True)
    if run is None:
        elapsed = (now - datetime.fromisoformat(active["gate_started_at"])).total_seconds()
        if elapsed > WAIT_ACTIONS_NO_RUN_TIMEOUT_SECONDS:
            block_lane(reg, active, "Exact-SHA Actions run missing; preserve evidence for gate repair")
        return
    active["run_id"] = run["id"]
    if run["status"] != "completed":
        return
    if run["conclusion"] != "success":
        block_lane(reg, active, f"Actions run {run['id']}: {run['conclusion']}")
        return
    if active["lane"] == "C" and CONTROLLER_MODE == "localization":
        finish_qa(reg, active)
    else:
        active["state"] = "PASS"
        reg.artifact_records[active["asset_path"]] = dict(active)
        reg.active_lanes.pop(active["lane"], None)
        publish_lane(active)


async def dispatch_lane(context, pages, reg: Registry, active: dict) -> bool:
    slot = next(s for s in reg.slots if s.name == active["lane"])
    now = datetime.now(TZ)
    if send_guard_reason(reg, slot, now):
        return False
    running_tabs = 0
    for existing in pages.values():
        if not existing.is_closed() and await detect_busy(existing):
            running_tabs += 1
    if running_tabs >= MAX_ACTIVE_LANES:
        return False
    page = await slot_page(context, pages, slot)
    # Preserve a live old conversation during migration; do not discard work.
    if await detect_busy(page):
        return False
    if not await ensure_logged_in(page):
        write_runtime(status="login_required")
        return False
    if await detect_rate_limit(page):
        mark_rate_limit(reg, now, "lane-dispatch")
        return False
    page = await replace_with_fresh_slot_page(context, pages, slot)
    if not await ensure_thinking_level(page):
        return False
    prompt = (conversion_prompt(active) if CONTROLLER_MODE == "conversion" else
              qa_prompt(active) if active["lane"] == "C" else producer_prompt(active))
    # Persist intent BEFORE Enter. An interrupted send must never be silently
    # replayed into another chat after a crash.
    active.update(state="SENDING", sent_at=now.isoformat(), assistant_hash="",
                  response_changed_at=now.isoformat())
    reg.active_lanes[active["lane"]] = active
    save_registry(reg)
    result = await send_message(page, prompt)
    slot.url = await wait_for_chat_url(page)
    active["chat_url"] = slot.url
    if result != "sent":
        block_lane(reg, active, "Send outcome uncertain: " + result)
        return False
    active["state"] = "VERIFYING" if CONTROLLER_MODE == "localization" and active["lane"] == "C" else "PRODUCING"
    slot.runs += 1
    slot.last_sent_at = now.isoformat()
    note_successful_request(reg, now, slot.name)
    publish_lane(active)
    save_registry(reg)
    return True


async def reconcile_active(reg: Registry, active: dict, head: str) -> bool:
    path = active["asset_path"]
    if active["lane"] in {"A", "B"}:
        if active.get("selection_mode") == "autonomous":
            known = active.get("known_candidates", {})
            eligible = {item["asset_path"] for item in active.get("asset_options", [])}
            for selected_path, record in reg.artifact_records.items():
                sha = record.get("candidate_sha")
                if (selected_path not in eligible or record.get("lane") != active["lane"] or
                        record.get("state") != "QA_PENDING" or not sha or known.get(selected_path) == sha):
                    continue
                comparison = await asyncio.to_thread(github_api_json,
                    f"/repos/{GITHUB_REPO}/compare/{active['base_sha']}...{sha}")
                if comparison.get("status") != "ahead":
                    continue
                # Bind ownership to the actual chosen material asset only now.
                active.update(asset_path=selected_path, artifact_sha=record["artifact_sha"], result_sha=sha)
                enqueue_candidate(reg, record)
                reg.active_lanes.pop(active["lane"], None)
                reg.producer_cooldowns.pop(active["lane"], None)
                publish_lane(record)
                return True
            return False
        record = reg.artifact_records.get(path, {})
        if record.get("candidate_sha") and record.get("candidate_sha") != active.get("previous_candidate_sha"):
            if record.get("state") == "QA_PENDING":
                enqueue_candidate(reg, record)
                reg.active_lanes.pop(active["lane"], None)
                publish_lane(record)
                return True
        return False
    current = reg.artifact_records.get(path, {})
    if (current.get("candidate_sha") != active["candidate_sha"] or
            current.get("reason") == "Candidate bytes changed without a new manifest"):
        reg.active_lanes.pop("C", None)
        return True
    result = await asyncio.to_thread(read_qa_result, active, head)
    if result is None:
        return False
    active.update(state="WAIT_GATE", disposition=result["status"], result_sha=result["result_sha"],
                  gate_started_at=datetime.now(TZ).isoformat())
    message = await asyncio.to_thread(github_commit_message, active["result_sha"])
    if message is None:
        raise RuntimeError("Cannot read QA commit")
    if github_actions_skip_directive(message):
        block_lane(reg, active, "QA commit contains GitHub Actions skip directive")
    publish_lane(active)
    return True


async def observe_lane(context, pages, reg: Registry, active: dict, head: str):
    if active["state"] == "WAIT_GATE":
        await poll_gate(reg, active)
        return
    if CONTROLLER_MODE == "localization" and await reconcile_active(reg, active, head):
        return
    slot = next(s for s in reg.slots if s.name == active["lane"])
    if not active.get("chat_url"):
        # Check Git evidence first (above), then fail closed on an ambiguous send.
        block_lane(reg, active, "No persisted chat URL; send not repeated")
        return
    slot.url = active["chat_url"]
    page = await slot_page(context, pages, slot)
    now = datetime.now(TZ)
    if await detect_rate_limit(page):
        if not rate_limit_active(reg, now):
            mark_rate_limit(reg, now, "lane-observation")
        return
    if await detect_conversation_limit(page):
        block_lane(reg, active, "Conversation unavailable; asset and SHA checkpoint preserved")
        return
    busy = await detect_busy(page)
    response = await last_assistant_text(page)
    digest = stable_hash(response) if response else ""
    if digest != active.get("assistant_hash"):
        active.update(assistant_hash=digest, response_changed_at=now.isoformat())
        if response:
            clear_rate_limit_after_response(reg)
    if busy:
        return
    # Only the existing generation may be continued; no prompt re-dispatch loop.
    if await click_continue_generating(page):
        return
    changed = datetime.fromisoformat(active["response_changed_at"])
    if (now - changed).total_seconds() < QUEUE_STABLE_SECONDS:
        return
    if CONTROLLER_MODE == "conversion" and response:
        match = re.search(r"(?m)^RESULT_SHA\s*=\s*([0-9a-f]{40})\s*$", response)
        if match:
            sha = match.group(1)
            compare = await asyncio.to_thread(github_api_json,
                f"/repos/{GITHUB_REPO}/compare/{active['base_sha']}...{sha}")
            reach = await asyncio.to_thread(github_api_json,
                f"/repos/{GITHUB_REPO}/compare/{sha}...{head}")
            if compare.get("status") == "ahead" and compare.get("files") and reach.get("status") in {"ahead", "identical"}:
                active.update(state="WAIT_GATE", result_sha=sha, gate_started_at=now.isoformat())
                publish_lane(active)
                return
    if (now - datetime.fromisoformat(active["sent_at"])).total_seconds() < QUEUE_RESULT_GRACE_SECONDS:
        return
    reason = ("Assistant finished without verified material evidence" if response else
              "No assistant response was detected before the queue result grace period expired")
    block_lane(reg, active, reason)


def new_producer(options: list[dict], lane: str, head: str, reg: Registry) -> dict:
    return {"lane": lane, "asset_path": "", "artifact_sha": "", "state": "SELECTING",
            "selection_mode": "autonomous", "asset_options": options,
            "known_candidates": {p: r.get("candidate_sha") for p, r in reg.artifact_records.items()},
            "base_sha": head, "result_sha": "",
            "branch": LOCALIZATION_BRANCH, "workflow": "Localization Automation Gate"}


async def localization_cycle(context, pages, reg: Registry):
    head = await asyncio.to_thread(github_branch_head, LOCALIZATION_BRANCH)
    if not head:
        raise RuntimeError("Cannot resolve authoritative localization HEAD")
    await asyncio.to_thread(reconcile_assets, reg, head)
    # Resume from asset/SHA evidence before considering new sends.
    for lane in ("C", "A", "B"):
        active = reg.active_lanes.get(lane)
        if active:
            await observe_lane(context, pages, reg, active, head)
            save_registry(reg)
    if not AUTO_SEND:
        return
    # C gets the next available slot; it never waits for both producers.
    if "C" not in reg.active_lanes and len(reg.active_lanes) < MAX_ACTIVE_LANES:
        for item in reg.qa_queue:
            current = reg.artifact_records.get(item["asset_path"], {})
            if current.get("state") == "BLOCKED" and not current.get("reason", "").startswith(("Actions run ", "Exact-SHA Actions")):
                continue
            active = {**item, "lane": "C", "state": "READY", "base_sha": head,
                      "result_sha": "", "branch": LOCALIZATION_BRANCH,
                      "workflow": "Localization Automation Gate"}
            # Existing QA commit is adopted on restart without a second C chat.
            if await reconcile_active(reg, active, head):
                if active["state"] == "WAIT_GATE":
                    reg.active_lanes["C"] = active
                break
            await dispatch_lane(context, pages, reg, active)
            break
    rows = await asyncio.to_thread(load_asset_rows, head)
    for lane in ("A", "B"):
        if lane in reg.active_lanes or len(reg.active_lanes) >= MAX_ACTIVE_LANES:
            continue
        cooldown = _parse_iso(reg.producer_cooldowns.get(lane))
        if cooldown and datetime.now(TZ) < cooldown:
            continue
        options = producer_options(rows, lane, reg)
        if options:
            await dispatch_lane(context, pages, reg, new_producer(options, lane, head, reg))
    save_registry(reg)


async def conversion_cycle(context, pages, reg: Registry):
    # Separate branch-level conversion work retains its own mode and volume.
    for lane, branch in (("A", "vr-dx11-native-r71"), ("B", "vr-dxvk-r71-disasm"), ("C", "vr-d3d9ex-focus")):
        head = await asyncio.to_thread(github_branch_head, branch)
        if not head:
            continue
        active = reg.active_lanes.get(lane)
        if active:
            await observe_lane(context, pages, reg, active, head)
            continue
        if not AUTO_SEND:
            continue
        asset = "branches/" + branch
        previous = reg.artifact_records.get(asset, {})
        if previous.get("state") == "BLOCKED":
            continue
        workflow = "DX9Ex Active Validation" if lane == "C" else "Backend Conversion Gate"
        active = {"lane": lane, "asset_path": asset, "artifact_sha": "", "state": "READY",
                  "base_sha": head, "result_sha": "", "branch": branch,
                  "workflow": workflow}
        await dispatch_lane(context, pages, reg, active)
    save_registry(reg)



# A tab renderer can crash without closing the shared Chrome/CDP session.  Keep
# the visible Chrome/noVNC browser, and heal only the affected per-slot page.
TAB_HEALTH_CHECK_SECONDS = max(10, int(os.getenv("TAB_HEALTH_CHECK_SECONDS", "30")))
TAB_HEALTH_PROBE_TIMEOUT_SECONDS = max(2, int(os.getenv("TAB_HEALTH_PROBE_TIMEOUT_SECONDS", "6")))
TAB_HEALTH_FAILURE_THRESHOLD = max(2, int(os.getenv("TAB_HEALTH_FAILURE_THRESHOLD", "3")))
TAB_RECOVERY_COOLDOWN_SECONDS = max(15, int(os.getenv("TAB_RECOVERY_COOLDOWN_SECONDS", "60")))


def _watch_slot_page_health(page: Page, slot_name: str, state: dict) -> None:
    tracked = state.setdefault("tracked", {})
    if tracked.get(slot_name) is page:
        return
    tracked[slot_name] = page
    state.setdefault("failures", {})[slot_name] = 0
    # Playwright "crash" fires on a renderer crash; "close" is also handled by
    # is_closed(), but intentional page rotation is not mistaken for a crash.
    page.on("crash", lambda *_args, observed_page=page: state.setdefault("crashed", set()).add(observed_page))


async def monitor_slot_tab_health(context: BrowserContext, pages: dict[str, Page], state: dict) -> None:
    """Detect failed tab renderers and reopen persisted chats without sending prompts.

    Never alter TASK_ID, queue phase, registry send counters, or saved chat URLs.
    The normal queue engine alone decides whether further sending is permitted.
    """
    now = datetime.now(TZ)
    browser = context.browser
    if browser is not None and not browser.is_connected():
        raise RuntimeError("Browser has been closed; Docker restart must recover CDP")
    reg = load_registry(now)
    for slot in reg.slots:
        page = pages.get(slot.name)
        if page is None:
            # Let the existing slot_page() function create missing tabs.
            continue
        _watch_slot_page_health(page, slot.name, state)
        crashed = state.setdefault("crashed", set())
        failures = state.setdefault("failures", {})
        reason = None
        try:
            closed = page.is_closed()
        except Exception:
            closed = True
        if closed:
            reason = "closed"
        elif page in crashed:
            reason = "renderer_crash"
        else:
            try:
                await asyncio.wait_for(
                    page.evaluate("() => 1"), timeout=TAB_HEALTH_PROBE_TIMEOUT_SECONDS
                )
                failures[slot.name] = 0
            except Exception as exc:
                if browser is not None and not browser.is_connected():
                    raise RuntimeError("Browser has been closed during tab probe") from exc
                failures[slot.name] = failures.get(slot.name, 0) + 1
                if failures[slot.name] >= TAB_HEALTH_FAILURE_THRESHOLD:
                    reason = "unresponsive"
                else:
                    log.warning("tab health probe failed slot=%s attempt=%s: %r",
                                slot.name, failures[slot.name], exc)
        if reason is None:
            continue

        last = state.setdefault("last_recovered", {}).get(slot.name, 0.0)
        if time.monotonic() - last < TAB_RECOVERY_COOLDOWN_SECONDS:
            continue
        state["last_recovered"][slot.name] = time.monotonic()
        target = slot.url if slot.url and is_project_scoped_chat_url(slot.url) else BASE_URL
        log.error("slot tab recovery slot=%s reason=%s target=%s", slot.name, reason, target)
        # Preserve a visual diagnostic where Chromium still permits screenshots.
        if not closed:
            try:
                screenshot_dir = Path("/logs/tab-recovery")
                screenshot_dir.mkdir(parents=True, exist_ok=True)
                screenshot = screenshot_dir / (
                    f"{now.strftime('%Y%m%dT%H%M%S')}-{slot.name}-{reason}.png"
                )
                await asyncio.wait_for(page.screenshot(path=str(screenshot), timeout=2500), timeout=3)
            except Exception:
                log.info("slot=%s could not capture crashed tab screenshot", slot.name)
            try:
                await asyncio.wait_for(page.close(run_before_unload=False), timeout=4)
            except Exception:
                log.warning("slot=%s crashed tab could not close; replacing reference", slot.name)
        crashed.discard(page)
        replacement = await context.new_page()
        pages[slot.name] = replacement
        _watch_slot_page_health(replacement, slot.name, state)
        try:
            await replacement.goto(target, wait_until="domcontentloaded", timeout=45000)
        except Exception as exc:
            failures[slot.name] = TAB_HEALTH_FAILURE_THRESHOLD
            write_runtime(tab_recovery_error=f"{slot.name}:{reason}:{type(exc).__name__}",
                          tab_recovery_error_at=now.isoformat())
            log.exception("slot=%s recovery navigation failed; saved TASK_ID/chat retained", slot.name)
            # A disconnected CDP must restart the whole controller; a transient
            # navigation error must not trigger a duplicate message submission.
            if browser is not None and not browser.is_connected():
                raise RuntimeError("Browser has been closed during tab recovery") from exc
            continue
        failures[slot.name] = 0
        count = int(runtime.get("tab_recovery_count") or 0) + 1
        write_runtime(tab_recovery_count=count, tab_recovery_last_at=now.isoformat(),
                      tab_recovery_last_slot=slot.name, tab_recovery_last_reason=reason,
                      tab_recovery_error=None)
        log.warning("recovered slot=%s reason=%s with original conversation URL", slot.name, reason)


async def scheduler_loop(context: BrowserContext, pages: dict[str, Page], once: bool):
    reg = load_registry(datetime.now(TZ))
    tab_health_state: dict = {}
    last_tab_health_check = 0.0
    while True:
        now = datetime.now(TZ)
        if time.monotonic() - last_tab_health_check >= TAB_HEALTH_CHECK_SECONDS:
            last_tab_health_check = time.monotonic()
            await monitor_slot_tab_health(context, pages, tab_health_state)

        write_runtime(queue_loop_heartbeat_at=now.isoformat(), status="running" if AUTO_SEND else "manual_mode")
        try:
            if CONTROLLER_MODE == "localization":
                await localization_cycle(context, pages, reg)
            else:
                await conversion_cycle(context, pages, reg)
        except Exception as exc:
            log.exception("asset cycle failed; checkpoint retained")
            write_runtime(status="blocked", last_error=str(exc))
            # Keep prior durable state on partial network failure. No false PASS.
        if once:
            return
        await asyncio.sleep(QUEUE_CHECK_SECONDS)



async def main_async(once: bool):
    start_status_server()
    write_runtime(status="browser_connecting", last_action="Attaching controller to Chrome DevTools")
    async with async_playwright() as p:
        browser = None
        for _ in range(60):
            try:
                browser = await p.chromium.connect_over_cdp("http://127.0.0.1:9222")
                break
            except Exception:
                await asyncio.sleep(1)
        if browser is None:
            raise RuntimeError("Could not attach to Google Chrome on CDP port 9222")

        context = browser.contexts[0] if browser.contexts else await browser.new_context()
        write_runtime(status="browser_attached", last_action="Chrome attached; restoring queue/chat state")
        reg = load_registry(datetime.now(TZ))
        pages = await prepare_slot_pages(context, reg)
        write_runtime(status="controller_ready", last_action="Queue/chat state restored; checking login and starting scheduler")

        # Login check on slot A tab; session is shared by all tabs.
        first_page = pages[reg.slots[0].name]
        if not await ensure_logged_in(first_page):
            write_runtime(status="login_required", last_action="Open noVNC and log in to ChatGPT")
        await scheduler_loop(context, pages, once=once)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--once", action="store_true", help="run one review cycle immediately")
    args = parser.parse_args()
    try:
        asyncio.run(main_async(args.once))
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()




