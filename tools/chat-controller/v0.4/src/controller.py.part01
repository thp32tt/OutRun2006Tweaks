
THINKING_LABEL_ALIASES = {
    "Instant": ["Instant", "즉시"],
    "Medium": ["Medium", "중간"],
    "High": ["High", "높음"],
    "Extra High": ["Extra High", "매우 높음", "최고"],
}
ALL_THINKING_LABELS = [x for values in THINKING_LABEL_ALIASES.values() for x in values]


async def visible_exact_text(page: Page, text: str):
    """Return a visible element whose rendered text exactly matches text."""
    candidates = [
        page.get_by_role("button", name=text, exact=True),
        page.get_by_role("menuitem", name=text, exact=True),
        page.get_by_role("option", name=text, exact=True),
        page.get_by_text(text, exact=True),
    ]
    for loc in candidates:
        try:
            count = await loc.count()
            for i in range(min(count, 8)):
                item = loc.nth(i)
                if await item.is_visible(timeout=250):
                    return item
        except Exception:
            continue
    return None


async def _visible_items(locator, limit: int = 30):
    items = []
    try:
        count = await locator.count()
        for i in range(min(count, limit)):
            item = locator.nth(i)
            try:
                if await item.is_visible(timeout=150):
                    items.append(item)
            except Exception:
                continue
    except Exception:
        pass
    return items


async def _thinking_menu_state(page: Page, aliases: list[str]):
    """Inspect the currently open menu/popover for a reasoning slider or level item."""
    # Slider variant.
    slider_selectors = [
        "[data-model-reasoning-effort-slider] [role='slider']",
        "[role='menu'] [role='slider']",
        "[role='listbox'] [role='slider']",
        "[role='dialog'] [role='slider']",
        "[data-radix-menu-content] [role='slider']",
    ]
    for sel in slider_selectors:
        for item in await _visible_items(page.locator(sel), 10):
            return {"slider": item, "option": None}

    # Menu/radio variant.
    containers = [
        page.locator("[role='menu']:visible"),
        page.locator("[role='listbox']:visible"),
        page.locator("[role='dialog']:visible"),
        page.locator("[data-radix-menu-content]:visible"),
        page.locator("[data-radix-popper-content-wrapper]:visible"),
    ]
    for container in containers:
        try:
            if not await container.count():
                continue
            root = container.last
            text = (await root.inner_text(timeout=700)).lower()
            has_reasoning_levels = (
                ("instant" in text or "즉시" in text)
                and ("medium" in text or "중간" in text)
                and ("high" in text or "높음" in text)
            )
            if not has_reasoning_levels:
                continue

            for label in aliases:
                candidates = [
                    root.get_by_role("menuitemradio", name=label, exact=True),
                    root.get_by_role("menuitem", name=label, exact=True),
                    root.get_by_role("option", name=label, exact=True),
                    root.get_by_text(label, exact=True),
                ]
                for loc in candidates:
                    for item in await _visible_items(loc, 8):
                        return {"slider": None, "option": item}
        except Exception:
            continue

    return {"slider": None, "option": None}


async def _candidate_thinking_controls(page: Page):
    selectors = [
        "form button.__composer-pill[aria-haspopup]",
        "form button[aria-haspopup='menu']",
        "form button[aria-haspopup='listbox']",
        "button[data-testid='model-switcher-dropdown-button']",
        "button[data-testid*='model'][aria-haspopup]",
        "button[aria-label*='thinking' i]",
        "button[aria-label*='reasoning' i]",
        "button[aria-label*='model' i]",
        "button[title*='thinking' i]",
        "button[title*='reasoning' i]",
        "button[title*='model' i]",
        "header button[aria-haspopup='menu']",
    ]

    seen = set()
    result = []
    for sel in selectors:
        try:
            loc = page.locator(sel)
            count = await loc.count()
            # Prefer controls nearest the composer / later in DOM.
            for i in range(count - 1, -1, -1):
                item = loc.nth(i)
                try:
                    if not await item.is_visible(timeout=150):
                        continue
                    key = await item.evaluate("(el) => el.outerHTML.slice(0,500)")
                    if key in seen:
                        continue
                    seen.add(key)
                    result.append(item)
                except Exception:
                    continue
        except Exception:
            continue
    return result


async def open_thinking_control(page: Page, aliases: list[str]):
    """Find the actual reasoning control by opening candidate menus and inspecting content."""
    controls = await _candidate_thinking_controls(page)
    for control in controls[:20]:
        try:
            await control.click(force=True, timeout=2500)
            await page.wait_for_timeout(350)

            state = await _thinking_menu_state(page, aliases)
            if state["slider"] or state["option"]:
                return control, state

            await page.keyboard.press("Escape")
            await page.wait_for_timeout(100)
        except Exception:
            try:
                await page.keyboard.press("Escape")
            except Exception:
                pass
            continue

    return None, {"slider": None, "option": None}


async def read_slider_state(slider):
    try:
        raw_min = await slider.get_attribute("aria-valuemin")
        raw_max = await slider.get_attribute("aria-valuemax")
        raw_now = await slider.get_attribute("aria-valuenow")
        if raw_min is None or raw_max is None or raw_now is None:
            return None
        vmin, vmax, now = int(raw_min), int(raw_max), int(raw_now)
        if vmax < vmin or now < vmin or now > vmax:
            return None
        return vmin, vmax, now
    except Exception:
        return None


async def _control_text_has_level(control, aliases: list[str]) -> bool:
    try:
        text = (await control.inner_text(timeout=500)).strip().lower()
        aria = ((await control.get_attribute("aria-label")) or "").strip().lower()
        title = ((await control.get_attribute("title")) or "").strip().lower()
        combined = " ".join((text, aria, title))
        return any(label.lower() in combined for label in aliases)
    except Exception:
        return False


async def _selected_option_matches(page: Page, aliases: list[str]) -> bool:
    selectors = [
        "[role='menuitemradio'][aria-checked='true']",
        "[role='option'][aria-selected='true']",
        "[role='menuitem'][data-state='checked']",
        "[role='menuitemradio'][data-state='checked']",
    ]
    for sel in selectors:
        for item in await _visible_items(page.locator(sel), 20):
            try:
                text = (await item.inner_text(timeout=400)).strip().lower()
                if any(label.lower() == text or label.lower() in text for label in aliases):
                    return True
            except Exception:
                continue
    return False


async def ensure_thinking_level(page: Page, requested: str = PREFERRED_THINKING_LEVEL) -> bool:
    """Set High using either the current slider UI or menu/radio UI, then verify."""
    requested = requested.strip() or "High"
    aliases = THINKING_LABEL_ALIASES.get(requested, [requested])
    target_offset = {
        "Instant": 0,
        "Medium": 1,
        "High": 2,
        "Extra High": 3,
    }.get(requested)

    if target_offset is None:
        write_runtime(last_thinking_level_result=f"unsupported_level:{requested}")
        return False

    control, state = await open_thinking_control(page, aliases)
    if not control:
        write_runtime(last_thinking_level_result=f"picker_not_found:{requested}")
        return False

    slider = state.get("slider")
    option = state.get("option")

    if slider:
        slider_state = await read_slider_state(slider)
        if not slider_state:
            try:
                await page.keyboard.press("Escape")
            except Exception:
                pass
            write_runtime(last_thinking_level_result=f"slider_state_invalid:{requested}")
            return False

        vmin, vmax, now = slider_state
        target = vmin + target_offset
        if target > vmax:
            try:
                await page.keyboard.press("Escape")
            except Exception:
                pass
            write_runtime(last_thinking_level_result=f"level_unavailable:{requested}:{vmin}-{vmax}")
            return False

        if now != target:
            try:
                await slider.evaluate("(el) => el.focus()")
                await page.keyboard.press("Home")
                await page.wait_for_timeout(100)
                for _ in range(target_offset):
                    await page.keyboard.press("ArrowRight")
                    await page.wait_for_timeout(100)
            except Exception:
                log.exception("reasoning slider selection failed")
                try:
                    await page.keyboard.press("Escape")
                except Exception:
                    pass
                write_runtime(last_thinking_level_result=f"selection_failed:{requested}")
                return False

        verified_state = await read_slider_state(slider)
        verified = bool(verified_state and verified_state[2] == target)
        try:
            await page.keyboard.press("Escape")
        except Exception:
            pass

        if verified:
            write_runtime(last_thinking_level_result=f"verified:{requested}:slider")
            return True

        write_runtime(last_thinking_level_result=f"verify_failed:{requested}:slider")
        return False

    if option:
        try:
            # If already checked/selected, no click is required.
            checked = (await option.get_attribute("aria-checked")) == "true"
            selected = (await option.get_attribute("aria-selected")) == "true"
            state_attr = (await option.get_attribute("data-state")) or ""
            if not (checked or selected or state_attr == "checked"):
                await option.click(force=True, timeout=2500)
                await page.wait_for_timeout(500)
        except Exception:
            log.exception("reasoning menu option selection failed")
            write_runtime(last_thinking_level_result=f"selection_failed:{requested}:menu")
            return False

        # Verification path 1: the closed control itself now names the selected level.
        if await _control_text_has_level(control, aliases):
            write_runtime(last_thinking_level_result=f"verified:{requested}:control")
            return True

        # Verification path 2: reopen the same menu and inspect checked/selected state.
        try:
            await control.click(force=True, timeout=2500)
            await page.wait_for_timeout(300)
            verified = await _selected_option_matches(page, aliases)
            await page.keyboard.press("Escape")
            if verified:
                write_runtime(last_thinking_level_result=f"verified:{requested}:menu")
                return True
        except Exception:
            try:
                await page.keyboard.press("Escape")
            except Exception:
                pass

        write_runtime(last_thinking_level_result=f"verify_failed:{requested}:menu")
        return False

    try:
        await page.keyboard.press("Escape")
    except Exception:
        pass
    write_runtime(last_thinking_level_result=f"thinking_ui_not_found:{requested}")
    return False


async def send_message(page: Page, message: str) -> bool:
    box = await first_visible(page, INPUT_SELECTORS)
    if not box:
        return False
    try:
        tag = await box.evaluate("el => el.tagName")
        if tag.lower() == "textarea":
            await box.fill(message)
        else:
            await box.click()
            await page.keyboard.press("Control+A")
            await page.keyboard.type(message, delay=1)
        await page.keyboard.press("Enter")
        await page.wait_for_timeout(1500)
        return True
    except Exception:
        log.exception("message send failed")
        return False


async def wait_for_chat_url(page: Page, timeout_sec: int = 30) -> Optional[str]:
    deadline = time.time() + timeout_sec
    while time.time() < deadline:
        if "/c/" in page.url:
            return page.url
        await page.wait_for_timeout(500)
    return page.url if "/c/" in page.url else None


async def previous_run_still_busy(page: Page, reg: Registry) -> bool:
    if not any(s.last_sent_at for s in reg.slots):
        return False
    prev_idx = (reg.next_slot - 1) % len(reg.slots)
    prev = reg.slots[prev_idx]
    if not prev.url:
        return False
    try:
        await page.goto(prev.url, wait_until="domcontentloaded", timeout=60000)
        await page.wait_for_timeout(1200)
        return await detect_busy(page)
