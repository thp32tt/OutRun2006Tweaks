
THINKING_LABEL_ALIASES = {
    "Instant": ["Instant", "즉시"],
    "Medium": ["Medium", "중간"],
    "High": ["High", "높음"],
    "Extra High": ["Extra High", "매우 높음", "최고"],
}
ALL_THINKING_LABELS = [x for values in THINKING_LABEL_ALIASES.values() for x in values]


async def visible_exact_text(page: Page, text: str):
    """Return a visible element whose rendered text exactly matches text."""
    candidates = [
        page.get_by_role("button", name=text, exact=True),
        page.get_by_role("menuitem", name=text, exact=True),
        page.get_by_role("option", name=text, exact=True),
        page.get_by_text(text, exact=True),
    ]
    for loc in candidates:
        try:
            count = await loc.count()
            for i in range(min(count, 8)):
                item = loc.nth(i)
                if await item.is_visible(timeout=250):
                    return item
        except Exception:
            continue
    return None


async def find_thinking_control(page: Page):
    """Locate the current ChatGPT composer reasoning/model pill."""
    selectors = [
        "form button.__composer-pill[aria-haspopup='menu']",
        "button.__composer-pill[aria-haspopup='menu']",
        "form button[aria-haspopup='menu'][data-tone='neutral']",
        "button[data-testid='model-switcher-dropdown-button'][aria-haspopup='menu']",
        "button[aria-label*='thinking' i]",
        "button[aria-label*='reasoning' i]",
        "button[aria-label*='model' i]",
    ]
    for sel in selectors:
        try:
            loc = page.locator(sel)
            count = await loc.count()
            for i in range(count - 1, -1, -1):
                item = loc.nth(i)
                if await item.is_visible(timeout=250):
                    return item
        except Exception:
            continue
    return None


async def open_thinking_slider(page: Page):
    control = await find_thinking_control(page)
    if not control:
        return None, None

    try:
        expanded = await control.get_attribute("aria-expanded")
        state = await control.get_attribute("data-state")
        if expanded != "true" and state != "open":
            await control.click(force=True, timeout=3000)
    except Exception:
        try:
            await control.press("Enter")
        except Exception:
            return control, None

    deadline = time.time() + 5
    while time.time() < deadline:
        try:
            container = page.locator("[data-model-reasoning-effort-slider]").last
            if await container.count() and await container.is_visible(timeout=250):
                slider = container.locator("[role='slider']").first
                if await slider.count():
                    return control, slider
        except Exception:
            pass
        await page.wait_for_timeout(100)

    return control, None


async def read_slider_state(slider):
    try:
        raw_min = await slider.get_attribute("aria-valuemin")
        raw_max = await slider.get_attribute("aria-valuemax")
        raw_now = await slider.get_attribute("aria-valuenow")
        if raw_min is None or raw_max is None or raw_now is None:
            return None
        vmin, vmax, now = int(raw_min), int(raw_max), int(raw_now)
        if vmax < vmin or now < vmin or now > vmax:
            return None
        return vmin, vmax, now
    except Exception:
        return None


async def current_thinking_level(page: Page) -> Optional[str]:
    control, slider = await open_thinking_slider(page)
    if not slider:
        return None
    try:
        state = await read_slider_state(slider)
        if not state:
            return None
        vmin, vmax, now = state
        offset = now - vmin
        mapping = {0: "Instant", 1: "Medium", 2: "High", 3: "Extra High"}
        return mapping.get(offset)
    finally:
        try:
            await page.keyboard.press("Escape")
        except Exception:
            pass


async def ensure_thinking_level(page: Page, requested: str = PREFERRED_THINKING_LEVEL) -> bool:
    """Select and positively verify the current ChatGPT reasoning slider."""
    requested = requested.strip() or "High"
    target_offset = {
        "Instant": 0,
        "Medium": 1,
        "High": 2,
        "Extra High": 3,
    }.get(requested)
    if target_offset is None:
        write_runtime(last_thinking_level_result=f"unsupported_level:{requested}")
        return False

    control, slider = await open_thinking_slider(page)
    if not control:
        write_runtime(last_thinking_level_result=f"picker_not_found:{requested}")
        return False
    if not slider:
        try:
            await page.keyboard.press("Escape")
        except Exception:
            pass
        write_runtime(last_thinking_level_result=f"slider_not_found:{requested}")
        return False

    state = await read_slider_state(slider)
    if not state:
        try:
            await page.keyboard.press("Escape")
        except Exception:
            pass
        write_runtime(last_thinking_level_result=f"slider_state_invalid:{requested}")
        return False

    vmin, vmax, now = state
    target = vmin + target_offset
    if target > vmax:
        try:
            await page.keyboard.press("Escape")
        except Exception:
            pass
        write_runtime(last_thinking_level_result=f"level_unavailable:{requested}:{vmin}-{vmax}")
        return False

    if now != target:
        try:
            # The semantic slider can be zero-width/aria-hidden, but it still receives
            # keyboard events when focused programmatically.
            await slider.evaluate("(el) => el.focus()")
            # Move deterministically to the minimum, then to the requested offset.
            for _ in range(max(1, vmax - vmin + 1)):
                await page.keyboard.press("ArrowLeft")
                await page.wait_for_timeout(40)
            for _ in range(target_offset):
                await page.keyboard.press("ArrowRight")
                await page.wait_for_timeout(80)
        except Exception:
            log.exception("reasoning slider keyboard selection failed")
            try:
                await page.keyboard.press("Escape")
            except Exception:
                pass
            write_runtime(last_thinking_level_result=f"selection_failed:{requested}")
            return False

    # Positive verification from the slider's actual ARIA value.
    verified_state = await read_slider_state(slider)
    verified = bool(verified_state and verified_state[2] == target)
    observed = verified_state[2] if verified_state else None

    try:
        await page.keyboard.press("Escape")
    except Exception:
        pass

    write_runtime(
        last_thinking_level_result=(
            f"verified:{requested}:{target}" if verified
            else f"verify_failed:{requested}:target={target}:observed={observed}"
        )
    )
    return verified


async def send_message(page: Page, message: str) -> bool:
    box = await first_visible(page, INPUT_SELECTORS)
    if not box:
        return False
    try:
        tag = await box.evaluate("el => el.tagName")
        if tag.lower() == "textarea":
            await box.fill(message)
        else:
            await box.click()
            await page.keyboard.press("Control+A")
            await page.keyboard.type(message, delay=1)
        await page.keyboard.press("Enter")
        await page.wait_for_timeout(1500)
        return True
    except Exception:
        log.exception("message send failed")
        return False


async def wait_for_chat_url(page: Page, timeout_sec: int = 30) -> Optional[str]:
    deadline = time.time() + timeout_sec
    while time.time() < deadline:
        if "/c/" in page.url:
            return page.url
        await page.wait_for_timeout(500)
    return page.url if "/c/" in page.url else None


async def previous_run_still_busy(page: Page, reg: Registry) -> bool:
    if not any(s.last_sent_at for s in reg.slots):
        return False
    prev_idx = (reg.next_slot - 1) % len(reg.slots)
    prev = reg.slots[prev_idx]
    if not prev.url:
        return False
    try:
        await page.goto(prev.url, wait_until="domcontentloaded", timeout=60000)
        await page.wait_for_timeout(1200)
        return await detect_busy(page)
