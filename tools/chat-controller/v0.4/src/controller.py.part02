        log.exception("failed to inspect previous slot")
        return True


def stable_hash(text: str) -> str:
    import hashlib
    return hashlib.sha256(text.encode("utf-8", errors="ignore")).hexdigest()


async def last_assistant_text(page: Page) -> str:
    for sel in ASSISTANT_MESSAGE_SELECTORS:
        try:
            loc = page.locator(sel)
            count = await loc.count()
            if count:
                return (await loc.nth(count - 1).inner_text(timeout=2000)).strip()
        except Exception:
            continue
    return ""


async def click_continue_generating(page: Page) -> bool:
    loc = await first_visible(page, CONTINUE_GENERATING_SELECTORS)
    if not loc:
        return False
    try:
        await loc.click()
        await page.wait_for_timeout(1000)
        return True
    except Exception:
        log.exception("continue-generating click failed")
        return False


async def click_retry_generation(page: Page) -> bool:
    loc = await first_visible(page, RETRY_SELECTORS)
    if not loc:
        return False
    try:
        await loc.click()
        await page.wait_for_timeout(1000)
        return True
    except Exception:
        log.exception("retry click failed")
        return False


async def click_stop_generating(page: Page) -> bool:
    loc = await first_visible(page, BUSY_SELECTORS)
    if not loc:
        return False
    try:
        await loc.click()
        await page.wait_for_timeout(3000)
        return True
    except Exception:
        log.exception("stop-generating click failed")
        return False


def minutes_since(value: Optional[str], now: datetime) -> Optional[float]:
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(value)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=TZ)
        return (now - dt.astimezone(TZ)).total_seconds() / 60.0
    except Exception:
        return None


async def prepare_slot_pages(context: BrowserContext, reg: Registry) -> dict[str, Page]:
    """Create and keep one persistent Chrome tab per A~F review slot."""
    pages: dict[str, Page] = {}
    available = [p for p in context.pages if not p.is_closed()]

    # First reuse tabs that already match persisted chat URLs.
    used = set()
    for slot in reg.slots:
        if not slot.url:
            continue
        for page in available:
            if page in used:
                continue
            try:
                if page.url == slot.url or ("/c/" in page.url and page.url.rstrip("/") == slot.url.rstrip("/")):
                    pages[slot.name] = page
                    used.add(page)
                    break
            except Exception:
                continue

    # Reuse remaining existing tabs, then create new tabs until every slot has one.
    leftovers = [p for p in available if p not in used]
    for slot in reg.slots:
        if slot.name in pages:
            continue
        page = leftovers.pop(0) if leftovers else await context.new_page()
        pages[slot.name] = page
        used.add(page)

    # Close surplus controller tabs after a slot-count reduction so they do not keep
    # consuming Chrome/N100 resources.
    surplus = [p for p in available if p not in used]
    for page in surplus:
        try:
            await page.close()
        except Exception:
            log.exception("failed to close surplus controller tab")

    # Put each tab on its own persisted chat URL or a clean ChatGPT home page.
    for slot in reg.slots:
        page = pages[slot.name]
        target = slot.url or BASE_URL
        try:
            if not page.url or page.url == "about:blank" or page.url.rstrip("/") != target.rstrip("/"):
                await page.goto(target, wait_until="domcontentloaded", timeout=60000)
                await page.wait_for_timeout(500)
        except Exception:
            log.exception("slot tab initialization failed slot=%s target=%s", slot.name, target)

    write_runtime(
        tab_mode="fresh_per_run" if FRESH_CHAT_EACH_RUN else "dedicated_per_slot",
        tab_count=len(pages),
        slot_tabs={name: page.url for name, page in pages.items()},
    )
    log.info("prepared %s dedicated tabs: %s", len(pages), ",".join(sorted(pages)))
    return pages


async def slot_page(context: BrowserContext, pages: dict[str, Page], slot: Slot) -> Page:
    page = pages.get(slot.name)
    if page is None or page.is_closed():
        page = await context.new_page()
        pages[slot.name] = page
        await page.goto(slot.url or BASE_URL, wait_until="domcontentloaded", timeout=60000)
    return page


async def replace_with_fresh_slot_page(context: BrowserContext, pages: dict[str, Page], slot: Slot) -> Page:
    """Start each scheduled N100 run in a brand-new tab/chat and close the previous one."""
    old = pages.get(slot.name)
    if old is not None and not old.is_closed():
        try:
            await old.close()
        except Exception:
            log.exception("failed to close previous slot tab slot=%s", slot.name)

    page = await context.new_page()
    pages[slot.name] = page
    slot.url = None
    slot.last_assistant_hash = None
    slot.last_assistant_change_at = None
    slot.last_watchdog_at = None
    slot.watchdog_resumes_since_schedule = 0
    await page.goto(BASE_URL, wait_until="domcontentloaded", timeout=60000)
    await page.wait_for_timeout(700)
    return page


def prompt_for_slot(slot: Slot, phase: str) -> str:
    """Use fix-worker prompts only for dedicated N100 slot D."""
    if slot.name == "D":
        mapping = {
            "bootstrap": "bootstrap_fix.md",
            "continue": "continue_fix.md",
            "watchdog": "watchdog_fix.md",
        }
    else:
        mapping = {
            "bootstrap": "bootstrap_review.md",
            "continue": "continue_review.md",
            "watchdog": "watchdog_resume.md",
        }
    return read_prompt(mapping[phase])


async def watchdog_cycle(context: BrowserContext, pages: dict[str, Page]):
    if not WATCHDOG_ENABLED or not AUTO_SEND:
        return
    now = datetime.now(TZ)
    reg = load_registry(now)
    guard = send_guard_reason(reg, None, now)
    if guard and guard.startswith("rate_limit_backoff:"):
        write_runtime(
            status="rate_limited_backoff",
            last_action=f"Watchdog paused by {guard}",
            rate_limit_attempts=reg.rate_limit_attempts,
            rate_limit_until=reg.rate_limit_until,
        )
        return
    candidates = [(i, s) for i, s in enumerate(reg.slots) if s.url and s.last_sent_at]
    if not candidates:
        return

    def watch_key(item):
        _, slot = item
        return slot.last_watchdog_at or slot.last_sent_at or ""

    for idx, slot in sorted(candidates, key=watch_key):
        if slot.watchdog_resumes_since_schedule >= WATCHDOG_MAX_RESUMES_PER_RUN:
            continue

        page = await slot_page(context, pages, slot)
        try:
            if page.url.rstrip("/") != slot.url.rstrip("/"):
                await page.goto(slot.url, wait_until="domcontentloaded", timeout=60000)
                await page.wait_for_timeout(700)
        except Exception:
            log.exception("watchdog slot-tab navigation failed slot=%s", slot.name)
            continue

        guard = send_guard_reason(reg, slot, datetime.now(TZ))
        retry_visible = await first_visible(page, RETRY_SELECTORS)
        if retry_visible:
            last_request = _parse_iso(slot.last_sent_at)
            retry_age = (datetime.now(TZ) - last_request).total_seconds() if last_request else RETRY_BUTTON_COOLDOWN_SECONDS
            if retry_age < RETRY_BUTTON_COOLDOWN_SECONDS:
                wait_sec = max(1, int(RETRY_BUTTON_COOLDOWN_SECONDS - retry_age))
                slot.last_result = f"retry_wait:cooldown:{wait_sec}s"
                slot.last_watchdog_at = now.isoformat()
                save_registry(reg)
                write_runtime(status="retry_wait", last_action=f"Retry visible on slot {slot.name}; cooldown {wait_sec}s")
                continue
            retry_guard = send_guard_reason(reg, slot, datetime.now(TZ))
            if retry_guard and retry_guard.startswith("slot_dedup:"):
                retry_guard = None
            if retry_guard:
                slot.last_result = f"retry_wait:{retry_guard}"
                slot.last_watchdog_at = now.isoformat()
                save_registry(reg)
                write_runtime(status="retry_wait", last_action=f"Retry visible on slot {slot.name}; waiting only for {retry_guard}")
                continue
            if await click_retry_generation(page):
                request_now = datetime.now(TZ)
                note_successful_request(reg, request_now)
                slot.watchdog_resumes_since_schedule += 1
                slot.last_watchdog_at = request_now.isoformat()
                slot.last_sent_at = request_now.isoformat()
                slot.last_assistant_change_at = request_now.isoformat()
                slot.last_result = "watchdog_retry_clicked"
                save_registry(reg)
                write_runtime(status="watchdog_retry", last_action=f"Clicked Retry on slot {slot.name}")
                continue

        if await detect_rate_limit(page):
            mark_rate_limit(reg, datetime.now(TZ), f"watchdog-precheck:{slot.name}")
            return
        if await detect_limit(page):
            write_runtime(status="limit_detected", last_action=f"Watchdog stopped: limit detected while checking slot {slot.name}")
            return

        guard = send_guard_reason(reg, slot, datetime.now(TZ))
        if not guard and await click_continue_generating(page):
            request_now = datetime.now(TZ)
            if await detect_rate_limit(page):
                mark_rate_limit(reg, request_now, f"watchdog-continue:{slot.name}")
                return
            note_successful_request(reg, request_now)
            slot.last_watchdog_at = request_now.isoformat()
            slot.last_result = "watchdog_continue_clicked"
            save_registry(reg)
            write_runtime(status="watchdog_continue", last_action=f"Clicked Continue generating on slot {slot.name}")
            continue

        text = await last_assistant_text(page)
        h = stable_hash(text) if text else None
        if h and h != slot.last_assistant_hash:
            slot.last_assistant_hash = h
            slot.last_assistant_change_at = now.isoformat()
            slot.last_watchdog_at = now.isoformat()
            save_registry(reg)
            continue
        if not slot.last_assistant_change_at:
            slot.last_assistant_change_at = slot.last_sent_at or now.isoformat()
            slot.last_watchdog_at = now.isoformat()
            save_registry(reg)
            continue

        stale_min = minutes_since(slot.last_assistant_change_at, now) or 0
        busy = await detect_busy(page)

        if busy:
            if stale_min < WATCHDOG_BUSY_STALL_MINUTES:
                slot.last_watchdog_at = now.isoformat()
                save_registry(reg)
                continue
            if not WATCHDOG_FORCE_STOP_STALLED:
                slot.last_result = "watchdog_busy_stalled"
                slot.last_watchdog_at = now.isoformat()
                save_registry(reg)
                write_runtime(
                    status="watchdog_busy_stalled",
                    last_action=f"Slot {slot.name} unchanged {stale_min:.1f}m but still generating; other tabs continue",
                )
                continue
            if not await click_stop_generating(page):
                continue
            if await detect_busy(page):
                continue
        elif stale_min < WATCHDOG_STALL_MINUTES:
            slot.last_watchdog_at = now.isoformat()
            save_registry(reg)
            continue

        guard = send_guard_reason(reg, slot, datetime.now(TZ))
        if guard:
            slot.last_result = f"send_guard:{guard}"
            slot.last_watchdog_at = now.isoformat()
            save_registry(reg)
            write_runtime(status="send_throttled", last_action=f"Watchdog slot {slot.name} skipped by {guard}")
            continue

        prompt = prompt_for_slot(slot, "watchdog")
        thinking_ok = await ensure_thinking_level(page)
        if not thinking_ok and STRICT_THINKING_LEVEL:
            slot.last_result = "thinking_level_unverified"
            slot.last_watchdog_at = now.isoformat()
            save_registry(reg)
            write_runtime(status="thinking_level_blocked", last_action=f"Watchdog did not send slot {slot.name}: {PREFERRED_THINKING_LEVEL} could not be verified")
            continue

        sent = await send_message(page, prompt)
        if not sent:
            slot.last_result = "watchdog_input_not_found"
            slot.last_watchdog_at = now.isoformat()
            save_registry(reg)
            write_runtime(status="ui_changed", last_action=f"Watchdog could not find input for slot {slot.name}")
            continue

        request_now = datetime.now(TZ)
        if await detect_rate_limit(page):
            slot.last_result = "watchdog_rate_limited"
            slot.last_watchdog_at = request_now.isoformat()
            slot.last_sent_at = request_now.isoformat()
            save_registry(reg)
            mark_rate_limit(reg, request_now, f"watchdog-send:{slot.name}")
            return

        note_successful_request(reg, request_now)
        slot.watchdog_resumes_since_schedule += 1
        slot.last_watchdog_at = request_now.isoformat()
        slot.last_sent_at = request_now.isoformat()
        slot.last_assistant_change_at = request_now.isoformat()
        slot.last_result = "watchdog_resume_sent"
        save_registry(reg)
        write_runtime(
            status="watchdog_resume_sent",
            last_action=f"Sent continuation prompt to stalled/idle slot {slot.name}",
            active_slot=slot.name,
            active_url=slot.url,
            slot_tabs={name: p.url for name, p in pages.items() if not p.is_closed()},
        )
        log.info("watchdog resumed slot=%s stale_min=%.1f busy=%s", slot.name, stale_min, busy)


async def run_cycle(context: BrowserContext, pages: dict[str, Page]):
    now = datetime.now(TZ)
    reg = load_registry(now)

    guard = send_guard_reason(reg, None, now)
    if guard and guard.startswith("rate_limit_backoff:"):
        write_runtime(
            status="rate_limited_backoff",
            last_action=f"Scheduled send paused by {guard}",
            rate_limit_attempts=reg.rate_limit_attempts,
            rate_limit_until=reg.rate_limit_until,
        )
        return

    slot = reg.slots[reg.next_slot]
    if FRESH_CHAT_EACH_RUN:
        previous_page = pages.get(slot.name)
        if previous_page is not None and not previous_page.is_closed():
            try:
                if await detect_busy(previous_page):
                    slot.last_result = "fresh_chat_deferred_previous_busy"
                    save_registry(reg)
                    write_runtime(
                        status="previous_run_busy",
                        last_action=f"Slot {slot.name} is still generating; skipped this hourly fresh-chat launch instead of closing active work",
                        active_slot=slot.name,
                        active_url=slot.url or previous_page.url,
                    )
                    return
            except Exception:
                log.exception("failed to check previous slot before fresh-chat rotation slot=%s", slot.name)
                slot.last_result = "fresh_chat_deferred_busy_check_failed"
                save_registry(reg)
                return
        page = await replace_with_fresh_slot_page(context, pages, slot)
        is_new = True
        save_registry(reg)
        write_runtime(
            status="fresh_chat_started",
            last_action=f"Opened a fresh ChatGPT tab for slot {slot.name}",
            tab_mode="fresh_per_run",
            tab_count=len([p for p in pages.values() if not p.is_closed()]),
            slot_tabs={name: p.url for name, p in pages.items() if not p.is_closed()},
        )
    else:
        page = await slot_page(context, pages, slot)
        is_new = not slot.url

    if is_new:
        if not await ensure_logged_in(page):
            write_runtime(status="login_required", last_action=f"Slot {slot.name}: open noVNC and log in to ChatGPT")
            return
        prompt = prompt_for_slot(slot, "bootstrap")
    else:
        try:
            if page.url.rstrip("/") != slot.url.rstrip("/"):
                await page.goto(slot.url, wait_until="domcontentloaded", timeout=60000)
                await page.wait_for_timeout(600)
        except Exception:
            log.exception("slot-tab navigation failed slot=%s", slot.name)
            return

        if await detect_busy(page):
            slot.last_result = "busy_skipped"
            reg.next_slot = (reg.next_slot + 1) % len(reg.slots)
            save_registry(reg)
            write_runtime(
                status="slot_busy",
                last_action=f"Slot {slot.name} still generating in its own tab; advanced to next slot",
                slot_tabs={name: p.url for name, p in pages.items() if not p.is_closed()},
            )
            return
        prompt = prompt_for_slot(slot, "continue")

    if await detect_rate_limit(page):
        slot.last_result = "rate_limited_pre_send"
        save_registry(reg)
        mark_rate_limit(reg, datetime.now(TZ), f"scheduled-slot-precheck:{slot.name}")
        return

    if await detect_limit(page):
        slot.last_result = "limit_detected"
        save_registry(reg)
        write_runtime(status="limit_detected", last_action=f"Slot {slot.name} not sent")
        return

    guard = send_guard_reason(reg, slot, datetime.now(TZ))
    if guard:
        slot.last_result = f"send_guard:{guard}"
        save_registry(reg)
        write_runtime(status="send_throttled", last_action=f"Slot {slot.name} not sent because {guard}")
        return

    thinking_ok = await ensure_thinking_level(page)
    if not thinking_ok and STRICT_THINKING_LEVEL:
        slot.last_result = "thinking_level_unverified"
        save_registry(reg)
        write_runtime(
            status="thinking_level_blocked",
            last_action=f"Slot {slot.name} not sent: {PREFERRED_THINKING_LEVEL} could not be positively verified",
            active_slot=slot.name,
            active_url=page.url,
            slot_tabs={name: p.url for name, p in pages.items() if not p.is_closed()},
        )
        return

    sent = await send_message(page, prompt)
    if not sent:
        slot.last_result = "input_not_found"
        save_registry(reg)
        write_runtime(status="ui_changed", last_action=f"Slot {slot.name}: prompt input not found")
        return

    request_now = datetime.now(TZ)

    # Persist the newly created chat URL before inspecting transient errors so the
    # watchdog can retry the exact failed turn instead of losing the new chat.
    if is_new:
        new_url = await wait_for_chat_url(page, timeout_sec=8)
        if new_url:
            slot.url = new_url
            save_registry(reg)

    if await detect_rate_limit(page):
        slot.last_result = "rate_limited_after_send"
        slot.last_sent_at = request_now.isoformat()
        save_registry(reg)
        mark_rate_limit(reg, request_now, f"scheduled-send:{slot.name}")
        return

    note_successful_request(reg, request_now)
    slot.runs += 1
    slot.watchdog_resumes_since_schedule = 0
    slot.last_assistant_hash = None
    slot.last_assistant_change_at = request_now.isoformat()
    slot.last_sent_at = request_now.isoformat()
    slot.last_result = "sent"
    reg.next_slot = (reg.next_slot + 1) % len(reg.slots)
    save_registry(reg)

    write_runtime(
        status="sent",
        last_action=f"Sent review cycle to dedicated tab {slot.name}",
        active_slot=slot.name,
        active_url=slot.url,
        tab_mode="dedicated_per_slot",
        tab_count=len(pages),
        slot_tabs={name: p.url for name, p in pages.items() if not p.is_closed()},
    )
    log.info("sent slot=%s fresh=%s runs=%s url=%s", slot.name, FRESH_CHAT_EACH_RUN, slot.runs, slot.url)


