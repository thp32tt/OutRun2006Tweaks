        log.exception("failed to inspect previous slot")
        return True


def stable_hash(text: str) -> str:
    import hashlib
    return hashlib.sha256(text.encode("utf-8", errors="ignore")).hexdigest()


async def last_assistant_text(page: Page) -> str:
    for sel in ASSISTANT_MESSAGE_SELECTORS:
        try:
            loc = page.locator(sel)
            count = await loc.count()
            if count:
                return (await loc.nth(count - 1).inner_text(timeout=2000)).strip()
        except Exception:
            continue
    return ""


async def click_continue_generating(page: Page) -> bool:
    loc = await first_visible(page, CONTINUE_GENERATING_SELECTORS)
    if loc is None:
        return False
    try:
        await loc.click()
        await page.wait_for_timeout(1000)
        return True
    except Exception:
        log.exception("continue-generating click failed")
        return False


async def click_retry_generation(page: Page) -> bool:
    loc = await first_visible(page, RETRY_SELECTORS)
    if loc is None:
        return False
    try:
        await loc.click()
        await page.wait_for_timeout(1000)
        return True
    except Exception:
        log.exception("retry click failed")
        return False


async def click_stop_generating(page: Page) -> bool:
    loc = await first_visible(page, BUSY_SELECTORS)
    if loc is None:
        return False
    try:
        await loc.click()
        await page.wait_for_timeout(3000)
        return True
    except Exception:
        log.exception("stop-generating click failed")
        return False


def minutes_since(value: Optional[str], now: datetime) -> Optional[float]:
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(value)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=TZ)
        return (now - dt.astimezone(TZ)).total_seconds() / 60.0
    except Exception:
        return None


async def prepare_slot_pages(context: BrowserContext, reg: Registry) -> dict[str, Page]:
    """Create and keep persistent tabs, hard-scoped to the configured ChatGPT project."""
    pages: dict[str, Page] = {}
    registry_changed = False
    for slot in reg.slots:
        if slot.url and not is_project_scoped_chat_url(slot.url):
            log.warning("discarding cross-project/stale slot URL slot=%s url=%s", slot.name, slot.url)
            slot.url = None
            slot.last_assistant_hash = None
            slot.last_assistant_change_at = None
            registry_changed = True
    if registry_changed:
        save_registry(reg)
    available = [p for p in context.pages if not p.is_closed()]

    # First reuse tabs that already match persisted chat URLs.
    used = set()
    for slot in reg.slots:
        if not slot.url:
            continue
        for page in available:
            if page in used:
                continue
            try:
                if page.url == slot.url or ("/c/" in page.url and page.url.rstrip("/") == slot.url.rstrip("/")):
                    pages[slot.name] = page
                    used.add(page)
                    break
            except Exception:
                continue

    # Reuse remaining existing tabs, then create new tabs until every slot has one.
    leftovers = [p for p in available if p not in used]
    for slot in reg.slots:
        if slot.name in pages:
            continue
        page = leftovers.pop(0) if leftovers else await context.new_page()
        pages[slot.name] = page
        used.add(page)

    # Close surplus controller tabs after a slot-count reduction so they do not keep
    # consuming Chrome/N100 resources.
    surplus = [p for p in available if p not in used]
    for page in surplus:
        try:
            await page.close()
        except Exception:
            log.exception("failed to close surplus controller tab")

    # Put each tab on its own persisted chat URL or a clean ChatGPT home page.
    for slot in reg.slots:
        page = pages[slot.name]
        target = slot.url or BASE_URL
        try:
            if not page.url or page.url == "about:blank" or page.url.rstrip("/") != target.rstrip("/"):
                await page.goto(target, wait_until="domcontentloaded", timeout=60000)
                await page.wait_for_timeout(500)
        except Exception:
            log.exception("slot tab initialization failed slot=%s target=%s", slot.name, target)

    write_runtime(
        tab_mode="fresh_per_run" if FRESH_CHAT_EACH_RUN else "dedicated_per_slot",
        tab_count=len(pages),
        slot_tabs={name: page.url for name, page in pages.items()},
    )
    log.info("prepared %s dedicated tabs: %s", len(pages), ",".join(sorted(pages)))
    return pages


async def slot_page(context: BrowserContext, pages: dict[str, Page], slot: Slot) -> Page:
    page = pages.get(slot.name)
    if slot.url and not is_project_scoped_chat_url(slot.url):
        log.warning("discarding non-project slot URL slot=%s url=%s", slot.name, slot.url)
        slot.url = None
        slot.last_assistant_hash = None
        slot.last_assistant_change_at = None
    if page is None or page.is_closed():
        page = await context.new_page()
        pages[slot.name] = page
        await page.goto(slot.url or BASE_URL, wait_until="domcontentloaded", timeout=60000)
    elif REQUIRE_PROJECT_URL and not is_configured_project_url(page.url):
        log.warning("slot tab escaped configured project; restoring slot=%s url=%s", slot.name, page.url)
        target = slot.url if slot.url and is_project_scoped_chat_url(slot.url) else BASE_URL
        if target == BASE_URL:
            slot.url = None
            slot.last_assistant_hash = None
            slot.last_assistant_change_at = None
        await page.goto(target, wait_until="domcontentloaded", timeout=60000)
        await page.wait_for_timeout(700)
    elif not slot.url and "/c/local-chatgpt" in page.url.lower():
        await page.goto(BASE_URL, wait_until="domcontentloaded", timeout=60000)
        await page.wait_for_timeout(700)
    return page


async def recover_slot_composer(context: BrowserContext, pages: dict[str, Page], slot: Slot, page: Page) -> Page:
    """Self-heal a retry/error-only tab without adding extra prompt sends."""
    if await first_visible(page, INPUT_SELECTORS, total_wait_ms=2500) is not None:
        return page

    retry = await first_visible(page, RETRY_SELECTORS, total_wait_ms=800)
    log.warning("composer missing slot=%s retry_visible=%s url=%s; refreshing once", slot.name, retry is not None, page.url)

    # Recovery 1: reload the same persisted conversation once.
    target = slot.url if slot.url and is_project_scoped_chat_url(slot.url) else BASE_URL
    try:
        await page.goto(target, wait_until="domcontentloaded", timeout=60000)
        await page.wait_for_timeout(1500)
        if await first_visible(page, INPUT_SELECTORS, total_wait_ms=5000) is not None:
            return page
    except Exception:
        log.exception("composer recovery refresh failed slot=%s", slot.name)

    # Recovery 2: replace only the broken slot tab and reopen the persisted chat.
    try:
        if not page.is_closed():
            await page.close()
    except Exception:
        pass
    page = await context.new_page()
    pages[slot.name] = page
    try:
        await page.goto(target, wait_until="domcontentloaded", timeout=60000)
        await page.wait_for_timeout(1500)
        if await first_visible(page, INPUT_SELECTORS, total_wait_ms=5000) is not None:
            return page
    except Exception:
        log.exception("composer recovery new-tab persisted-chat failed slot=%s", slot.name)

    # Recovery 3: if the saved conversation itself is broken, start a clean home
    # composer. The caller will send the full role prompt, and a new durable URL
    # will replace the stale one after successful send.
    try:
        await page.goto(BASE_URL, wait_until="domcontentloaded", timeout=60000)
        await page.wait_for_timeout(1500)
        if await first_visible(page, INPUT_SELECTORS, total_wait_ms=5000) is not None:
            slot.url = None
            slot.last_assistant_hash = None
            slot.last_assistant_change_at = None
            save_registry(load_registry(datetime.now(TZ)))
    except Exception:
        log.exception("composer recovery clean-home failed slot=%s", slot.name)
    return page


async def replace_with_fresh_slot_page(context: BrowserContext, pages: dict[str, Page], slot: Slot) -> Page:
    """Start each scheduled N100 run in a brand-new tab/chat and close the previous one."""
    old = pages.get(slot.name)
    if old is not None and not old.is_closed():
        try:
            await old.close()
        except Exception:
            log.exception("failed to close previous slot tab slot=%s", slot.name)

    page = await context.new_page()
    pages[slot.name] = page
    slot.url = None
    slot.last_assistant_hash = None
    slot.last_assistant_change_at = None
    slot.last_watchdog_at = None
    slot.watchdog_resumes_since_schedule = 0
    await page.goto(BASE_URL, wait_until="domcontentloaded", timeout=60000)
    await page.wait_for_timeout(700)
    return page


def github_file(path: str, ref: str) -> Optional[dict]:
    query = urllib.parse.urlencode({"ref": ref})
    try:
        return github_api_json(f"/repos/{GITHUB_REPO}/contents/{urllib.parse.quote(path, safe='/')}?{query}")
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            return None
        raise


def github_text(path: str, ref: str) -> Optional[str]:
    payload = github_file(path, ref)
    if payload is None:
        return None
    if not isinstance(payload, dict) or payload.get("encoding") != "base64":
        raise ValueError(f"Expected base64 text at {path}@{ref}")
    return base64.b64decode(payload["content"]).decode("utf-8")


def github_json_file(path: str, ref: str) -> Optional[dict]:
    text = github_text(path, ref)
    return json.loads(text) if text is not None else None


def latest_path_commit(path: str, head: str) -> Optional[str]:
    query = urllib.parse.urlencode({"sha": head, "path": path, "per_page": 1})
    commits = github_api_json(f"/repos/{GITHUB_REPO}/commits?{query}")
    return commits[0]["sha"] if commits else None


def verify_candidate(path: str, sha: str, lane: str) -> dict:
    """Accept material bytes and committed self-QA, never a prose success claim."""
    manifest = github_json_file(artifact_record_path(path), sha)
    if not manifest or manifest.get("asset_path") != path or manifest.get("lane") != lane:
        raise ValueError("Candidate manifest asset/lane mismatch")
    if manifest.get("state") != "PRODUCED":
        raise ValueError("Manifest does not represent a produced DDS")
    if manifest.get("runtime_validation") != "UNTESTED":
        raise ValueError("Controller does not certify runtime validation")
    commit = github_api_json(f"/repos/{GITHUB_REPO}/commits/{sha}")
    parent = commit["parents"][0]["sha"]
    evidence = manifest.get("self_qa_path", "")
    asset_key(evidence)
    proof = github_file(evidence, sha)
    old_proof = github_file(evidence, parent)
    if not proof or (old_proof and proof["sha"] == old_proof["sha"]):
        raise ValueError("Missing changed, committed decoded self-QA evidence")
    candidate_path = manifest.get("artifact_path", "")
    asset_key(candidate_path)
    if not candidate_path.lower().endswith('.dds'):
        raise ValueError("Candidate must be a DDS")
    transport = manifest.get("transport", "github")
    if transport == "github":
        new = github_file(candidate_path, sha)
        old = github_file(candidate_path, parent)
        if not new or new.get("sha") != manifest.get("artifact_sha"):
            raise ValueError("Candidate blob SHA mismatch")
        if old and old["sha"] == new["sha"]:
            raise ValueError("Unchanged DDS is not production")
    elif transport == "drive":
        if not manifest.get("drive_file_id") or not re.fullmatch(r"[0-9a-f]{64}", manifest.get("artifact_sha", "")):
            raise ValueError("Drive candidate needs file identity and SHA-256")
        old = github_json_file(artifact_record_path(path), parent)
        if old and old.get("artifact_sha") == manifest["artifact_sha"]:
            raise ValueError("Unchanged external DDS is not production")
    else:
        raise ValueError("Unsupported candidate transport")
    return {"lane": lane, "asset_path": path, "artifact_path": candidate_path,
            "artifact_sha": manifest["artifact_sha"], "candidate_sha": sha,
            "result_sha": sha, "state": "QA_PENDING", "self_qa_path": evidence}


def read_qa_result(item: dict, head: str) -> Optional[dict]:
    path = qa_record_path(item["asset_path"], item["candidate_sha"])
    payload = github_json_file(path, head)
    if payload is None:
        return None
    if (payload.get("asset_path") != item["asset_path"] or
            payload.get("candidate_sha") != item["candidate_sha"] or
            payload.get("artifact_sha") != item["artifact_sha"] or
            payload.get("status") not in {"PASS", "REWORK_REQUIRED"}):
        raise ValueError("QA disposition identity/status mismatch")
    evidence = payload.get("evidence_path", "")
    asset_key(evidence)
    sha = latest_path_commit(path, head)
    if not sha or sha == item["candidate_sha"]:
        raise ValueError("QA needs its own independent commit")
    if not github_file(evidence, sha):
        raise ValueError("Missing committed independent QA evidence")
    return {"status": payload["status"], "result_sha": sha, "evidence_path": evidence}


def reconcile_assets(reg: Registry, head: str):
    """Rebuild lost checkpoints from asset manifests at one immutable Git HEAD."""
    if reg.reconciled_head == head:
        return
    directory = github_file(ARTIFACT_ROOT, head)
    if directory is not None and not isinstance(directory, list):
        raise ValueError("Artifact registry must be a repository directory")
    rows = {r["path"]: r for r in load_asset_rows(head)}
    for entry in directory or []:
        if entry.get("type") != "file" or not entry["path"].endswith('.json'):
            continue
        manifest = github_json_file(entry["path"], head)
        path = manifest.get("asset_path", "")
        row = rows.get(path)
        if row is None or entry["path"] != artifact_record_path(path):
            continue
        lane = "A" if int(row["index"]) % 2 == 0 else "B"
        sha = latest_path_commit(entry["path"], head)
        old = reg.artifact_records.get(path, {})
        if old.get("candidate_sha") == sha:
            if manifest.get("transport", "github") == "github":
                current_blob = github_file(manifest["artifact_path"], head)
                if not current_blob or current_blob.get("sha") != manifest["artifact_sha"]:
                    old.update(state="BLOCKED", reason="Candidate bytes changed without a new manifest")
            continue
        try:
            record = verify_candidate(path, sha, lane)
        except ValueError as exc:
            log.warning("asset evidence rejected ASSET=%s reason=%s", path, exc)
            continue
        reg.artifact_records[path] = record
        # A newer candidate supersedes pending inputs without approving old bytes.
        reg.qa_queue = [q for q in reg.qa_queue if q["asset_path"] != path]
        enqueue_candidate(reg, record)
    reg.reconciled_head = head


def load_asset_rows(head: str) -> list[dict]:
    text = github_text(ASSET_QUEUE_PATH, head)
    if text is None:
        raise ValueError("Canonical asset queue is absent")
    rows = list(csv.DictReader(io.StringIO(text)))
    paths, indices = set(), set()
    for row in rows:
        index, path = int(row["index"]), row["path"]
        asset_key(path)
        if path in paths or index in indices:
            raise ValueError("Duplicate path/index in canonical queue")
        paths.add(path)
        indices.add(index)
    return rows


def producer_prompt(active: dict) -> str:
    manifest = {"lane": active["lane"], "asset_path": "<직접 선택한 canonical queue 경로>", "state": "PRODUCED",
                "artifact_path": "<실제 DDS 경로>", "artifact_sha": "<Git blob SHA 또는 Drive SHA-256>",
                "transport": "github", "self_qa_path": "<같은 커밋의 decoded self-QA JSON 경로>",
                "runtime_validation": "UNTESTED"}
    options = active.get("asset_options", [])
    lines = [f"LANE={active['lane']}", "ASSET_SELECTION=AUTONOMOUS_WITHIN_SHARD", "STATE=SELECTING",
             f"BASE_SHA={active['base_sha']}", f"TARGET_BRANCH={LOCALIZATION_BRANCH}",
             "자산 하나를 지정하지 않는다. 최신 canonical queue와 실제 취득 가능한 원본·증거를 확인하여 작업 대상을 스스로 선택해.",
             "A는 짝수 index, B는 홀수 index만 담당한다. 완료/PASS와 C1/C2 QA 대기 후보는 재생산하지 마.",
             "아래 목록은 우선순위 참고다. 첫 항목에 고정되지 말고 실제 제작 가능한 대상을 선택해.",
             "CANDIDATE_OPTIONS=" + json.dumps(options, ensure_ascii=False, separators=(",", ":")),
             "GitHub 연결 플러그인으로 최신 HEAD와 기존 증거를 읽어. 첫 경로가 없다는 이유로 연결/권한 없음이나 전체 작업 불가를 선언하지 마.",
             "연결 도구의 실제 읽기·쓰기 호출 응답을 구분해 판단하고, 쓰기 도구를 탐색하지 않은 채 읽기 전용이라고 단정하지 마.",
             "404는 source transport miss다. canonical inventory의 경로/해시를 확인하고 승인된 Google Drive canonical HD source transport의 내부 목록·개별 파일을 탐색해.",
             "Drive miss면 contract의 pinned tag/release 순서로 전환해. 최신 release나 다른 원본으로 임의 대체하지 마.",
             "한 자산의 원본·권한·영역 문제가 해결되지 않으면 확인한 경로와 실제 오류를 남기고 같은 응답 안에서 다음 자기 shard 자산으로 넘어가.",
             "후보 탐색 중 매번 사용자에게 진행 여부를 묻거나 첫 실패 보고로 끝내지 마. 후보를 비교한 뒤 가능한 작업을 실제 수행해.",
             "현재 지시는 자산 경로 + 후보 SHA 실행 계약이다. 과거 번호 기반 실행 계약을 재생성하지 마.",
             "candidate-completion-first: ready 자산이 있는 동안 preflight-only 결과로 종료하지 마.",
             f"선택한 canonical asset_path의 UTF-8 문자열 SHA-256(64자리 소문자 hex)을 key로 계산하여 {ARTIFACT_ROOT}/<key>.json에 아래 JSON을 기록해.",
             "실제 DDS와 변경된 decoded self-QA 증거, manifest는 같은 material commit에 넣어.",
             json.dumps(manifest, ensure_ascii=False),
             "Drive 출력은 transport=drive와 drive_file_id를 추가하고 실제 bytes SHA-256을 artifact_sha로 기록해.",
             "Git 출력의 artifact_sha는 DDS Git blob SHA다. 원본 영어 비교 증거도 실제 파일로 커밋해.",
             "준비 기록만으로 PRODUCED를 선언하지 마. 모든 자기 shard 후보가 실제로 차단된 경우에만 조사한 후보별 근거와 NO_RUNNABLE_ASSET을 보고해.",
             "공용 진행 상태는 독립 C QA consumer가 병합한다. commit 메시지는 자기 lane의 [AUTO:LOCALIZATION-A] 또는 [AUTO:LOCALIZATION-B]와 선택한 자산 경로를 사용해.",
             "RUNTIME_VALIDATION=UNTESTED. CI-skip 지시어를 넣지 마.",
             "완료한 실제 대상의 LANE, ASSET, STATE, RESULT_SHA를 마지막에 각각 한 줄로 출력해."]
    return "\n".join(lines) + "\n\n" + read_prompt(f"localization_{active['lane']}.md")


def qa_prompt(active: dict) -> str:
    item = active
    payload = {"asset_path": item["asset_path"], "candidate_sha": item["candidate_sha"],
               "artifact_sha": item["artifact_sha"], "status": "PASS 또는 REWORK_REQUIRED",
               "evidence_path": "<독립 검증 증거 JSON 경로>", "runtime_validation": "UNTESTED"}
    qa_lane = item.get("lane") if item.get("lane") in QA_LANES else "C1"
    return "\n".join([
        f"LANE={qa_lane}", f"ASSET={item['asset_path']}", "STATE=VERIFYING",
        f"CANDIDATE_SHA={item['candidate_sha']}", f"ARTIFACT_SHA={item['artifact_sha']}",
        f"TARGET_BRANCH={LOCALIZATION_BRANCH}",
        "GitHub 연결 플러그인을 사용해 이 정확한 후보 커밋의 DDS와 self-QA를 독립 검증해.",
        "현재 지시는 자산 경로 + 후보 SHA 실행 계약이다. 과거 번호 기반 실행 계약을 재생성하지 마.",
        f"후보 manifest: {artifact_record_path(item['asset_path'])}",
        f"독립 증거와 아래 JSON을 {qa_record_path(item['asset_path'], item['candidate_sha'])}에 같은 커밋으로 기록해.",
        json.dumps(payload, ensure_ascii=False),
        "판정은 PASS 또는 REWORK_REQUIRED. 최신 후보가 달라졌다면 오래된 후보로 공용 상태를 덮어쓰지 마.",
        "새 DDS를 만들거나 producer를 대신하지 마. 공용 상태 병합은 최신 HEAD 위에서 수행해.",
        f"commit 메시지는 [AUTO:LOCALIZATION-{qa_lane}]와 자산 경로를 사용해. CI-skip 지시어를 넣지 마.",
        f"최종 출력: LANE={qa_lane}, ASSET, STATE, RESULT_SHA. 실기 테스트는 UNTESTED.",
    ]) + "\n\n" + read_prompt("localization_C.md")


def conversion_prompt(active: dict) -> str:
    context_prefix = (GAME_MOD_CONTEXT + "\n\n")
    prompt_by_lane = {
        "A": "conversion_dx11.md",
        "B": "conversion_dxvk.md",
        "C": "conversion_dx9ex.md",
    }
    prompt_name = prompt_by_lane.get(active["lane"])
    if not prompt_name:
        raise ValueError(f"Unsupported conversion lane: {active['lane']}")
    return context_prefix + "\n".join([
        f"LANE={active['lane']}", f"ASSET={active['asset_path']}", "STATE=PRODUCING",
        f"TARGET_BRANCH={active['branch']}", f"BASE_SHA={active['base_sha']}",
        "대상 브랜치의 실제 변경을 commit하고 RESULT_SHA=<40자리 커밋 SHA>를 마지막에 출력해.",
        "실기 검증하지 않았다면 UNTESTED로 기록해. CI-skip 지시어를 넣지 마.",
    ]) + "\n\n" + read_prompt(prompt_name)



