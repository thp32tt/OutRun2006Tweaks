@dataclass
class Slot:
    name: str
    url: Optional[str] = None
    runs: int = 0
    last_sent_at: Optional[str] = None
    last_result: Optional[str] = None
    last_assistant_hash: Optional[str] = None
    last_assistant_change_at: Optional[str] = None
    watchdog_resumes_since_schedule: int = 0
    last_watchdog_at: Optional[str] = None
    completed_tasks_in_chat: int = 0

@dataclass
class TaskEvent:
    event_id: str
    production_id: str
    event_type: str
    attempt: int
    retry_count: int
    rollover_count: int
    created_at: str


@dataclass
class Registry:
    logical_date: str
    next_slot: int
    slots: list[Slot]
    next_production_id: dict[str, int] = field(default_factory=dict)
    task_events: list[TaskEvent] = field(default_factory=list)
    rate_limit_attempts: int = 0
    rate_limit_until: Optional[str] = None
    last_global_send_at: Optional[str] = None
    last_global_send_slot: Optional[str] = None

