def write_runtime(**updates):
    now = datetime.now(TZ)
    if updates.get("last_action") is not None:
        runtime["last_scheduler_decision_at"] = now.isoformat()
        runtime["last_scheduler_decision"] = updates.get("last_action")
    status = str(updates.get("status", ""))
    if "blocked" in status or status in {"queue_error", "watchdog_error", "login_required", "limit_detected"}:
        runtime["blocked_reason"] = updates.get("last_action") or updates.get("last_error") or status
    elif status in {"idle", "sent", "queue_wait_chat", "queue_wait_actions", "parallel_wave_running",
                    "parallel_wait_actions", "parallel_wave_complete", "queue_pass",
                    "parallel_c_barrier", "startup_reconcile"}:
        runtime["blocked_reason"] = None
    runtime.update(updates)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    RUNTIME_FILE.write_text(json.dumps(runtime, ensure_ascii=False, indent=2), encoding="utf-8")

def logical_date(now: datetime) -> str:
    shifted = now - timedelta(days=1) if now.hour < ROLLOVER_HOUR else now
    return shifted.date().isoformat()


def new_registry(now: datetime) -> Registry:
    return Registry(
        logical_date=logical_date(now),
        next_slot=0,
        slots=[Slot(name=chr(ord('A') + i)) for i in range(CHAT_SLOTS)],
        next_production_id={},
        task_events=[],
        rate_limit_attempts=0,
        rate_limit_until=None,
        last_global_send_at=None,
        last_global_send_slot=None,
    )


def load_registry(now: datetime) -> Registry:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if not REGISTRY_FILE.exists():
        reg = new_registry(now)
        save_registry(reg)
        return reg
    try:
        raw = json.loads(REGISTRY_FILE.read_text(encoding="utf-8"))
        reg = Registry(
            logical_date=raw["logical_date"],
            next_slot=int(raw.get("next_slot", 0)),
            slots=[Slot(**s) for s in raw["slots"]],
            next_production_id={str(k): int(v) for k, v in dict(raw.get("next_production_id", {})).items()},
            task_events=[TaskEvent(**e) for e in raw.get("task_events", []) if isinstance(e, dict)],
            rate_limit_attempts=int(raw.get("rate_limit_attempts", 0)),
            rate_limit_until=raw.get("rate_limit_until"),
            last_global_send_at=raw.get("last_global_send_at"),
            last_global_send_slot=raw.get("last_global_send_slot"),
        )
    except Exception:
        log.exception("registry read failed; recreating")
        reg = new_registry(now)
    if reg.logical_date != logical_date(now):
        archive = STATE_DIR / f"chat_registry_{reg.logical_date}.json"
        try:
            if REGISTRY_FILE.exists():
                archive.write_text(REGISTRY_FILE.read_text(encoding="utf-8"), encoding="utf-8")
        except Exception:
            log.exception("registry archive failed")
        reg = new_registry(now)
        save_registry(reg)
        log.info("daily chat generation rolled over: %s", reg.logical_date)
    elif len(reg.slots) != CHAT_SLOTS:
        # Resize without discarding progress: preserve A..N existing slot state.
        old_len = len(reg.slots)
        if CHAT_SLOTS < old_len:
            reg.slots = reg.slots[:CHAT_SLOTS]
        else:
            for i in range(old_len, CHAT_SLOTS):
                reg.slots.append(Slot(name=chr(ord('A') + i)))
        reg.next_slot = reg.next_slot % CHAT_SLOTS
        save_registry(reg)
        log.info("resized chat slots from %s to %s while preserving state", old_len, CHAT_SLOTS)
    return reg


def save_registry(reg: Registry):
    payload = {
        "logical_date": reg.logical_date,
        "next_slot": reg.next_slot,
        "slots": [asdict(s) for s in reg.slots],
        "next_production_id": dict(reg.next_production_id),
        "task_events": [asdict(e) for e in reg.task_events[-5000:]],
        "rate_limit_attempts": reg.rate_limit_attempts,
        "rate_limit_until": reg.rate_limit_until,
        "last_global_send_at": reg.last_global_send_at,
        "last_global_send_slot": reg.last_global_send_slot,
    }
    tmp = REGISTRY_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(REGISTRY_FILE)


def allocate_lane_production_id(reg: Registry, lane: str, prefix: str, minimum_next: int = 1) -> str:
    """Allocate exactly one production number for a new dispatch.

    Retry, rollover, continue and reconcile must never call this function.
    Counters are lane-scoped when PRODUCTION_COUNTER_MODE=lane. minimum_next
    safely migrates an existing v1 queue without reusing historical numbers.
    """
    key = lane if PRODUCTION_COUNTER_MODE == "lane" else "__global__"
    next_id = max(int(reg.next_production_id.get(key, 1)), int(minimum_next or 1))
    reg.next_production_id[key] = next_id + 1
    return f"{prefix}-{lane}-{next_id:05d}"


def production_id_from_identifier(identifier: str) -> str:
    value = str(identifier or "").strip()
    return re.sub(r"-E\d{3}$", "", value)


def queue_lane_minimum_next(q: dict, lane: str) -> int:
    """Return a collision-safe migration floor from v1 queue history.

    Once lane history exists, do not let the legacy global counter couple lane
    numbering again. The global counter is only a first-migration fallback.
    """
    seen = []
    records = []
    if isinstance(q.get("active"), dict):
        records.append(q["active"])
    records.extend(v for v in q.get("active_by_lane", {}).values() if isinstance(v, dict))
    records.extend(v for key in ("completed", "blocked") for v in q.get(key, []) if isinstance(v, dict))
    for record in records:
        if str(record.get("lane") or "") != lane:
            continue
        identifier = production_id_from_identifier(record.get("production_id") or record.get("task_id") or "")
        match = re.search(r"-(\d{5,})$", identifier)
        if match:
            seen.append(int(match.group(1)))
    if seen:
        return max(seen) + 1
    return int(q.get("counter", 0)) + 1


def next_task_event_id(reg: Registry, production_id: str) -> str:
    count = sum(1 for e in reg.task_events if e.production_id == production_id)
    return f"{production_id}-E{count + 1:03d}"


def append_task_event(reg: Registry, active: dict, event_type: str) -> TaskEvent:
    production_id = str(active.get("production_id") or active.get("task_id") or "").strip()
    if not production_id:
        raise ValueError("PRODUCTION_ID_REQUIRED")
    existing = [e for e in reg.task_events if e.production_id == production_id]
    event_id = next_task_event_id(reg, production_id)
    event = TaskEvent(
        event_id=event_id,
        production_id=production_id,
        event_type=event_type,
        attempt=int(active.get("attempt", 1)),
        retry_count=int(active.get("retry_count", 0)),
        rollover_count=int(active.get("rollover_count", active.get("chat_rollovers", 0))),
        created_at=datetime.now(TZ).isoformat(),
    )
    reg.task_events.append(event)
    active["production_id"] = production_id
    active["task_id"] = production_id  # compatibility alias for existing Git markers
    active["event_id"] = event_id
    active["event_type"] = event_type
    active["retry_count"] = event.retry_count
    active["rollover_count"] = event.rollover_count
    return event


def read_prompt(filename: str) -> str:
    path = PROMPTS_DIR / filename
    return path.read_text(encoding="utf-8").strip()


def load_queue_state() -> dict:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if not QUEUE_FILE.exists():
        state = {
            "counter": 0,
            "active": None,
            "task_event_model": TASK_EVENT_MODEL,
            "production_counter_mode": PRODUCTION_COUNTER_MODE,
            "active_by_lane": {},
            "wave_counter": 0,
            "wave_id": None,
            "wave_started_at": None,
            "producer_counter": 0,
            "qa_batch_counter": 0,
            "qa_pending": [],
            "qa_completed": [],
            "qa_blocked": [],
            "completed": [],
            "blocked": [],
            "last_github_poll_at": None,
            "conversion_blocked_reconcile_version": 0,
            "conversion_parallel_schema_version": 0,
        }
        save_queue_state(state)
        return state
    try:
        raw = json.loads(QUEUE_FILE.read_text(encoding="utf-8"))
        raw.setdefault("counter", 0)
        raw.setdefault("active", None)
        raw.setdefault("task_event_model", TASK_EVENT_MODEL)
        raw.setdefault("production_counter_mode", PRODUCTION_COUNTER_MODE)
        raw.setdefault("active_by_lane", {})
        raw.setdefault("wave_counter", 0)
        raw.setdefault("wave_id", None)
        raw.setdefault("wave_started_at", None)
        raw.setdefault("producer_counter", 0)
        raw.setdefault("qa_batch_counter", 0)
        raw.setdefault("qa_pending", [])
        raw.setdefault("qa_completed", [])
        raw.setdefault("qa_blocked", [])
        raw.setdefault("completed", [])
        raw.setdefault("blocked", [])
        raw.setdefault("last_github_poll_at", None)
        raw.setdefault("conversion_blocked_reconcile_version", 0)
        raw.setdefault("conversion_parallel_schema_version", 0)
        return raw
    except Exception:
        # Never overwrite a damaged checkpoint with an empty queue and duplicate work.
        log.exception("queue state read failed; preserved for recovery")
        raise



def save_queue_state(state: dict):
    """Persist v2 identity fields while retaining task_id as a compatibility alias."""
    state["task_event_model"] = TASK_EVENT_MODEL
    state["production_counter_mode"] = PRODUCTION_COUNTER_MODE
    records = []
    if isinstance(state.get("active"), dict):
        records.append(state["active"])
    records.extend(v for v in state.get("active_by_lane", {}).values() if isinstance(v, dict))
    for record in records:
        production_id = str(record.get("production_id") or record.get("task_id") or "").strip()
        if production_id:
            record["production_id"] = production_id
            record["task_id"] = production_id
        record.setdefault("event_id", "")
        record.setdefault("event_type", "dispatch")
        record.setdefault("attempt", 1)
        record.setdefault("retry_count", 0)
        record.setdefault("rollover_count", int(record.get("chat_rollovers", 0)))
        record["status"] = str(record.get("phase") or record.get("status") or "PENDING")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = QUEUE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(QUEUE_FILE)


_github_rest_block_until_epoch = 0.0
_github_commit_list_cache: dict[str, tuple[float, list]] = {}
_github_actions_cache: dict[str, tuple[float, dict]] = {}


def _github_blocked_seconds() -> int:
    return max(0, int(_github_rest_block_until_epoch - time.time()))


def github_api_json(path: str) -> dict:
    global _github_rest_block_until_epoch
    now_epoch = time.time()
    if now_epoch < _github_rest_block_until_epoch:
        raise RuntimeError(f"github REST temporarily paused for {_github_blocked_seconds()}s after rate limit")

    url = "https://api.github.com" + path
    headers = {
        "Accept": "application/vnd.github+json",
        "User-Agent": "outrun-chat-controller/0.5",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    if GITHUB_TOKEN:
        headers["Authorization"] = f"Bearer {GITHUB_TOKEN}"
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            reset = resp.headers.get("X-RateLimit-Reset")
            write_runtime(
                github_rate_limit_remaining=resp.headers.get("X-RateLimit-Remaining"),
                github_rate_limit_limit=resp.headers.get("X-RateLimit-Limit"),
                github_rate_limit_reset=reset,
                github_api_blocked_until=None,
                last_github_error=None,
            )
            return data
    except urllib.error.HTTPError as e:
        if e.code == 429 or (e.code == 403 and (e.headers.get("Retry-After") or e.headers.get("X-RateLimit-Remaining") == "0")):
            retry_after = e.headers.get("Retry-After")
            reset = e.headers.get("X-RateLimit-Reset")
            until = time.time() + 300
            if retry_after:
                try:
                    until = max(until, time.time() + int(retry_after) + 5)
                except ValueError:
                    pass
            if reset:
                try:
                    until = max(until, float(reset) + 5)
                except ValueError:
                    pass
            _github_rest_block_until_epoch = until
            write_runtime(
                github_rate_limit_remaining=e.headers.get("X-RateLimit-Remaining"),
                github_rate_limit_limit=e.headers.get("X-RateLimit-Limit"),
                github_rate_limit_reset=reset,
                github_api_blocked_until=datetime.fromtimestamp(until, TZ).isoformat(),
                last_github_error=f"HTTP {e.code} rate limit; REST paused until {datetime.fromtimestamp(until, TZ).isoformat()}",
            )
        elif e.code in {401, 403}:
            write_runtime(github_blocker="GITHUB_AUTHORIZATION_REQUIRED", last_github_error=f"HTTP {e.code}: authorization denied")
        elif e.code == 404:
            write_runtime(github_lookup_miss=path)
        raise


def github_branch_head(branch: str) -> Optional[str]:
    try:
        q = urllib.parse.quote(branch, safe="")
        data = github_api_json(f"/repos/{GITHUB_REPO}/git/ref/heads/{q}")
        return data.get("object", {}).get("sha")
    except Exception as e:
        log.warning("github branch lookup failed branch=%s error=%r", branch, e)
        write_runtime(last_github_error=f"branch:{branch}:{e!r}")
        return None


def github_commit_message(sha: str) -> Optional[str]:
    try:
        data = github_api_json(f"/repos/{GITHUB_REPO}/commits/{sha}")
        return data.get("commit", {}).get("message", "")
    except Exception as e:
        log.warning("github commit lookup failed sha=%s error=%r", sha, e)
        return None


GITHUB_ACTIONS_SKIP_PATTERNS = [
    r"\[(?:skip ci|ci skip|no ci|skip actions|actions skip)\]",
    r"(?im)^skip-checks:\s*true\s*$",
]


def github_actions_skip_directive(message: str) -> Optional[str]:
    """Return the CI-skip directive that would prevent a required push workflow."""
    for pattern in GITHUB_ACTIONS_SKIP_PATTERNS:
        match = re.search(pattern, message or "", flags=re.I)
        if match:
            return match.group(0).strip()
    return None


def github_find_task_commit(branch: str, task_id: str, per_page: int = 100) -> Optional[dict]:
    """Find a task commit using a short shared branch-history cache to protect REST rate limits."""
    try:
        now_mono = time.monotonic()
        cached = _github_commit_list_cache.get(branch)
        if cached and now_mono - cached[0] < GITHUB_TASK_COMMIT_CACHE_SECONDS:
            data = cached[1]
        else:
            q = urllib.parse.urlencode({"sha": branch, "per_page": max(1, min(per_page, 100))})
            data = github_api_json(f"/repos/{GITHUB_REPO}/commits?{q}")
            if isinstance(data, list):
                _github_commit_list_cache[branch] = (now_mono, data)
        expected = f"[AUTO:{task_id}]"
        for item in data if isinstance(data, list) else []:
            message = item.get("commit", {}).get("message", "")
            if expected not in message:
                continue
            if github_actions_skip_directive(message):
                continue
            return {
                "sha": item.get("sha"),
                "message": message,
                "html_url": item.get("html_url"),
            }
        return None
    except Exception as e:
        log.warning("github task commit lookup failed branch=%s task=%s error=%r", branch, task_id, e)
        write_runtime(last_github_error=f"task-commit:{branch}:{task_id}:{e!r}")
        return None



_producer_result_evidence_cache: dict = {}


def classify_localization_result(record: dict, files: list[dict], task_id: str) -> tuple[str, str]:
    """Check immutable content, never accept the assistant's summary as production."""
    if record.get("TASK_ID", record.get("task_id")) != task_id:
        return "REJECTED", "TASK_RECORD_ID_MISMATCH"
    outcome = str(record.get("result", record.get("status", ""))).upper()
    if outcome in {"BLOCKED", "FAILED", "FAIL", "NO_WORK", "NO_CHANGE", "PENDING"} or record.get("blocker"):
        return "REJECTED", "BLOCKER_IS_NOT_PRODUCTION"
    changed = [f.get("filename", "") for f in files if f.get("status") != "removed"]
    substantive = [p for p in changed if p.startswith("localization/")
                   and not p.startswith(("localization/progress", "localization/resume_state"))
                   and p.rsplit("/", 1)[-1].lower() not in {"worklog.md", "readme.md", "status.md", "asset_queue.csv"}]
    if any(p.lower().endswith(".dds") for p in substantive):
        return "PRODUCED", "DDS_CHANGED"
    artifacts = record.get("candidate_artifacts", [])
    if isinstance(artifacts, list):
        for artifact in artifacts:
            if not isinstance(artifact, dict):
                continue
            if (artifact.get("role") == "korean_candidate"
                    and str(artifact.get("path", "")).lower().endswith(".dds")
                    and re.fullmatch(r"[0-9a-fA-F]{64}", str(artifact.get("sha256", "")))
                    and artifact.get("drive_file_id")
                    and any(p.lower().endswith(".json") and "qa" in p.lower() for p in substantive)):
                return "PRODUCED", "EXTERNAL_DDS_DECLARED_REQUIRES_C_VERIFICATION"
    if substantive:
        return "ADVANCED", "PREREQUISITE_CHANGE_ONLY"
    return "REJECTED", "BOOKKEEPING_ONLY_NO_ARTIFACT"


def _task_records(payload, task_id):
    """Match either production identity or one of its event identities."""
    requested = str(task_id or "").strip()
    production_id = production_id_from_identifier(requested)
    if isinstance(payload, dict):
        record_task = str(payload.get("TASK_ID", payload.get("task_id", "")) or "")
        record_production = str(payload.get("production_id", "") or "")
        record_event = str(payload.get("event_id", "") or "")
        if requested in {record_task, record_production, record_event} or production_id in {record_task, record_production}:
            yield payload
        for value in payload.values():
            if isinstance(value, (dict, list)):
                yield from _task_records(value, task_id)
    elif isinstance(payload, list):
        for value in payload:
            yield from _task_records(value, task_id)


def parse_task_record_counter(value, *, field: str) -> int:
    """Accept canonical integers and legacy 'current/limit' counters.

    Old worker C6 records store attempt='1/3', but the controller previously
    called int('1/3') while choosing a record. That raises ValueError and
    incorrectly surfaces as RUN_RECORD_NOT_FOUND despite an existing C6 PASS.
    Reject invalid input rather than silently hiding a malformed record.
    """
    if isinstance(value, bool):
        raise ValueError(f"INVALID_TASK_COUNTER:{field}")
    if isinstance(value, int):
        result = value
    elif isinstance(value, str):
        match = re.fullmatch(r"\s*(\d+)(?:\s*/\s*(\d+))?\s*", value)
        if not match:
            raise ValueError(f"INVALID_TASK_COUNTER:{field}")
        result = int(match.group(1))
        if match.group(2) is not None:
            limit = int(match.group(2))
            if limit <= 0 or result > limit:
                raise ValueError(f"INVALID_TASK_COUNTER_RANGE:{field}")
    else:
        raise ValueError(f"INVALID_TASK_COUNTER:{field}")
    if result < 0:
        raise ValueError(f"INVALID_TASK_COUNTER_RANGE:{field}")
    return result


def github_task_record(ref: str, task_id: str) -> Optional[dict]:
    """Resolve exact, variants, dispatch, reconcile, rollover, lane/number, number.

    Reads remain pinned to the caller's immutable HEAD/result SHA. Only 404 is
    a candidate miss; authorization, throttling and incomplete trees propagate.
    """
    def read(path):
        try:
            encoded = urllib.parse.quote(path, safe="/")
            data = github_api_json(f"/repos/{GITHUB_REPO}/contents/{encoded}?ref={urllib.parse.quote(ref, safe='')}")
        except urllib.error.HTTPError as exc:
            if exc.code == 404:
                return []
            raise
        try:
            payload = json.loads(base64.b64decode(data["content"]).decode("utf-8"))
        except (ValueError, KeyError, TypeError):
            return []
        return list(_task_records(payload, task_id))

    def newest(records):
        return max(records, key=lambda r: (
            parse_task_record_counter(r.get("ATTEMPT", r.get("attempt", 1)), field="attempt"),
            parse_task_record_counter(
                r.get("CHAT_ROLLOVER", r.get("chat_rollovers", r.get("chat_rollover", 0))),
                field="chat_rollover",
            ),
            str(r.get("updated_at", r.get("timestamp", ""))),
        ))

    requested_id = str(task_id or "").strip()
    production_id = production_id_from_identifier(requested_id)
    exact_candidates = [
        f"docs/automation/runs/{requested_id}.json",
        f"docs/automation/runs/{production_id}.json",
    ]
    records = []
    for exact in dict.fromkeys(exact_candidates):
        records.extend(read(exact))
        if records:
            break
    if records:
        return newest(records)
    tree = github_api_json(f"/repos/{GITHUB_REPO}/git/trees/{ref}?recursive=1")
    if tree.get("truncated"):
        raise RuntimeError("TASK_LOOKUP_TREE_TRUNCATED")
    paths = sorted(x["path"] for x in tree.get("tree", [])
                   if x.get("type") == "blob" and x["path"].startswith("docs/automation/")
                   and x["path"].endswith(".json"))
    number = production_id.rsplit("-", 1)[-1]
    lane = production_id.rsplit("-", 1)[0].split("-")[-1]
    predicates = [
        lambda p: p.startswith(f"docs/automation/runs/{requested_id}.") or p.startswith(f"docs/automation/runs/{production_id}."),
        lambda p: "dispatch" in p.lower(),
        lambda p: "reconcile" in p.lower(),
        lambda p: "rollover" in p.lower(),
        lambda p: lane.lower() in p.lower() and number in p,
        lambda p: number in p,
    ]
    visited = set(exact_candidates)
    for predicate in predicates:
        records = []
        for path in paths:
            if path not in visited and predicate(path):
                visited.add(path)
                records.extend(read(path))
        if records:
            return newest(records)
    return None


def restore_task_counters(active: dict, record: dict) -> None:
    if record.get("TASK_ID", record.get("task_id")) != active["task_id"]:
        raise ValueError("TASK_RECORD_ID_MISMATCH")
    # Never roll durable local progress backwards or count a rollover as retry.
    active["attempt"] = max(
        parse_task_record_counter(active.get("attempt", 1), field="active_attempt"),
        parse_task_record_counter(record.get("ATTEMPT", record.get("attempt", 1)), field="record_attempt"),
    )
    active["chat_rollovers"] = max(
        parse_task_record_counter(active.get("chat_rollovers", 0), field="active_rollover"),
        parse_task_record_counter(
            record.get("CHAT_ROLLOVER", record.get("chat_rollovers", record.get("chat_rollover", 0))),
            field="record_rollover",
        ),
    )


def github_localization_result_evidence(task_commit: dict, task_id: str) -> tuple[str, str]:
    """Read task record and complete changed-file list at exactly the producer SHA."""
    sha = task_commit["sha"]
    key = (sha, task_id)
    if key in _producer_result_evidence_cache:
        return _producer_result_evidence_cache[key]
    try:
        record = github_task_record(sha, task_id)
        if record is None:
            return "REJECTED", "TASK_RECORD_MISSING_AFTER_FALLBACK"
        files = []
        for page in range(1, 31):
            commit = github_api_json(f"/repos/{GITHUB_REPO}/commits/{sha}?per_page=100&page={page}")
            batch = commit.get("files", [])
            files.extend(batch)
            if len(batch) < 100:
                break
        else:
            return "REJECTED", "COMMIT_FILE_LIST_TRUNCATED"
        result = classify_localization_result(record, files, task_id)
        if len(_producer_result_evidence_cache) >= 256:
            _producer_result_evidence_cache.clear()
        _producer_result_evidence_cache[key] = result
        return result
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            return "REJECTED", "TASK_RECORD_OR_COMMIT_MISSING_AT_RESULT_SHA"
        log.warning("producer evidence HTTP failure sha=%s code=%s", sha, exc.code)
        return "RETRY", f"RESULT_EVIDENCE_HTTP_{exc.code}"
    except (ValueError, KeyError, TypeError) as exc:
        return "REJECTED", "INVALID_TASK_RECORD_OR_COMMIT_RESPONSE"
    except Exception as exc:
        # Transient read errors must be retried, never cached as an authorization verdict.
        log.warning("producer evidence read failed sha=%s error=%r", sha, exc)
        return "RETRY", "RESULT_EVIDENCE_READ_FAILED"


def _normalize_github_run(r: dict) -> dict:
    return {
        "id": r.get("id"),
        "name": r.get("name"),
        "status": r.get("status"),
        "conclusion": r.get("conclusion"),
        "html_url": r.get("html_url"),
        "event": r.get("event"),
        "head_sha": r.get("head_sha"),
        "created_at": r.get("created_at"),
        "updated_at": r.get("updated_at"),
    }


def github_action_run_by_id(run_id: int, sha: str, workflow_name: str) -> Optional[dict]:
    try:
        r = github_api_json(f"/repos/{GITHUB_REPO}/actions/runs/{int(run_id)}")
        if not isinstance(r, dict):
            return None
        if r.get("head_sha") != sha or r.get("name") != workflow_name:
            log.warning("bound actions run mismatch id=%s expected_sha=%s actual_sha=%s", run_id, sha, r.get("head_sha"))
            return None
        return _normalize_github_run(r)
    except Exception as e:
        log.warning("github exact actions lookup failed run=%s sha=%s error=%r", run_id, sha, e)
        write_runtime(last_github_error=f"actions-run:{run_id}:{sha}:{e!r}")
        return None


def github_action_jobs_summary(run_id: int) -> list[dict]:
    try:
        payload = github_api_json(f"/repos/{GITHUB_REPO}/actions/runs/{int(run_id)}/jobs?per_page=100")
        jobs = payload.get("jobs", []) if isinstance(payload, dict) else []
        return [{
            "id": j.get("id"),
            "name": j.get("name"),
            "status": j.get("status"),
            "conclusion": j.get("conclusion"),
            "started_at": j.get("started_at"),
            "completed_at": j.get("completed_at"),
        } for j in jobs]
    except Exception as e:
        log.warning("github actions jobs lookup failed run=%s error=%r", run_id, e)
        write_runtime(last_github_error=f"actions-jobs:{run_id}:{e!r}")
        return []


def github_gate_run(branch: str, sha: str, workflow_name: str, run_id: Optional[int] = None, force_discovery: bool = False) -> Optional[dict]:
    # A persisted run id is only a fast path. Result-SHA rebinding can leave the
    # previous test/repair run id behind, so a mismatch must fall through to
    # immutable exact-SHA discovery instead of being treated as "no run".
    if run_id:
        bound = github_action_run_by_id(int(run_id), sha, workflow_name)
        if bound is not None:
            return bound
        log.info(
            "bound actions run stale/mismatched id=%s sha=%s workflow=%s; falling back to exact-SHA discovery",
            run_id, sha, workflow_name,
        )
        force_discovery = True

    try:
        # Exact head_sha is the authoritative lookup. Never rely on the latest
        # N branch runs for this check: one commit can fan out into many workflows
        # and push the required material run outside a small branch result window.
        exact_q = urllib.parse.urlencode({"head_sha": sha, "per_page": 100})
        exact_payload = github_api_json(f"/repos/{GITHUB_REPO}/actions/runs?{exact_q}")
        exact_matches = [
            r for r in exact_payload.get("workflow_runs", [])
            if r.get("head_sha") == sha and r.get("name") == workflow_name
        ]
        if exact_matches:
            exact_matches.sort(
                key=lambda r: (
                    r.get("created_at", ""),
                    int(r.get("run_attempt") or 1),
                    int(r.get("id") or 0),
                ),
                reverse=True,
            )
            return _normalize_github_run(exact_matches[0])

        # Keep the broader branch scan only as a compatibility fallback for
        # API/proxy implementations that do not honor head_sha filtering.
        now_mono = time.monotonic()
        cached = _github_actions_cache.get(branch)
        if cached and not force_discovery and now_mono - cached[0] < GITHUB_ACTIONS_CACHE_SECONDS:
            payload = cached[1]
        else:
            branch_q = urllib.parse.urlencode({"branch": branch, "per_page": 100})
            payload = github_api_json(f"/repos/{GITHUB_REPO}/actions/runs?{branch_q}")
            if isinstance(payload, dict):
                _github_actions_cache[branch] = (now_mono, payload)
        matches = [
            r for r in payload.get("workflow_runs", [])
            if r.get("head_sha") == sha and r.get("name") == workflow_name
        ]
        if not matches:
            return None
        matches.sort(
            key=lambda r: (
                r.get("created_at", ""),
                int(r.get("run_attempt") or 1),
                int(r.get("id") or 0),
            ),
            reverse=True,
        )
        return _normalize_github_run(matches[0])
    except Exception as e:
        log.warning("github actions discovery failed branch=%s sha=%s error=%r", branch, sha, e)
        write_runtime(last_github_error=f"actions-discovery:{branch}:{sha}:{e!r}")
        return None

def queue_target_for_slot(slot_name: str) -> dict:
    if CONTROLLER_MODE == "conversion":
        if slot_name == "B":
            return {
                "lane": "DXVK",
                "branch": "vr-dxvk-r71-disasm",
                "workflow": "Backend Conversion Gate",
            }
        if slot_name == "C":
            return {
                "lane": "DX9EX",
                "branch": "vr-d3d9ex-focus",
                "workflow": "DX9Ex Active Validation",
            }
        return {
            "lane": "DX11",
            "branch": "vr-dx11-native-r71",
            "workflow": "Backend Conversion Gate",
        }
    if slot_name not in {"A", "B", "C"}:
        raise ValueError(f"Retired or unsupported localization lane: {slot_name}")
    role = slot_name
    return {
        "lane": f"LOCALIZATION_{role}",
        "branch": "korean-localization-clean",
        "workflow": "Localization Automation Gate",
    }


LOCALIZATION_EXECUTION_POLICY = (
    "GitHub은 연결된 플러그인으로 사용한다. 초기 도구 목록에 없다는 이유로 연결/권한 없음을 단정하지 마. "
    "ALL_TOOLS 또는 제공된 도구 검색에서 GitHub read/write 기능과 호출 스키마를 탐색한 뒤 실제 호출해. "
    "읽기 성공, 쓰기 기능 발견, 실제 쓰기 성공은 구분해 기록한다. "
    "쓰기 경로는 update_file 또는 create_blob -> create_tree -> create_commit -> update_ref(force=false)다. "
    "실제 오류는 호출 기능/대상/ref/HTTP 코드/비밀정보를 제거한 응답으로 입증한다. "
    "404는 경로/ref/transport miss, 429는 backoff, 401/403은 응답으로 인증/권한/한도 원인을 구분한다. "
    "도구 탐색 실패는 TOOL_DISCOVERY_INCOMPLETE이며 권한 거부 증거가 아니다. "
    "읽기가 가능하면 HEAD와 TASK 기록 확인부터 실행하고 실패한 기능만 복구해. "
    "RENDER_READY가 없으면 pending_artwork의 원본 취득/영역/마스크 등 미완료 단계를 실제 수행한다. "
    "자산 하나가 차단되면 근거를 보존하고 다른 실행 가능한 자산을 진행한다. "
    "보고만 하는 커밋은 제작 성과가 아니다. 실제 DDS 변경 또는 외부 candidate_artifacts 증빙이 있어야 PRODUCED다. "
    "Drive DDS는 task JSON의 candidate_artifacts에 role=korean_candidate, path(.dds), "
    "sha256(64자리), drive_file_id를 기록하고 같은 커밋에 self-QA 증빙을 포함한다. "
    "준비 단계의 실제 변경은 ADVANCED이며 DDS 제작 건수/완료로 세지 않는다. "
    "상태 안내로 끝내지 말고 실제 작업을 계속하며 RUNTIME_VALIDATION=UNTESTED를 유지한다."
)


def queue_dynamic_prefix() -> str:
    task_id = str(runtime.get("queue_task_id") or "").strip()
    if not task_id:
        return ""
    lane = str(runtime.get("queue_lane") or "")
    source_policy = (
        "GitHub 최신 HEAD를 상태·진행·QA SSOT로 사용하고 N100 로컬 저장소/clone/worktree로 우회하지 마. "
        "단, 현재 Git HEAD가 승인한 Google Drive canonical HD source transport는 원본 DDS 취득에 사용하며 GitHub-only라는 이유로 차단하지 마."
        if lane.startswith("LOCALIZATION_")
        else
        "GitHub 최신 HEAD를 최종 상태·결과 SSOT로 유지하되 N100 로컬 저장소/clone/worktree와 Google Drive는 "
        "보조 입력, 분석, 빌드, 검증, 전송 수단으로 필요할 때 사용해도 된다. 최종 결과와 완료 판정은 대상 Git 브랜치의 실제 material commit으로 남겨."
    )
    branch = str(runtime.get("queue_branch") or "")
    attempt = int(runtime.get("queue_attempt") or 1)
    failure = str(runtime.get("queue_failure_context") or "").strip()
    wave_id = str(runtime.get("queue_wave_id") or "").strip()
    qa_batch = runtime.get("queue_qa_batch") or []
    production_id = str(runtime.get("queue_production_id") or task_id).strip()
    event_id = str(runtime.get("queue_event_id") or "").strip()
    event_type = str(runtime.get("queue_event_type") or "").strip()
    lines = [
        f"[자동 큐 작업] TASK_ID={task_id}",
        f"PRODUCTION_ID={production_id}",
        *([f"EVENT_ID={event_id}"] if event_id else []),
        *([f"EVENT_TYPE={event_type}"] if event_type else []),
        f"LANE={lane}",
        f"TARGET_BRANCH={branch}",
        f"ATTEMPT={attempt}/{MAX_TASK_ATTEMPTS}",
        *([f"WAVE_ID={wave_id}"] if wave_id else []),
        source_policy,
        "이 작업에서 실제 변경 또는 검토 기록을 Git에 남기고 커밋 메시지에 정확히 [AUTO:" + task_id + "] 를 포함해.",
        "필수 GitHub Actions Gate를 소유할 result commit에는 CI-skip 지시어를 넣지 마. 검증 완료 후 bookkeeping/checkpoint 커밋은 Gate 결과와 분리해 기록하고, controller가 validation-bearing result commit을 식별할 수 있게 유지해.",
        "자동 검증과 실기 검증을 분리해 기록해. 실기 테스트를 하지 않았다면 RUNTIME_VALIDATION=UNTESTED 로 명시하고 정상 동작을 확정하지 마.",
        "작업 종료 시 마지막에 TASK_ID, RESULT_SHA, AUTOMATION_VALIDATION, RUNTIME_VALIDATION을 각각 한 줄로 출력해.",
    ]
    if lane in {"DX11", "DXVK", "DX9EX"}:
        lines += [
            "2026-10-08 사용자 최신 결정: DXVK 신규 개발·재개·배포·승격은 동결, DX11 네이티브 전환 완료를 최우선으로 한다. DX11 업무에서 DXVK로 이동하지 마.",
            "실기 HMD/게임 화면 테스트가 없다는 이유로 C0~C6 소스 개발을 중단하지 마. HMD 전용 결론/백엔드 승격만 NEED_HMD_TEST 또는 BLOCKED_RUNTIME으로 주차해.",
            "그 즉시 같은 브랜치의 다음 독립 실행 가능한 구현 항목을 선택해 실제 소스/검증 도구를 수정하고, 관련 정적 검증 1회 + exact-SHA CI를 수행해. 동일 소스의 HUD 1000/5000회 반복, 기존 PASS 재검사, 문서/해시/상태 커밋만으로 C2를 완료하지 마.",
            "다른 작업자와 같은 work_key/파일/Task를 중복 수정하지 말고 원격 claim/HEAD를 확인해. 이미 진행 중인 CI는 새 상태 커밋으로 취소하지 마.",
            "배포/실기 PASS는 실제 Quest3/VDXR 검증 이후에만 선언해. 완료한 C0~C6+정확한 GitHub Gate가 확인되면 기존 TASK_ID를 재실행하지 말고 다음 독립 항목을 진행해.",
        ]
    if lane.startswith("LOCALIZATION_"):
        lines.append(LOCALIZATION_EXECUTION_POLICY)
    if lane in {"LOCALIZATION_A", "LOCALIZATION_B"}:
        lines += [
            "A/B producer는 개별 GitHub Actions Gate를 기다리지 않는다. A/B material commit 후 C QA와 C Gate를 완료해야 다음 생산 wave를 시작한다. A는 짝수 index, B는 홀수 index를 소유한다. E lane/shard는 사용하지 않는다.",
            "이 producer task record의 AUTOMATION_VALIDATION은 PENDING으로 남기고 validation_mode=C_BATCH_GATE로 기록해. 최종 자동 검증 권한은 후속 C batch Gate에 있다.",
            "생산 우선순위는 candidate-completion-first다. C가 받아들인 RENDER_READY 또는 ONE_STAGE_TO_RENDER 자산이 shard에 있으면 새 unrelated preflight/work-order를 시작하지 말고 그 자산을 실제 Korean DDS candidate까지 완료해.",
            "baseline/slant/style 측정만 남았다면 같은 invocation에서 측정하고 render -> measure/refit -> DDS encode -> decoded-final self-QA까지 이어가. ready 자산이 있는 동안 preflight-only 결과로 종료하지 마.",
            "ready 자산이 모두 fail-closed일 때만 정확한 blocker를 기록하고 다음 ready 자산을 시도해. ready 자산이 전혀 없을 때만 새 preflight-only batch를 최대 1개 확장해.",
        ]
    if qa_batch:
        lines += [
            "이 C 작업은 독립 QA 소비자다. 아래 생산 결과들을 하나의 배치로 중복 없이 검수하고 공용 상태를 한 번만 병합해.",
            "QA_BATCH_INPUTS=" + json.dumps(qa_batch, ensure_ascii=False, separators=(",", ":")),
            "각 입력의 TASK_ID + RESULT_SHA를 고정 기준으로 사용하고, 동일 candidate/source/contract fingerprint의 무거운 검증은 한 번만 수행해.",
            "각 input에 대해 qa_dispositions를 기록해: PASS, REWORK_REQUIRED, HOLD_STRICT_RECHECK, SUPERSEDED 중 하나. C commit 하나의 Localization Automation Gate가 이 batch 전체의 자동 검증이다.",
            "C가 pre-generation evidence를 PASS할 때 가능한 경우 production_readiness를 RENDER_READY, ONE_STAGE_TO_RENDER, PREFLIGHT_ONLY 중 하나로 분류하고 shared next_actions는 candidate 완성을 unrelated preflight보다 앞에 둬.",
        ]
    if failure:
        lines += [
            "",
            "이전 실행의 미완료 사유를 확인하고 해당 단계부터 실제 작업을 재개해. Actions 실패가 명시된 경우에만 해당 run을 확인해.",
            "FAILURE_CONTEXT=" + failure,
        ]
    return "\n".join(lines) + "\n\n"

async def first_visible(page: Page, selectors: list[str], total_wait_ms: int = 10000):
    """Wait for React composer hydration instead of sampling the DOM once."""
    deadline = time.time() + (total_wait_ms / 1000)
    while time.time() < deadline:
        for frame in page.frames:
            for sel in selectors:
                try:
                    loc = frame.locator(sel).first
                    if await loc.count() and await loc.is_visible(timeout=250):
                        return loc
                except Exception:
                    continue
        await page.wait_for_timeout(250)
    return None


async def composer_diagnostics(page: Page) -> list[dict]:
    """Return safe structural metadata only; never capture user/chat text."""
    rows = []
    for frame in page.frames:
        try:
            found = await frame.locator("textarea, input, [contenteditable], [role='textbox']").evaluate_all("""els => els.slice(0,40).map(el => ({
                tag: el.tagName,
                id: el.id || '',
                role: el.getAttribute('role') || '',
                placeholder: el.getAttribute('placeholder') || '',
                contenteditable: el.getAttribute('contenteditable') || '',
                testid: el.getAttribute('data-testid') || '',
                aria: el.getAttribute('aria-label') || '',
                cls: (typeof el.className === 'string' ? el.className : '').slice(0,160),
                visible: !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length)
            }))""")
            for row in found:
                row["frame_url"] = frame.url[:180]
                rows.append(row)
        except Exception:
            continue
    return rows[:60]


async def page_text(page: Page) -> str:
    try:
        return (await page.locator("body").inner_text(timeout=3000)).lower()
    except Exception:
        return ""


ERROR_SURFACE_SELECTORS = [
    "[role='alert']",
    "[role='status']",
    "[data-sonner-toast]",
    "[data-testid*='toast']",
    "[data-testid*='error']",
    "[class*='toast']",
    "[class*='error']",
    "dialog",
    "[role='dialog']",
    "form",
]


async def visible_error_surface_text(page: Page) -> str:
    """Collect only visible transient/error UI, excluding sidebar/chat-history text."""
    chunks = []
    for sel in ERROR_SURFACE_SELECTORS:
        try:
            loc = page.locator(sel)
            count = await loc.count()
            for i in range(min(count, 20)):
                item = loc.nth(i)
                try:
                    if not await item.is_visible(timeout=120):
                        continue
                    text = (await item.inner_text(timeout=500)).strip()
                    if text:
                        chunks.append(text)
                except Exception:
                    continue
        except Exception:
            continue
    return "\n".join(chunks).lower()


async def retry_surface_text(page: Page) -> str:
    """Read only the local UI around a visible Retry button; avoid chat-history false positives."""
    loc = await first_visible(page, RETRY_SELECTORS, total_wait_ms=500)
    if loc is None:
        return ""
    try:
        text = await loc.evaluate("""el => {
            let node = el;
            let best = '';
            for (let i = 0; i < 6 && node; i++, node = node.parentElement) {
                const t = (node.innerText || '').trim();
                if (t.length > best.length && t.length <= 2000) best = t;
            }
            return best;
        }""")
        return (text or "").lower()
    except Exception:
        return ""


async def retry_looks_rate_limited(page: Page) -> bool:
    text = await retry_surface_text(page)
    matched = [p for p in RATE_LIMIT_PATTERNS if re.search(p, text, flags=re.I | re.S)]
    if matched:
        write_runtime(
            last_rate_limit_match=matched[0],
            last_rate_limit_surface=text[:500],
        )
        return True
    return False


async def detect_rate_limit(page: Page) -> bool:
    text = await visible_error_surface_text(page)
    matched = [p for p in RATE_LIMIT_PATTERNS if re.search(p, text, flags=re.I | re.S)]
    if matched:
        write_runtime(
            last_rate_limit_match=matched[0],
            last_rate_limit_surface=text[:500],
        )
        return True
    return False


async def detect_conversation_limit(page: Page) -> bool:
    """Detect a per-thread length limit, distinct from account/rate limits."""
    surface = await visible_error_surface_text(page)
    matched = [p for p in CONVERSATION_LIMIT_PATTERNS if re.search(p, surface, flags=re.I | re.S)]
    if not matched:
        # Some conversation-length notices replace the composer without using a
        # toast/dialog. Only inspect the full page when the composer is absent.
        composer = await first_visible(page, INPUT_SELECTORS, total_wait_ms=500)
        if composer is None:
            body = await page_text(page)
            matched = [p for p in CONVERSATION_LIMIT_PATTERNS if re.search(p, body, flags=re.I | re.S)]
            if matched:
                surface = body
    if matched:
        write_runtime(
            last_conversation_limit_match=matched[0],
            last_conversation_limit_surface=surface[:500],
        )
        return True
    return False


async def detect_limit(page: Page) -> bool:
    text = await visible_error_surface_text(page)
    # A per-conversation length limit is recoverable by rolling into a new chat;
    # never misclassify it as an account usage limit.
    if any(re.search(p, text, flags=re.I | re.S) for p in CONVERSATION_LIMIT_PATTERNS):
        return False
    matched = [p for p in LIMIT_PATTERNS if re.search(p, text, flags=re.I | re.S)]
    if matched:
        write_runtime(
            last_usage_limit_match=matched[0],
            last_usage_limit_surface=text[:500],
        )
        return True
    return False


def _parse_iso(value: Optional[str]) -> Optional[datetime]:
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(value)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=TZ)
        return dt.astimezone(TZ)
    except Exception:
        return None


def rate_limit_active(reg: Registry, now: datetime) -> bool:
    until = _parse_iso(reg.rate_limit_until)
    return bool(until and now < until)


def rate_limit_seconds_remaining(reg: Registry, now: datetime) -> int:
    until = _parse_iso(reg.rate_limit_until)
    if not until:
        return 0
    return max(0, int((until - now).total_seconds()))


def mark_rate_limit(reg: Registry, now: datetime, source: str):
    reg.rate_limit_attempts = max(0, reg.rate_limit_attempts) + 1
    idx = min(reg.rate_limit_attempts - 1, len(RATE_LIMIT_BACKOFF_SECONDS) - 1)
    delay_sec = RATE_LIMIT_BACKOFF_SECONDS[idx]
    reg.rate_limit_until = (now + timedelta(seconds=delay_sec)).isoformat()
    save_registry(reg)
    write_runtime(
        status="rate_limited_backoff",
        last_action=f"Too many requests detected ({source}); backing off {delay_sec}s",
        rate_limit_attempts=reg.rate_limit_attempts,
        rate_limit_until=reg.rate_limit_until,
    )
    log.warning(
        "rate limit detected source=%s attempt=%s backoff=%ss until=%s",
        source, reg.rate_limit_attempts, delay_sec, reg.rate_limit_until,
    )



def note_successful_request(reg: Registry, now: datetime, slot_name: Optional[str] = None):
    """Record a request without treating successful traffic as a rate-limit signal."""
    reg.last_global_send_at = now.isoformat()
    if slot_name:
        reg.last_global_send_slot = slot_name
    save_registry(reg)
    write_runtime(last_global_send_at=reg.last_global_send_at, last_global_send_slot=reg.last_global_send_slot)

def clear_rate_limit_after_response(reg: Registry):
    """Clear adaptive backoff only after a genuine assistant response or durable result is observed."""
    if reg.rate_limit_attempts or reg.rate_limit_until:
        reg.rate_limit_attempts = 0
        reg.rate_limit_until = None
        save_registry(reg)
        write_runtime(
            rate_limit_attempts=0,
            rate_limit_until=None,
            last_action="Assistant response observed; adaptive rate-limit backoff cleared",
        )



def send_guard_reason(reg: Registry, slot: Optional[Slot], now: datetime) -> Optional[str]:
    if rate_limit_active(reg, now):
        return f"rate_limit_backoff:{rate_limit_seconds_remaining(reg, now)}s"

    last_global = _parse_iso(reg.last_global_send_at)
    if last_global and MIN_SEND_GAP_SECONDS > 0:
        global_gap = MIN_SEND_GAP_SECONDS
        if slot and CONTROLLER_MODE == "localization" and LOCALIZATION_PARALLEL:
            if reg.last_global_send_slot and reg.last_global_send_slot != slot.name:
                global_gap = min(global_gap, PARALLEL_DISTINCT_SLOT_SEND_GAP_SECONDS)
            else:
                global_gap = min(global_gap, LOCALIZATION_SAME_SLOT_SEND_GAP_SECONDS)
        age = (now - last_global).total_seconds()
        if age < global_gap:
            return f"global_send_gap:{int(global_gap - age)}s"

    if slot and slot.last_sent_at:
        slot_gap = SLOT_DEDUP_SECONDS
        if CONTROLLER_MODE == "localization" and LOCALIZATION_PARALLEL:
            slot_gap = min(slot_gap, LOCALIZATION_SLOT_DEDUP_SECONDS)
        if slot_gap > 0:
            last_slot = _parse_iso(slot.last_sent_at)
            if last_slot:
                age = (now - last_slot).total_seconds()
                if age < slot_gap:
                    return f"slot_dedup:{int(slot_gap - age)}s"
    return None

async def detect_busy(page: Page) -> bool:
    for sel in BUSY_SELECTORS:
        try:
            loc = page.locator(sel).first
            if await loc.count() and await loc.is_visible(timeout=300):
                return True
        except Exception:
            continue
    return False


async def ensure_logged_in(page: Page) -> bool:
    # Never navigate here: each A~F tab must keep its own chat URL.
    # Only initialize a truly blank tab.
    if not page.url or page.url == "about:blank":
        await page.goto(BASE_URL, wait_until="domcontentloaded", timeout=60000)

    # Require the actual composer (or current model picker), not merely sidebar/nav UI.
    deadline = time.time() + 30
    while time.time() < deadline:
        box = await first_visible(page, INPUT_SELECTORS)
        if box:
            return True

        model_selectors = [
            "button[aria-label='ChatGPT 모델 선택']",
            "button[aria-label='Select ChatGPT model']",
            "button[aria-label*='모델 선택']",
        ]
        for sel in model_selectors:
            try:
                loc = page.locator(sel).first
                if await loc.count() and await loc.is_visible(timeout=200):
                    return True
            except Exception:
                continue

        txt = await page_text(page)
        if any(x in txt for x in ("log in", "sign up", "로그인", "가입")):
            # Give redirects/client hydration a few seconds before declaring logged out.
            if time.time() + 3 < deadline:
                await page.wait_for_timeout(1000)
                continue
            return False

        await page.wait_for_timeout(500)

    write_runtime(
        status="login_detection_failed",
        last_action=f"ChatGPT composer/model picker could not be verified at {page.url}",
        current_url=page.url,
    )
    return False



