# Existing Portainer Stack: GitHub API dispatch/poll only, NO image processing.
FROM python:3.12-alpine
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/outrun
COPY github_actions_light_controller.py /opt/outrun/github_actions_light_controller.py
RUN python -m py_compile /opt/outrun/github_actions_light_controller.py
ENTRYPOINT ["python","-u","/opt/outrun/github_actions_light_controller.py"]
