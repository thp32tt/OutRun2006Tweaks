      "fast_path_requires_evidence_backed_family": true,
      "fast_path_quality_threshold_same_as_quality_path": true,
      "semantic_translation_reuse": true,
      "style_family_reuse": true,
      "asset_specific_geometry_required": true,
      "deterministic_render_preferred": true,
      "background_reconstruction_order": [
