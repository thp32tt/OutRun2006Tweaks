    "producer_task_record_validation": "PENDING",
    "producer_validation_mode": "C_BATCH_GATE",
    "batch_gate_role": "C",
    "max_producer_inputs_per_gate": 4,
    "exact_input_identity": "TASK_ID@RESULT_SHA",
    "strict_checks_for_pass_disposition": [
      "domain_isolation",
      "changed_localization_payload",
      "lane_isolation"
    ],
    "nonpass_dispositions": [
      "REWORK_REQUIRED",
      "HOLD_STRICT_RECHECK",
      "SUPERSEDED"
    ],
    "runtime_validation_separate": true
  },
  "production_strategy": {
    "mode": "candidate_completion_first",
    "readiness_tiers": [
      "RENDER_READY",
      "ONE_STAGE_TO_RENDER",
      "PREFLIGHT_ONLY"
    ],
    "selection_order": [
