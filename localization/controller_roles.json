    "zero_candidate_exception": "ONLY_WHEN_NO_RUNNABLE_DIRECT_REWORK_RENDER_READY_ONE_STAGE_OR_EXISTING_CANDIDATE_REWORK_AFTER_FRESH_SCAN",
    "acceleration": {
