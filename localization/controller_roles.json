        "FLAT_COLOR",
        "ANALYTIC_GRADIENT",
        "REPEATABLE_TEXTURE_OR_PATCH",
        "CONSTRAINED_INPAINTING"
      ],
      "generative_reconstruction_fallback_only": true,
      "render_measure_refit_same_invocation": true,
      "batch_compatible_family_members": true,
      "exception_does_not_block_independent_assets": true,
      "template_is_not_approval_evidence": true,
      "c_independent_final_candidate_validation": true,
      "throughput_counts_candidate_dds_only": true
