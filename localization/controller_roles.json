{
  "schema_version": 50,
  "branch": "korean-localization-clean",
  "contract": "docs/automation/LOCALIZATION_CONTROLLER_V2.md",
  "execution": {
    "mode": "two_producers_then_c_barrier",
    "wave_order": ["A_B_PRODUCTION", "C_QA", "NEXT_WAVE"],
    "producer_lanes": ["A", "B"],
    "qa_lane": "C",
    "max_parallel_production": 2,
    "c_gates_next_wave": true,
    "producer_result_required": "MATERIAL_COMMIT",
    "runtime_validation_default": "UNTESTED"
  },
  "lanes": {
    "A": {"role":"producer","shard":"asset_queue_v2.index % 2 == 0"},
    "B": {"role":"producer","shard":"asset_queue_v2.index % 2 == 1"},
    "C": {"role":"independent_qa","consumes":"current_wave immutable TASK_ID@RESULT_SHA","writes_shared_state":true}
  },
  "queue_source": "localization/graphics/asset_queue_v2.csv",
  "legacy_queue": "localization/graphics/asset_queue.csv",
  "state_machine": {
    "states":["READY","CLAIMED_A","CLAIMED_B","QA_PENDING","REWORK_REQUIRED","PRODUCTION_COMPLETE","HOLD","PRESERVE"],
    "producer_terminal_requires":["real material change","durable commit containing [AUTO:TASK_ID]"],
    "assistant_text_never_completes_task":true,
    "next_wave_requires_c_terminal":true,
    "rework_returns_to_owner":true
  },
  "isolation": {
    "domain":"LOCALIZATION_ONLY",
    "forbidden_domains":["VR","FFB","DX9Ex","DX11","DXVK","OpenXR"],
    "share_runtime_state_with_vr":false,
    "share_queue_with_vr":false,
    "share_task_ids_with_vr":false,
    "share_browser_slots_with_vr":false
  },
  "recovery": {
    "refresh_github_head_before_dispatch":true,
    "refresh_github_head_before_commit":true,
    "same_task_retry_when_no_material_commit":true,
    "restart_resumes_from_durable_git_state":true,
    "github_transient_errors_retry":true,
    "max_same_chat_retries":2,
    "then_new_chat_same_task":true
  }
}
