    "candidate_target_per_invocation_when_ready_exists": 1,
    "continue_to_next_ready_asset_after_fail_closed": true,
    "primary_throughput_metric": "NEW_OR_MATERIALLY_REWORKED_V2_KOREAN_DDS_CANDIDATES_TO_C_QA",
    "qa_strictness_unchanged": true,
    "hard_candidate_success_condition": true,
