{
  "schema_version": 4,
  "branch": "korean-localization-clean",
  "contract": "docs/KOREAN_LOCALIZATION_AUTOMATION_CONTRACT.md",
  "command_map": {
    "A": "OutRun 한글화 A 실행",
    "B": "OutRun 한글화 B 실행",
    "C": "OutRun 한글화 C 실행"
  },
  "execution": {
    "mode": "parallel_production_with_qa_barrier",
    "max_parallel_production": 2,
    "concurrent_group": [
      "A",
      "B"
    ],
    "barrier_role": "C",
    "next_wave_after": "C_DURABLE_RESULT",
    "compatibility_fallback": "sequential_queue"
  },
  "lanes": {
    "A": {
      "mode": "production+self_qa",
      "primary_index_parity": "odd",
      "parallel_group": "production"
    },
    "B": {
      "mode": "production+self_qa",
      "primary_index_parity": "even",
      "parallel_group": "production"
    },
    "C": {
      "mode": "cross_lane_final_qa+approval",
      "primary_index_parity": "all",
      "starts_after": [
        "A_DURABLE_RESULT",
        "B_DURABLE_RESULT"
      ]
    }
  },
  "queue_source": "localization/graphics/asset_queue.csv",
  "priorities": [
    "REWORK_REQUIRED",
    "unfinished_localize_text",
    "zoom_review_localizable_text",
    "other_pending"
  ],
  "zero_pixel_overflow": true,
  "missing_evidence_status": "HOLD_STRICT_RECHECK",
  "controller_prompt_policy": "Keep prompts minimal; workflow rules live in Git. Do not duplicate contract logic in Docker.",
  "concurrency_safety": {
    "refresh_head_before_claim": true,
    "refresh_head_before_commit": true,
    "disjoint_primary_shards": true,
    "stale_state_overwrite_forbidden": true,
    "shared_state_reconcile_from_latest_head": true,
    "c_reads_only_durable_ab_results": true
  },
  "work_steal": {
    "enabled": true,
    "disabled_while_peer_lane_active": true,
    "condition": "peer production lane is confirmed idle/completed, latest Git refresh confirms target is unclaimed, and target has no newer current-cycle production/state change",
    "report_field": "work_stolen_from_lane"
  },
  "runtime_recovery": {
    "wait_actions": {
      "authoritative_lookup": "github_actions_run_by_id",
      "bypass_generic_actions_cache": true,
      "generic_actions_cache_scope": "discovery_only_before_run_id_binding",
      "bound_run_nonterminal_cache_ttl_seconds": 0,
      "force_uncached_refresh_after_poll_intervals": 2,
      "refresh_jobs_with_forced_run_refresh": true,
      "rediscover_missing_bound_run_by": [
        "result_sha",
        "workflow_name"
      ],
      "retry_terminal_failure_conclusions": [
        "failure",
        "cancelled",
        "timed_out",
        "action_required",
        "stale"
      ],
      "retry_same_task_id": true,
      "retry_increments_attempt": true,
      "ci_failure_consumes_chat_rollover": false,
      "force_uncached_refresh_after_seconds": 60
    },
    "conversation_rollover": {
      "enabled": true,
      "applies_to": [
        "stale_chat",
        "expired_chat",
        "missing_chat",
        "missing_assistant_generation"
      ],
      "applies_to_ci_failure": false
    },
    "watchdog": {
      "wait_actions_recovery": "uncached_exact_run_and_jobs_refresh",
      "observe_only_allowed_for_wait_actions": false,
      "queue_idle_rearm_seconds": 90,
      "queue_idle_requires_unfinished_work": true,
      "wait_actions_stale_seconds": 75,
      "busy_stall_seconds": 1800,
      "force_stop_active_generation": false
    },
    "wave_progression": {
      "ab_pass_to_c_immediately": true,
      "c_pass_to_next_ab_immediately": true,
      "wait_for_chat_expiry_after_terminal_result": false,
      "terminal_transition_target_seconds": 30
    },
    "startup_reconcile": {
      "enabled": true,
      "refresh_branch_head_first": true,
      "clear_discovery_cache_first": true,
      "reconcile_all_nonterminal_lanes": true,
      "exact_run_lookup_for_wait_actions": true,
      "refresh_jobs_for_stale_wait_actions": true,
      "refresh_branch_head_before_retry": true,
      "terminal_failure_with_attempts": "retry_same_task_id",
      "terminal_failure_without_attempts": "BLOCKED",
      "never_wait_for_chat_expiry_after_terminal_action": true
    }
  },
  "runtime_tuning": {
    "queue_check_seconds": 15,
    "queue_stable_seconds": 30,
    "github_discovery_poll_seconds": 60,
    "github_bound_run_poll_seconds": 30,
    "github_task_commit_cache_seconds": 60,
    "github_actions_discovery_cache_seconds": 60,
    "bound_run_nonterminal_cache_ttl_seconds": 0,
    "queue_next_task_delay_seconds": 15,
    "parallel_lane_stagger_seconds": 15,
    "min_send_gap_seconds": 60,
    "parallel_distinct_slot_send_gap_seconds": 15,
    "slot_dedup_seconds": 120,
    "retry_button_cooldown_seconds": 45,
    "rate_limit_backoff_seconds": [
      90,
      180,
      300,
      600
    ]
  },
  "runtime_observability": {
    "queue_loop_heartbeat_seconds": 15,
    "heartbeat_stale_after_seconds": 45,
    "required_runtime_fields": [
      "queue_loop_heartbeat_at",
      "last_scheduler_decision_at",
      "last_scheduler_decision",
      "blocked_reason"
    ],
    "active_state_source_of_truth": "active_by_lane",
    "queue_active_semantics": "derived_summary",
    "queue_active_null_allowed_only_when_active_by_lane_empty": true,
    "active_lane_phases": [
      "DISPATCHING",
      "WAIT_RESPONSE",
      "WAIT_COMMIT",
      "WAIT_ACTIONS",
      "RETRY_PENDING"
    ]
  }
}
